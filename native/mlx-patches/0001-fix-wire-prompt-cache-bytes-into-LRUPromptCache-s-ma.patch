From 5927f815b6b4ab7822e01d79a9a8fcad74bbefba Mon Sep 17 00:00:00 2001
From: Aleksei Bukhalov <buhaloff.aleks@gmail.com>
Date: Wed, 2 Sep 2026 00:00:06 +0200
Subject: [PATCH] fix: wire --prompt-cache-bytes into LRUPromptCache's
 max_bytes

run() constructed LRUPromptCache with only max_size (count), so
--prompt-cache-bytes was parsed into cli_args but never enforced: the byte
quota was silently unlimited (max_bytes defaulted to 1<<63) regardless of
the flag. Observed on the M4 host: 10 sequences reached 12.7 GB with
--prompt-cache-bytes 4294967296 set, well past the intended 4 GiB budget.
---
 mlx_lm/server.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/mlx_lm/server.py b/mlx_lm/server.py
index b6f563a..f0f8c61 100644
--- a/mlx_lm/server.py
+++ b/mlx_lm/server.py
@@ -1709,7 +1709,12 @@ def run(
     handler_class=APIHandler,
 ):
     group = mx.distributed.init()
-    prompt_cache = LRUPromptCache(model_provider.cli_args.prompt_cache_size)
+    cache_kwargs = {}
+    if model_provider.cli_args.prompt_cache_bytes is not None:
+        cache_kwargs["max_bytes"] = model_provider.cli_args.prompt_cache_bytes
+    prompt_cache = LRUPromptCache(
+        model_provider.cli_args.prompt_cache_size, **cache_kwargs
+    )
     response_generator = ResponseGenerator(model_provider, prompt_cache)
     if group.rank() == 0:
         _run_http_server(host, port, response_generator)
-- 
