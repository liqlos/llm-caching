+++ b/mlx_lm/prompt_cache_disk.py
@@ -0,0 +1,163 @@
+# Copyright © 2023-2024 Apple Inc.
+
+"""Persistent disk tier for the server's prompt cache.
+
+Stores evicted / shutdown-time KV caches as ``.safetensors`` files next to a
+JSON index. Every entry carries a compatibility key (model identity, mlx /
+mlx-lm versions, system fingerprint); a mismatch on any field makes the
+entry unusable and it is skipped rather than loaded, so a version or model
+change never risks feeding a stale KV cache into generation.
+"""
+
+import hashlib
+import json
+import threading
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+from .models.cache import LRUPromptCache, load_prompt_cache, save_prompt_cache
+
+
+class DiskPromptStore:
+    def __init__(
+        self,
+        directory: str,
+        max_bytes: int,
+        mlx_version: str,
+        mlx_lm_version: str,
+        system_fingerprint: str,
+    ):
+        self.dir = Path(directory)
+        self.dir.mkdir(parents=True, exist_ok=True)
+        self.max_bytes = max_bytes
+        self.mlx_version = mlx_version
+        self.mlx_lm_version = mlx_lm_version
+        self.system_fingerprint = system_fingerprint
+        self._index_path = self.dir / "index.json"
+        self._lock = threading.Lock()
+        self._index: List[Dict[str, Any]] = self._read_index()
+
+    def _read_index(self) -> List[Dict[str, Any]]:
+        if self._index_path.exists():
+            try:
+                return json.loads(self._index_path.read_text())
+            except (json.JSONDecodeError, OSError):
+                return []
+        return []
+
+    def _write_index_locked(self):
+        tmp = self._index_path.with_suffix(".tmp")
+        tmp.write_text(json.dumps(self._index))
+        tmp.replace(self._index_path)
+
+    def _is_compatible(self, row: Dict[str, Any]) -> bool:
+        return (
+            row.get("mlx_version") == self.mlx_version
+            and row.get("mlx_lm_version") == self.mlx_lm_version
+            and row.get("system_fingerprint") == self.system_fingerprint
+        )
+
+    @staticmethod
+    def _entry_id(model_key, tokens, cache_type: str) -> str:
+        h = hashlib.sha256()
+        h.update(repr(list(model_key)).encode())
+        h.update(b"\0")
+        h.update(",".join(map(str, tokens)).encode())
+        h.update(b"\0")
+        h.update(cache_type.encode())
+        return h.hexdigest()
+
+    def put(self, model_key, tokens: List[int], entry: "LRUPromptCache.CacheEntry"):
+        """Write one cache entry to disk. Safe to call from a background
+        thread; the caller owns offloading it off the request path."""
+        entry_id = self._entry_id(model_key, tokens, entry.cache_type)
+        path = self.dir / f"{entry_id}.safetensors"
+        try:
+            save_prompt_cache(str(path), entry.prompt_cache)
+            checksum = hashlib.sha256(path.read_bytes()).hexdigest()
+        except Exception:
+            return
+        row = {
+            "id": entry_id,
+            "model_key": list(model_key),
+            "tokens": list(tokens),
+            "cache_type": entry.cache_type,
+            "n_bytes": entry.nbytes,
+            "mlx_version": self.mlx_version,
+            "mlx_lm_version": self.mlx_lm_version,
+            "system_fingerprint": self.system_fingerprint,
+            "checksum": checksum,
+            "last_used": time.time(),
+        }
+        with self._lock:
+            self._index = [r for r in self._index if r["id"] != entry_id]
+            self._index.append(row)
+            self._evict_locked()
+            self._write_index_locked()
+
+    def _evict_locked(self):
+        total = sum(r["n_bytes"] for r in self._index)
+        n_evicted = 0
+        for row in self._index:
+            if total <= self.max_bytes:
+                break
+            (self.dir / f"{row['id']}.safetensors").unlink(missing_ok=True)
+            total -= row["n_bytes"]
+            n_evicted += 1
+        if n_evicted:
+            self._index = self._index[n_evicted:]
+
+    def search(
+        self, model_key, tokens: List[int]
+    ) -> Tuple[Optional[dict], Optional[dict], Optional[dict]]:
+        """Mirrors ``PromptTrie.search``'s exact / shorter / longer
+        semantics, restricted to disk-resident, compatibility-verified
+        entries for this model."""
+        model_key = list(model_key)
+        with self._lock:
+            candidates = [
+                r
+                for r in self._index
+                if r["model_key"] == model_key and self._is_compatible(r)
+            ]
+        exact = shorter = longer = None
+        for row in candidates:
+            row_tokens = row["tokens"]
+            if row_tokens == tokens:
+                exact = row
+            elif len(row_tokens) < len(tokens) and tokens[: len(row_tokens)] == row_tokens:
+                if shorter is None or len(row_tokens) > len(shorter["tokens"]):
+                    shorter = row
+            elif len(row_tokens) > len(tokens) and row_tokens[: len(tokens)] == tokens:
+                if longer is None or len(row_tokens) < len(longer["tokens"]):
+                    longer = row
+        return exact, shorter, longer
+
+    def load(self, row: Dict[str, Any]):
+        path = self.dir / f"{row['id']}.safetensors"
+        if not path.exists():
+            return None
+        try:
+            if hashlib.sha256(path.read_bytes()).hexdigest() != row["checksum"]:
+                return None
+            return load_prompt_cache(str(path))
+        except Exception:
+            return None
+
+    def touch(self, row: Dict[str, Any]):
+        with self._lock:
+            for r in self._index:
+                if r["id"] == row["id"]:
+                    r["last_used"] = time.time()
+                    break
+            self._write_index_locked()
+
+    def all_compatible(self, model_key) -> List[Dict[str, Any]]:
+        model_key = list(model_key)
+        with self._lock:
+            return [
+                r
+                for r in self._index
+                if r["model_key"] == model_key and self._is_compatible(r)
+            ]
