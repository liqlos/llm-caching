diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
new file mode 100644
index 0000000..ecbb7ae
--- /dev/null
+++ b/tests/test_prompt_cache_disk.py
@@ -0,0 +1,134 @@
+# Copyright © 2024 Apple Inc.
+
+import tempfile
+import unittest
+
+import mlx.core as mx
+
+from mlx_lm.models.cache import KVCache, LRUPromptCache
+from mlx_lm.prompt_cache_disk import DiskPromptStore
+
+
+def make_cache(n_tokens):
+    c = KVCache()
+    c.update_and_fetch(mx.zeros((1, 2, n_tokens, 4)), mx.zeros((1, 2, n_tokens, 4)))
+    mx.eval(c.state)
+    return [c]
+
+
+class TestDiskPromptStore(unittest.TestCase):
+    def setUp(self):
+        self.test_dir_fid = tempfile.TemporaryDirectory()
+        self.test_dir = self.test_dir_fid.name
+
+    def tearDown(self):
+        self.test_dir_fid.cleanup()
+
+    def make_store(self, **kwargs):
+        defaults = dict(
+            max_bytes=10**9,
+            mlx_version="1",
+            mlx_lm_version="2",
+            system_fingerprint="fp",
+        )
+        defaults.update(kwargs)
+        return DiskPromptStore(self.test_dir, **defaults)
+
+    def test_put_load_and_search_semantics(self):
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        tokens = [1, 2, 3, 4, 5]
+        cache = make_cache(5)
+        entry = LRUPromptCache.CacheEntry(
+            cache, sum(c.nbytes for c in cache), "assistant"
+        )
+        store.put(model_key, tokens, entry)
+
+        exact, shorter, longer = store.search(model_key, tokens)
+        self.assertIsNotNone(exact)
+        self.assertEqual(exact["tokens"], tokens)
+        self.assertIsNone(shorter)
+        self.assertIsNone(longer)
+
+        loaded = store.load(exact)
+        self.assertIsNotNone(loaded)
+        self.assertEqual(loaded[0].offset, 5)
+
+        # A shorter query finds the stored entry as "longer".
+        _, shorter2, longer2 = store.search(model_key, tokens[:3])
+        self.assertIsNone(shorter2)
+        self.assertEqual(longer2["tokens"], tokens)
+
+        # A longer query finds the stored entry as "shorter".
+        _, shorter3, longer3 = store.search(model_key, tokens + [6, 7])
+        self.assertIsNone(longer3)
+        self.assertEqual(shorter3["tokens"], tokens)
+
+    def test_incompatible_entry_is_skipped_fail_closed(self):
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        tokens = [1, 2, 3]
+        store.put(
+            model_key,
+            tokens,
+            LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant"),
+        )
+
+        # A different mlx-lm version (e.g. after an upgrade) must not match.
+        store2 = self.make_store(mlx_lm_version="3")
+        exact, shorter, longer = store2.search(model_key, tokens)
+        self.assertIsNone(exact)
+        self.assertIsNone(shorter)
+        self.assertIsNone(longer)
+        self.assertEqual(store2.all_compatible(model_key), [])
+
+    def test_eviction_respects_byte_budget(self):
+        store = self.make_store(max_bytes=150)
+        model_key = ("model-a", None, None)
+        store.put(
+            model_key, [1, 2], LRUPromptCache.CacheEntry(make_cache(2), 100, "assistant")
+        )
+        store.put(
+            model_key,
+            [1, 2, 3],
+            LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant"),
+        )
+        rows = store.all_compatible(model_key)
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(rows[0]["tokens"], [1, 2, 3])
+
+    def test_lru_flush_and_reload_round_trip(self):
+        lru = LRUPromptCache(max_size=10)
+        lru.insert_cache(("model-a", None, None), [1, 2, 3], make_cache(3), cache_type="user")
+        # A different, unrelated model_key so the two entries don't collapse
+        # via insert_cache's trimmable-prefix cleanup.
+        lru.insert_cache(
+            ("model-b", None, None),
+            [9, 9, 9, 9, 9],
+            make_cache(5),
+            cache_type="assistant",
+        )
+        self.assertEqual(len(lru), 2)
+
+        store = self.make_store()
+        for model, tokens, entry in lru.all_entries():
+            store.put(model, tokens, entry)
+
+        rows_a = store.all_compatible(("model-a", None, None))
+        rows_b = store.all_compatible(("model-b", None, None))
+        self.assertEqual(len(rows_a), 1)
+        self.assertEqual(len(rows_b), 1)
+
+        lru2 = LRUPromptCache(max_size=10)
+        for row in rows_a + rows_b:
+            cache = store.load(row)
+            lru2.insert_cache(
+                tuple(row["model_key"]), row["tokens"], cache, cache_type=row["cache_type"]
+            )
+        self.assertEqual(len(lru2), 2)
+        _, rest = lru2.fetch_nearest_cache(("model-b", None, None), [9, 9, 9, 9, 9])
+        self.assertEqual(rest, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
