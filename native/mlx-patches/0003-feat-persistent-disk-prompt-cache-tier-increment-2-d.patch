diff --git a/mlx_lm/models/cache.py b/mlx_lm/models/cache.py
index 3650b87..4a17b8a 100644
--- a/mlx_lm/models/cache.py
+++ b/mlx_lm/models/cache.py
@@ -1665,14 +1665,31 @@ class LRUPromptCache:
                 i += 1
             return lru_b.popleft()
 
-    def __init__(self, max_size: int = 10, max_bytes: int = 1 << 63):
+    def __init__(
+        self,
+        max_size: int = 10,
+        max_bytes: int = 1 << 63,
+        on_evict: Optional[Any] = None,
+    ):
         self.max_size = max_size
         self.max_bytes = max_bytes
+        # Called as on_evict(model, tokens, CacheEntry) whenever insert_cache
+        # or trim_to evicts an entry, so a caller can demote it to a slower
+        # tier instead of letting it be discarded.
+        self.on_evict = on_evict
         self._trie = PromptTrie()
         self._lru = LRUPromptCache.CacheOrder()
         self._n_bytes = 0
         self._n_bytes_by_type = {k: 0 for k in self._lru._ordering}
 
+    def _evict_one(self):
+        model, tokens = self._lru.pop()
+        entry = self._trie.pop(model, tokens)
+        self._n_bytes -= entry.nbytes
+        self._n_bytes_by_type[entry.cache_type] -= entry.nbytes
+        if self.on_evict is not None:
+            self.on_evict(model, tokens, entry)
+
     def __len__(self):
         return len(self._lru)
 
@@ -1735,15 +1752,9 @@ class LRUPromptCache:
 
         # Ensure we match the constraints
         if len(self._lru) > self.max_size:
-            model, tokens = self._lru.pop()
-            entry = self._trie.pop(model, tokens)
-            self._n_bytes -= entry.nbytes
-            self._n_bytes_by_type[entry.cache_type] -= entry.nbytes
+            self._evict_one()
         while self._n_bytes > self.max_bytes:
-            model, tokens = self._lru.pop()
-            entry = self._trie.pop(model, tokens)
-            self._n_bytes -= entry.nbytes
-            self._n_bytes_by_type[entry.cache_type] -= entry.nbytes
+            self._evict_one()
 
     def trim_to(
         self, *, n_sequences: Optional[int] = None, n_bytes: Optional[int] = None
@@ -1752,15 +1763,9 @@ class LRUPromptCache:
         n_bytes = max(0, n_bytes) if n_bytes is not None else 1 << 63
 
         while len(self._lru) > n_sequences:
-            model, tokens = self._lru.pop()
-            entry = self._trie.pop(model, tokens)
-            self._n_bytes -= entry.nbytes
-            self._n_bytes_by_type[entry.cache_type] -= entry.nbytes
+            self._evict_one()
         while self._n_bytes > n_bytes:
-            model, tokens = self._lru.pop()
-            entry = self._trie.pop(model, tokens)
-            self._n_bytes -= entry.nbytes
-            self._n_bytes_by_type[entry.cache_type] -= entry.nbytes
+            self._evict_one()
 
     def stats_by_type(self):
         result = {}
diff --git a/mlx_lm/prompt_cache_disk.py b/mlx_lm/prompt_cache_disk.py
index 978caab..0e79d1c 100644
--- a/mlx_lm/prompt_cache_disk.py
+++ b/mlx_lm/prompt_cache_disk.py
@@ -11,6 +11,7 @@ change never risks feeding a stale KV cache into generation.
 
 import hashlib
 import json
+import queue
 import threading
 import time
 from pathlib import Path
@@ -37,6 +38,28 @@ class DiskPromptStore:
         self._index_path = self.dir / "index.json"
         self._lock = threading.Lock()
         self._index: List[Dict[str, Any]] = self._read_index()
+        self._write_queue: "queue.Queue" = queue.Queue()
+        self._writer_thread = threading.Thread(
+            target=self._writer_loop, daemon=True
+        )
+        self._writer_thread.start()
+
+    def _writer_loop(self):
+        while True:
+            item = self._write_queue.get()
+            if item is None:
+                return
+            model_key, tokens, entry = item
+            self.put(model_key, tokens, entry)
+
+    def put_async(self, model_key, tokens: List[int], entry: "LRUPromptCache.CacheEntry"):
+        """Demote an entry to disk off the calling thread. Used for
+        eviction, which must not block the request path on a disk write."""
+        self._write_queue.put((model_key, tokens, entry))
+
+    def close(self):
+        self._write_queue.put(None)
+        self._writer_thread.join()
 
     def _read_index(self) -> List[Dict[str, Any]]:
         if self._index_path.exists():
