diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
index ecbb7ae..ebacb4b 100644
--- a/tests/test_prompt_cache_disk.py
+++ b/tests/test_prompt_cache_disk.py
@@ -129,6 +129,22 @@ class TestDiskPromptStore(unittest.TestCase):
         _, rest = lru2.fetch_nearest_cache(("model-b", None, None), [9, 9, 9, 9, 9])
         self.assertEqual(rest, [])
 
+    def test_ram_eviction_demotes_to_disk_asynchronously(self):
+        store = self.make_store()
+        lru = LRUPromptCache(max_size=1, on_evict=store.put_async)
+        model_key = ("model-a", None, None)
+
+        lru.insert_cache(model_key, [1, 2, 3], make_cache(3), cache_type="assistant")
+        # Over max_size=1: evicts [1, 2, 3], handing it to put_async instead
+        # of discarding it.
+        lru.insert_cache(model_key, [9, 9], make_cache(2), cache_type="assistant")
+        self.assertEqual(len(lru), 1)
+
+        store.close()  # drains the writer thread deterministically for the test
+        rows = store.all_compatible(model_key)
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(rows[0]["tokens"], [1, 2, 3])
+
 
 if __name__ == "__main__":
     unittest.main()
