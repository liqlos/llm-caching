         self.max_bytes = max_bytes
@@ -1677,6 +1678,11 @@ class LRUPromptCache:
         # or trim_to evicts an entry, so a caller can demote it to a slower
         # tier instead of letting it be discarded.
         self.on_evict = on_evict
+        # Called as on_miss(model, tokens, ram_cache, ram_rest) whenever the
+        # RAM lookup below did not fully satisfy the request (ram_rest is
+        # non-empty), so a caller can consult a slower tier. Returning
+        # (cache, rest) overrides the RAM answer; returning None keeps it.
+        self.on_miss = on_miss
         self._trie = PromptTrie()
         self._lru = LRUPromptCache.CacheOrder()
         self._n_bytes = 0
@@ -1698,6 +1704,14 @@ class LRUPromptCache:
         return self._n_bytes
 
     def fetch_nearest_cache(self, model: Any, tokens: List[int]):
+        cache, rest = self._fetch_nearest_cache_ram(model, tokens)
+        if self.on_miss is not None and len(rest) > 0:
+            result = self.on_miss(model, tokens, cache, rest)
+            if result is not None:
+                return result
+        return cache, rest
+
+    def _fetch_nearest_cache_ram(self, model: Any, tokens: List[int]):
         result = self._trie.search(model, tokens)
         if result.exact is not None:
             cache_entry = self._trie.get(result.model, result.exact)
