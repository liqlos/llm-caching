 """
 
+import copy
 import hashlib
 import json
 import queue
@@ -17,7 +18,13 @@ import time
 from pathlib import Path
 from typing import Any, Dict, List, Optional, Tuple
 
-from .models.cache import LRUPromptCache, load_prompt_cache, save_prompt_cache
+from .models.cache import (
+    LRUPromptCache,
+    can_trim_prompt_cache,
+    load_prompt_cache,
+    save_prompt_cache,
+    trim_prompt_cache,
+)
 
 
 class DiskPromptStore:
@@ -176,6 +183,59 @@ class DiskPromptStore:
                     break
             self._write_index_locked()
 
+    def consult_and_promote(
+        self,
+        model_key,
+        tokens: List[int],
+        ram_cache,
+        ram_rest: List[int],
+        promote_into: "LRUPromptCache",
+    ):
+        """LRUPromptCache.on_miss hook: called when the RAM tier did not
+        fully satisfy a lookup (ram_rest is non-empty). If the disk tier can
+        do at least as well, loads and promotes that entry back into RAM
+        and returns (cache, rest) to use instead; otherwise returns None,
+        leaving the RAM answer (ram_cache, ram_rest) unchanged."""
+        exact, shorter, longer = self.search(model_key, tokens)
+        ram_reuse = len(tokens) - len(ram_rest)
+
+        if exact is not None:
+            cache = self.load(exact)
+            if cache is not None:
+                self.touch(exact)
+                promote_into.insert_cache(
+                    model_key, tokens, copy.deepcopy(cache), cache_type=exact["cache_type"]
+                )
+                return cache, []
+
+        if longer is not None:
+            cache = self.load(longer)
+            if cache is not None and can_trim_prompt_cache(cache):
+                self.touch(longer)
+                promote_into.insert_cache(
+                    model_key,
+                    longer["tokens"],
+                    copy.deepcopy(cache),
+                    cache_type=longer["cache_type"],
+                )
+                num_to_trim = len(longer["tokens"]) - len(tokens)
+                trim_prompt_cache(cache, num_to_trim)
+                return cache, []
+
+        if shorter is not None and len(shorter["tokens"]) > ram_reuse:
+            cache = self.load(shorter)
+            if cache is not None:
+                self.touch(shorter)
+                promote_into.insert_cache(
+                    model_key,
+                    shorter["tokens"],
+                    copy.deepcopy(cache),
+                    cache_type=shorter["cache_type"],
+                )
+                return cache, tokens[len(shorter["tokens"]):]
+
+        return None
+
     def all_compatible(self, model_key) -> List[Dict[str, Any]]:
         model_key = list(model_key)
         with self._lock:
