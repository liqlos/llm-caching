diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
index ebacb4b..d8cea30 100644
--- a/tests/test_prompt_cache_disk.py
+++ b/tests/test_prompt_cache_disk.py
@@ -145,6 +145,77 @@ class TestDiskPromptStore(unittest.TestCase):
         self.assertEqual(len(rows), 1)
         self.assertEqual(rows[0]["tokens"], [1, 2, 3])
 
+    def test_ram_miss_consults_disk_exact_and_promotes(self):
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        tokens = [1, 2, 3, 4, 5]
+        store.put(
+            model_key, tokens, LRUPromptCache.CacheEntry(make_cache(5), 100, "assistant")
+        )
+
+        lru = LRUPromptCache(
+            max_size=10,
+            on_miss=lambda m, t, rc, rr: store.consult_and_promote(m, t, rc, rr, lru),
+        )
+        cache, rest = lru.fetch_nearest_cache(model_key, tokens)
+        self.assertIsNotNone(cache)
+        self.assertEqual(rest, [])
+        # Promoted into RAM: a second lookup must not need on_miss at all.
+        self.assertEqual(len(lru), 1)
+        cache2, rest2 = lru.fetch_nearest_cache(model_key, tokens)
+        self.assertEqual(rest2, [])
+
+    def test_ram_miss_consults_disk_longer_and_trims(self):
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        full = [1, 2, 3, 4, 5]
+        store.put(
+            model_key, full, LRUPromptCache.CacheEntry(make_cache(5), 100, "assistant")
+        )
+
+        lru = LRUPromptCache(
+            max_size=10,
+            on_miss=lambda m, t, rc, rr: store.consult_and_promote(m, t, rc, rr, lru),
+        )
+        cache, rest = lru.fetch_nearest_cache(model_key, full[:3])
+        self.assertIsNotNone(cache)
+        self.assertEqual(rest, [])
+        self.assertEqual(cache[0].offset, 3)  # trimmed down to the query length
+        # RAM now holds the untrimmed disk entry, not the trimmed copy.
+        ram_cache, ram_rest = lru.fetch_nearest_cache(model_key, full)
+        self.assertEqual(ram_rest, [])
+
+    def test_ram_miss_consults_disk_shorter_only_if_better_than_ram(self):
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        store.put(
+            model_key, [1, 2, 3], LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant")
+        )
+
+        lru = LRUPromptCache(
+            max_size=10,
+            on_miss=lambda m, t, rc, rr: store.consult_and_promote(m, t, rc, rr, lru),
+        )
+        # RAM has nothing at all for this model, disk's [1, 2, 3] prefix wins.
+        cache, rest = lru.fetch_nearest_cache(model_key, [1, 2, 3, 4, 5])
+        self.assertIsNotNone(cache)
+        self.assertEqual(rest, [4, 5])
+
+        # Now RAM has a *better* (longer) prefix than disk for a new query;
+        # on_miss must not be consulted (rest is already empty after RAM).
+        exact_cache, exact_rest = lru.fetch_nearest_cache(model_key, [1, 2, 3])
+        self.assertEqual(exact_rest, [])
+
+    def test_ram_exact_hit_never_calls_on_miss(self):
+        def boom(*args, **kwargs):
+            raise AssertionError("on_miss must not be called on a RAM exact hit")
+
+        lru = LRUPromptCache(max_size=10, on_miss=boom)
+        model_key = ("model-a", None, None)
+        lru.insert_cache(model_key, [1, 2, 3], make_cache(3), cache_type="assistant")
+        cache, rest = lru.fetch_nearest_cache(model_key, [1, 2, 3])
+        self.assertEqual(rest, [])
+
 
 if __name__ == "__main__":
