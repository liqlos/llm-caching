From d32bb9867d58cb88e1ed7b041b034dbf19faecf8 Mon Sep 17 00:00:00 2001
From: Aleksei Bukhalov <buhaloff.aleks@gmail.com>
Date: Wed, 2 Sep 2026 02:45:34 +0200
Subject: [PATCH 7/7] fix: disk longer-trim must leave the last token
 unconsumed

Live-tested on M4: a request whose prompt was a strict prefix of a
disk-stored assistant-turn cache (a fresh conversation restarting from a
previously cached opening) crashed with "IndexError: list index out of
range" in generate.py's insert_segments, because consult_and_promote's
longer branch trimmed the cache exactly down to the query length,
returning rest=[].

PromptTrie's own longer branch never does this: prefix = min(len(tokens)
- 1, common_prefix) always leaves at least the last token to reprocess.
Applied the same -1 here. Test updated to assert the last token stays in
rest instead of asserting the (crash-triggering) empty rest.
---
 mlx_lm/prompt_cache_disk.py     | 11 +++++++++--
 tests/test_prompt_cache_disk.py |  8 ++++++--
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/mlx_lm/prompt_cache_disk.py b/mlx_lm/prompt_cache_disk.py
index 2fabf0f..5cab893 100644
--- a/mlx_lm/prompt_cache_disk.py
+++ b/mlx_lm/prompt_cache_disk.py
@@ -226,9 +226,16 @@ class DiskPromptStore:
                     copy.deepcopy(cache),
                     cache_type=longer["cache_type"],
                 )
-                num_to_trim = len(longer["tokens"]) - len(tokens)
+                # Mirrors PromptTrie's own longer-trim branch: always leave
+                # at least the last token unconsumed. Trimming all the way
+                # to a zero-length rest crashes downstream segment handling
+                # (observed live on M4: IndexError in generate.py on an
+                # empty final segment) -- upstream's RAM path never produces
+                # rest=[] here for exactly this reason.
+                prefix = len(tokens) - 1
+                num_to_trim = len(longer["tokens"]) - prefix
                 trim_prompt_cache(cache, num_to_trim)
-                return cache, []
+                return cache, tokens[prefix:]
 
         if shorter is not None and len(shorter["tokens"]) > ram_reuse:
             cache = self.load(shorter)
diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
index d8cea30..75d0a5a 100644
--- a/tests/test_prompt_cache_disk.py
+++ b/tests/test_prompt_cache_disk.py
@@ -179,8 +179,12 @@ class TestDiskPromptStore(unittest.TestCase):
         )
         cache, rest = lru.fetch_nearest_cache(model_key, full[:3])
         self.assertIsNotNone(cache)
-        self.assertEqual(rest, [])
-        self.assertEqual(cache[0].offset, 3)  # trimmed down to the query length
+        # Always leaves the last queried token unconsumed, matching
+        # PromptTrie's own longer-trim branch: trimming all the way to an
+        # empty rest crashes downstream segment handling (regression, was
+        # observed live on M4).
+        self.assertEqual(rest, [full[2]])
+        self.assertEqual(cache[0].offset, 2)
         # RAM now holds the untrimmed disk entry, not the trimmed copy.
         ram_cache, ram_rest = lru.fetch_nearest_cache(model_key, full)
         self.assertEqual(ram_rest, [])
