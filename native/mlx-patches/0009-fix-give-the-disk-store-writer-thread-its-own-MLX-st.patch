From 1bba6ed5b05903e366b7d5db02a7046e6872536d Mon Sep 17 00:00:00 2001
From: Aleksei Bukhalov <buhaloff.aleks@gmail.com>
Date: Wed, 2 Sep 2026 05:47:51 +0200
Subject: [PATCH 9/9] fix: give the disk-store writer thread its own MLX stream

Live-tested on M4: put_async's background writer thread hit the same
class of bug the flush-on-shutdown fix already addressed, in a spot that
fix didn't cover -- "RuntimeError: There is no Stream(cpu, 1) in current
thread" when demote-on-eviction wrote an entry from that thread. MLX
binds a compute stream per thread; _generate() sets one up for the
generation thread at its top, but a freshly spawned background thread
has none. Not reproducible on the M1 dev machine (no Metal device), which
is presumably why a synthetic KVCache round-trip test didn't catch it --
only a real generated cache under real GPU load did.

Calls mx.default_stream(mx.default_device()) once at the top of
_writer_loop, mirroring what _generate() already does.
---
 mlx_lm/prompt_cache_disk.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/mlx_lm/prompt_cache_disk.py b/mlx_lm/prompt_cache_disk.py
index 5cab893..79902a4 100644
--- a/mlx_lm/prompt_cache_disk.py
+++ b/mlx_lm/prompt_cache_disk.py
@@ -19,6 +19,8 @@ import time
 from pathlib import Path
 from typing import Any, Dict, List, Optional, Tuple
 
+import mlx.core as mx
+
 from .models.cache import (
     LRUPromptCache,
     can_trim_prompt_cache,
@@ -53,6 +55,14 @@ class DiskPromptStore:
         self._writer_thread.start()
 
     def _writer_loop(self):
+        # MLX binds a compute stream per thread; a freshly spawned thread
+        # has none until this is called (matches what _generate() does at
+        # the top of the generation thread). Without it, save_prompt_cache
+        # here raises "There is no Stream(...) in current thread" -- seen
+        # live on M4, not reproducible on the M1 dev machine (no Metal
+        # device), which is why it slipped past the earlier flush-on-
+        # shutdown fix (that one ran on the generation thread already).
+        mx.default_stream(mx.default_device())
         while True:
             item = self._write_queue.get()
             if item is None:
