From 8cd49407ea0aa0ca3968c6a37e36ad25e9a57a76 Mon Sep 17 00:00:00 2001
From: Aleksei Bukhalov <buhaloff.aleks@gmail.com>
Date: Wed, 2 Sep 2026 08:26:01 +0200
Subject: [PATCH 10/10] fix: skip re-writing a disk entry that's already
 durably stored

Gate G1-MLX run 2 crashed mid-run (RemoteDisconnected on the client) with
a cascade of "RuntimeError: [read] Unable to read from file" from
save_prompt_cache, right after a restart against a large (~20 GB, 12-
entry) disk store. Root cause: the bounded load-on-start fix (0008) loads
entries up to the RAM budget, but insert_cache's own eviction can
immediately demote one of those same entries straight back out as RAM
fills up -- a load-then-evict-again cycle that rewrites the exact same
file (entry_id is a deterministic hash of model_key/tokens/cache_type)
the just-loaded cache's lazy mx arrays haven't finished reading from yet.

Fixed at the source: put() now skips the write entirely when an entry
with this id is already in the index (content is byte-for-byte identical
by construction, so there's nothing to gain from rewriting it) -- just
touches last_used and returns. Also force-evaluates a loaded cache's
arrays in load() before returning, decoupling it from the source file's
contents as defense in depth against any other path to the same class of
bug.

New regression test: test_put_is_idempotent_for_an_existing_entry_id.
---
 mlx_lm/prompt_cache_disk.py     | 27 ++++++++++++++++++++++++++-
 tests/test_prompt_cache_disk.py | 27 +++++++++++++++++++++++++++
 2 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/mlx_lm/prompt_cache_disk.py b/mlx_lm/prompt_cache_disk.py
index 79902a4..5af5dc6 100644
--- a/mlx_lm/prompt_cache_disk.py
+++ b/mlx_lm/prompt_cache_disk.py
@@ -114,6 +114,23 @@ class DiskPromptStore:
         thread; the caller owns offloading it off the request path."""
         entry_id = self._entry_id(model_key, tokens, entry.cache_type)
         path = self.dir / f"{entry_id}.safetensors"
+
+        # entry_id is a deterministic hash of (model_key, tokens,
+        # cache_type), so an existing row with this id is byte-for-byte the
+        # same content -- skip the redundant write. This matters beyond
+        # efficiency: load() returns lazily-evaluated mx arrays that still
+        # read from `path` on first use, and this exact load-then-
+        # immediately-evict-again cycle (bounded load-on-start filling the
+        # RAM budget, then insert_cache's own eviction demoting the same
+        # entry straight back) was observed live on M4 to overwrite `path`
+        # out from under a not-yet-evaluated array loaded from it moments
+        # earlier, raising "RuntimeError: [read] Unable to read from file"
+        # and taking the server down.
+        with self._lock:
+            already_present = any(r["id"] == entry_id for r in self._index)
+        if already_present:
+            self.touch({"id": entry_id})
+            return
         try:
             save_prompt_cache(str(path), entry.prompt_cache)
             checksum = hashlib.sha256(path.read_bytes()).hexdigest()
@@ -188,7 +205,15 @@ class DiskPromptStore:
             if hashlib.sha256(path.read_bytes()).hexdigest() != row["checksum"]:
                 logging.warning("DiskPromptStore.load: checksum mismatch for %s", path)
                 return None
-            return load_prompt_cache(str(path))
+            cache = load_prompt_cache(str(path))
+            # mx.load()'s arrays are lazy and can still read from `path` on
+            # first use. Force materialization now so the returned cache no
+            # longer depends on this file's contents -- otherwise a later
+            # rewrite of the same path (put() skips that case now, but this
+            # is cheap insurance against any other path to it) would corrupt
+            # a read that hasn't happened yet.
+            mx.eval([c.state for c in cache])
+            return cache
         except Exception:
             logging.exception("DiskPromptStore.load: failed to read %s", path)
             return None
diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
index 75d0a5a..8634379 100644
--- a/tests/test_prompt_cache_disk.py
+++ b/tests/test_prompt_cache_disk.py
@@ -82,6 +82,33 @@ class TestDiskPromptStore(unittest.TestCase):
         self.assertIsNone(longer)
         self.assertEqual(store2.all_compatible(model_key), [])
 
+    def test_put_is_idempotent_for_an_existing_entry_id(self):
+        """Regression test: a load-then-immediately-evict-again cycle (the
+        bounded load-on-start filling the RAM budget, then insert_cache's
+        own eviction demoting the same entry straight back) used to
+        overwrite the just-read file out from under a not-yet-evaluated
+        lazy array loaded from it, crashing the server live on M4. put()
+        must skip rewriting an entry_id that is already durably stored."""
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        tokens = [1, 2, 3]
+        store.put(
+            model_key, tokens, LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant")
+        )
+        path = next(store.dir.glob("*.safetensors"))
+        mtime_before = path.stat().st_mtime_ns
+
+        loaded = store.load(store.search(model_key, tokens)[0])
+        self.assertIsNotNone(loaded)
+        # Re-"evicting" the just-loaded entry must not touch the file.
+        store.put(
+            model_key,
+            tokens,
+            LRUPromptCache.CacheEntry(loaded, 100, "assistant"),
+        )
+        self.assertEqual(path.stat().st_mtime_ns, mtime_before)
+        self.assertEqual(len(store.all_compatible(model_key)), 1)
+
     def test_eviction_respects_byte_budget(self):
         store = self.make_store(max_bytes=150)
         model_key = ("model-a", None, None)
-- 
