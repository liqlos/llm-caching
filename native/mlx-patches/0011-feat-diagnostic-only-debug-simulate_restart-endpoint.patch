+    def handle_simulate_restart(self):
+        """Diagnostic-only endpoint (NOW.md's iteration-speed ladder,
+        never gate evidence on its own): drops the RAM prompt cache and
+        rebuilds it from the disk tier, in-process, without a real
+        restart -- skips the ~15-20s model reload so a "post-restart cold
+        turn" microbenchmark costs one request, not one process restart.
+        """
+        try:
+            self.response_generator.request_simulated_restart()
+        except TimeoutError as e:
