@@ -445,6 +446,67 @@ class ResponseGenerator:
     def join(self):
         self._generation_thread.join()
 
+    def _restore_from_disk(self):
+        """Rebuild the RAM cache from the disk tier, bounded to the RAM
+        tier's own byte budget (most-recently-used first). Loading every
+        compatible disk entry unconditionally was measured live on M4 to
+        stall the first post-restart request by 10-25s once the disk
+        store grew past a few GB: on_miss already covers correctness for
+        anything left un-preloaded (loaded lazily, on the request that
+        actually needs it), so there is nothing to gain from preloading
+        more than what the RAM tier can hold anyway -- the rest would
+        just be evicted straight back out.
+
+        Called once at real startup (from _generate(), on the generation
+        thread -- MLX needs a stream bound to whichever thread evaluates
+        these arrays) and by simulate_restart() for the diagnostic-only
+        "drop RAM, reopen disk" endpoint NOW.md's iteration-speed ladder
+        uses to screen ladder levers without a real process restart.
+        """
+        if self.disk_store is None or self.model_provider.model_key is None:
+            return
+        rows = self.disk_store.all_compatible(self.model_provider.model_key)
+        rows.sort(key=lambda r: r.get("last_used", 0), reverse=True)
+        loaded_bytes = 0
+        for row in rows:
+            if loaded_bytes + row["n_bytes"] > self.prompt_cache.max_bytes:
+                continue
+            cache = self.disk_store.load(row)
+            if cache is None:
+                continue
+            self.prompt_cache.insert_cache(
+                tuple(row["model_key"]),
+                row["tokens"],
+                cache,
+                cache_type=row["cache_type"],
+            )
+            loaded_bytes += row["n_bytes"]
+
+    def _simulate_restart_now(self):
+        """Drop the RAM tier and rebuild it from the disk index. Must only
+        be called from the generation thread: it shares LRUPromptCache
+        state with every real request without a lock (by design -- that
+        thread is the sole owner), and MLX needs a stream bound to
+        whichever thread evaluates the reloaded arrays."""
+        self.prompt_cache.trim_to(n_sequences=0, n_bytes=0)
+        self._restore_from_disk()
+
+    def request_simulated_restart(self, timeout: float = 60.0):
+        """Diagnostic-only (never gate evidence on its own, per NOW.md):
+        thread-safe from any caller (e.g. an HTTP handler thread). Queues
+        the restart for the generation thread and blocks until it has run,
+        so the RAM-drop-and-reload always happens on the one thread that
+        owns the cache and has an MLX stream. A real restart's only
+        externally-visible difference this doesn't reproduce is the
+        ~15-20s model reload; the cache state afterward is the same
+        starting point -- this is the "simulated restart" NOW.md's
+        iteration-speed ladder uses to screen ladder levers without one.
+        """
+        done = Event()
+        self._restart_requests.put(done)
+        if not done.wait(timeout=timeout):
+            raise TimeoutError("simulated restart did not complete in time")
+
     def _log_cache_stats(self):
         n_sequences = len(self.prompt_cache)
         n_bytes = self.prompt_cache.nbytes
