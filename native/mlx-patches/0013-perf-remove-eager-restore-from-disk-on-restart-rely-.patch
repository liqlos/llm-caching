From d30ac375505ec467f7a6e79fbdb1e2077e2de69f Mon Sep 17 00:00:00 2001
From: Aleksei Bukhalov <buhaloff.aleks@gmail.com>
Date: Wed, 2 Sep 2026 11:49:54 +0200
Subject: [PATCH 13/13] perf: remove eager restore-from-disk on restart, rely
 on lazy on_miss

Direct profiling on M4 (per-call timing against a completed Gate G1-MLX
disk store) found the bounded restore-from-disk-on-start -- meant to
rebuild the RAM tier's most-recently-used entries after a restart -- itself
costs ~2s per restart (e.g. two ~2GB entries at ~1s each to fill a 4GB RAM
budget), while a single per-request disk consult via the already-wired
on_miss hook (LRUPromptCache -> DiskPromptStore.consult_and_promote) loads
the one entry a request actually needs in ~40ms. The eager preload's
entries are not necessarily what the next request needs, and when they
are, on_miss handles it lazily at a fraction of the cost with identical
correctness (already covered by the existing test suite). Removes a fixed
~2s tax paid by every restart's first request for no measured benefit.
---
 mlx_lm/server.py | 61 ++++++++++++++----------------------------------
 1 file changed, 17 insertions(+), 44 deletions(-)

diff --git a/mlx_lm/server.py b/mlx_lm/server.py
index 8cfde99..ebb3958 100644
--- a/mlx_lm/server.py
+++ b/mlx_lm/server.py
@@ -446,50 +446,25 @@ class ResponseGenerator:
     def join(self):
         self._generation_thread.join()
 
-    def _restore_from_disk(self):
-        """Rebuild the RAM cache from the disk tier, bounded to the RAM
-        tier's own byte budget (most-recently-used first). Loading every
-        compatible disk entry unconditionally was measured live on M4 to
-        stall the first post-restart request by 10-25s once the disk
-        store grew past a few GB: on_miss already covers correctness for
-        anything left un-preloaded (loaded lazily, on the request that
-        actually needs it), so there is nothing to gain from preloading
-        more than what the RAM tier can hold anyway -- the rest would
-        just be evicted straight back out.
-
-        Called once at real startup (from _generate(), on the generation
-        thread -- MLX needs a stream bound to whichever thread evaluates
-        these arrays) and by simulate_restart() for the diagnostic-only
-        "drop RAM, reopen disk" endpoint NOW.md's iteration-speed ladder
-        uses to screen ladder levers without a real process restart.
-        """
-        if self.disk_store is None or self.model_provider.model_key is None:
-            return
-        rows = self.disk_store.all_compatible(self.model_provider.model_key)
-        rows.sort(key=lambda r: r.get("last_used", 0), reverse=True)
-        loaded_bytes = 0
-        for row in rows:
-            if loaded_bytes + row["n_bytes"] > self.prompt_cache.max_bytes:
-                continue
-            cache = self.disk_store.load(row)
-            if cache is None:
-                continue
-            self.prompt_cache.insert_cache(
-                tuple(row["model_key"]),
-                row["tokens"],
-                cache,
-                cache_type=row["cache_type"],
-            )
-            loaded_bytes += row["n_bytes"]
-
     def _simulate_restart_now(self):
-        """Drop the RAM tier and rebuild it from the disk index. Must only
-        be called from the generation thread: it shares LRUPromptCache
-        state with every real request without a lock (by design -- that
-        thread is the sole owner), and MLX needs a stream bound to
-        whichever thread evaluates the reloaded arrays."""
+        """Drop the RAM tier. Deliberately does not eagerly reload from the
+        disk tier: on_miss (LRUPromptCache's on_miss hook, wired to
+        DiskPromptStore.consult_and_promote) already restores and promotes
+        whatever a request actually needs, lazily, on that request. An
+        earlier version of this restore eagerly bulk-loaded disk entries up
+        to the RAM tier's own byte budget (most-recently-used first) on
+        every restart; measured directly on M4, that bounded bulk load
+        itself still cost ~2s per restart (e.g. two ~2GB entries at ~1s
+        each) for no measurable benefit over the lazy path -- the entries
+        it preloads are not necessarily the ones the next request needs,
+        and when they are, on_miss loads that one specific entry in
+        ~40ms. Removed rather than tuned further, since there was nothing
+        for it to buy: on_miss is a strict superset in both correctness
+        and cost. Must only be called from the generation thread: it
+        shares LRUPromptCache state with every real request without a
+        lock (by design -- that thread is the sole owner), and MLX needs a
+        stream bound to whichever thread evaluates any reloaded arrays."""
         self.prompt_cache.trim_to(n_sequences=0, n_bytes=0)
-        self._restore_from_disk()
 
     def request_simulated_restart(self, timeout: float = 60.0):
         """Diagnostic-only (never gate evidence on its own, per NOW.md):
@@ -700,8 +675,6 @@ class ResponseGenerator:
         # Load the default model if it is given
         self.model_provider.load_default()
 
-        self._restore_from_disk()
-
         current_model = None
         current_sampling = None
         current_tokenizer = None
