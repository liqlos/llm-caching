+    def record_prefill_observation(self, n_tokens: int, wall_s: float):
+        """Feed one observed prefill's throughput into the EWMA the cost-
+        model admission check uses. Called by the server after a request's
+        prefill completes, timed from immediately before generation starts
+        to the last prompt_progress_callback invocation -- decode time is
+        not included, since decode throughput is irrelevant to whether a
+        disk consult (which only ever saves prefill work) is worth it."""
+        if n_tokens <= 0 or wall_s <= 0:
+            return
+        observed = n_tokens / wall_s
+        self.prefill_tokens_per_sec = (
+            self._ewma_alpha * observed
+            + (1 - self._ewma_alpha) * self.prefill_tokens_per_sec
+        )
+
+    def _record_disk_read_observation(self, n_bytes: int, wall_s: float):
+        if n_bytes <= 0 or wall_s <= 0:
+            return
+        observed_mb_s = (n_bytes / 1e6) / wall_s
+        self.disk_mb_per_sec = (
+            self._ewma_alpha * observed_mb_s
+            + (1 - self._ewma_alpha) * self.disk_mb_per_sec
+        )
+
