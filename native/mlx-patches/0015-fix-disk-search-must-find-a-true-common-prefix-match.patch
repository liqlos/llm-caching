+    def test_ram_miss_consults_disk_partial_divergent_prefix(self):
+        """Gate G1-MLX (live M4 data, discovered after removing eager
+        restore-on-start): a stored entry and a later query can diverge
+        *before* either one's own full length -- e.g. a stored assistant
+        turn is [wrapped user prompt][generated continuation], and the
+        next turn's query extends only the user-prompt portion with its
+        own different continuation. Neither the old "shorter" (row fully
+        consumed) nor "longer" (query fully consumed) whole-key-equality
+        check recognizes this as usable, even though a large, valid common
+        prefix exists. This must be found and trimmed to the true common
+        prefix, exactly as RAM's own trie already does."""
+        store = self.make_store(admission_safety_factor=0.0)
+        model_key = ("model-a", None, None)
+        shared_prefix = list(range(100))
+        stored = shared_prefix + [999, 998, 997]  # diverges after the shared prefix
+        store.put(
+            model_key, stored, LRUPromptCache.CacheEntry(make_cache(len(stored)), 100, "assistant")
+        )
+
+        query = shared_prefix + [1, 2, 3, 4, 5]  # same shared prefix, different continuation
+        lru = LRUPromptCache(
+            max_size=10,
+            on_miss=lambda m, t, rc, rr: store.consult_and_promote(m, t, rc, rr, lru),
+        )
+        cache, rest = lru.fetch_nearest_cache(model_key, query)
+        self.assertIsNotNone(cache)
+        self.assertEqual(rest, query[len(shared_prefix):])
+        self.assertEqual(cache[0].offset, len(shared_prefix))
+
