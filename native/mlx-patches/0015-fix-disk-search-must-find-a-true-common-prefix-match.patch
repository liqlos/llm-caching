@@ -281,14 +322,16 @@ class DiskPromptStore:
                     break
             self._write_index_locked()
 
-    def _shorter_match_worth_admitting(self, row: Dict[str, Any]) -> bool:
-        """Cost-model admission: load this "shorter" entry only if the
-        prefill time it saves is expected to comfortably exceed the time
-        spent reading it, using this process's own observed prefill and
-        disk-read throughput (see record_prefill_observation / __init__).
-        A fixed token-count threshold would need re-tuning on every host,
-        model, quantization, or disk; this self-calibrates instead."""
-        recoverable_tokens = len(row["tokens"])
+    def _worth_admitting(self, row: Dict[str, Any], recoverable_tokens: int) -> bool:
+        """Cost-model admission: load this entry only if the prefill time
+        `recoverable_tokens` saves is expected to comfortably exceed the
+        time spent reading the file, using this process's own observed
+        prefill and disk-read throughput (see record_prefill_observation /
+        __init__). Applies to any small recovery regardless of which
+        branch it came from ("shorter", or a "longer"/trimmable candidate
+        whose common prefix with the query happens to be small) -- a fixed
+        token-count threshold would need re-tuning on every host, model,
+        quantization, or disk; this self-calibrates instead."""
         est_save_s = recoverable_tokens / self.prefill_tokens_per_sec
         est_read_s = (row["n_bytes"] / 1e6) / self.disk_mb_per_sec
         return est_save_s >= est_read_s * self.admission_safety_factor
