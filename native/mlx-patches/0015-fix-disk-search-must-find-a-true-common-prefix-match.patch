+            # Recompute the true common-prefix depth: `longer` may be a
+            # literal superset of `tokens`, or may just share a shorter
+            # common prefix that diverges before either sequence's own
+            # full length (see search()'s docstring). Either way this is
+            # the deepest prefix this row can safely serve.
+            common_prefix = self._common_prefix_len(longer["tokens"], tokens)
+            # Mirrors PromptTrie's own longer-trim branch: always leave at
+            # least the last queried token unconsumed. Trimming all the way
+            # to a zero-length rest crashes downstream segment handling
+            # (observed live on M4: IndexError in generate.py on an empty
+            # final segment) -- upstream's RAM path never produces rest=[]
+            # here for exactly this reason.
+            prefix = min(len(tokens) - 1, common_prefix)
+            recoverable = prefix - ram_reuse
+            if prefix > max(ram_reuse, 0) and self._worth_admitting(longer, recoverable):
