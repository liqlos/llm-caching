@@ -160,6 +174,29 @@ class DiskPromptStore:
         h.update(cache_type.encode())
         return h.hexdigest()
 
+    def _maybe_quantize(self, prompt_cache: List[Any]) -> List[Any]:
+        """Convert plain KVCache entries to QuantizedKVCache before writing
+        to disk, if quantization is enabled. Roughly a 4x size reduction
+        at self.quantize_bits=4 (packed uint32 storage instead of
+        fp16/bf16), which directly shrinks both the file this project's
+        own fixed per-entry cost (read + deserialize) scales with, and the
+        prefill-time-equivalent this cost is compared against in the
+        cost-model admission check. Already-quantized entries (re-demoted
+        after being loaded back from disk once) and any cache type without
+        a `to_quantized` method pass through unchanged -- a fresh copy of
+        the list either way, never mutating the caller's own entry, which
+        may still be in use elsewhere (e.g. RAM's own trie holds the same
+        object this eviction is demoting)."""
+        if self.quantize_bits is None:
+            return prompt_cache
+        converted = []
+        for c in prompt_cache:
+            if isinstance(c, QuantizedKVCache) or not hasattr(c, "to_quantized"):
+                converted.append(c)
+            else:
+                converted.append(c.to_quantized(self.quantize_group_size, self.quantize_bits))
+        return converted
+
     def put(self, model_key, tokens: List[int], entry: "LRUPromptCache.CacheEntry"):
         """Write one cache entry to disk. Safe to call from a background
         thread; the caller owns offloading it off the request path."""
@@ -182,26 +219,47 @@ class DiskPromptStore:
         if already_present:
             self.touch({"id": entry_id})
             return
+        # mx.save_safetensors appends ".safetensors" to whatever name it is
+        # given if the name doesn't already end in it -- naming the temp
+        # file "<id>.tmp.safetensors" (not "<id>.safetensors.tmp") keeps
+        # the actual written path predictable for the rename below.
+        tmp_path = self.dir / f"{entry_id}.tmp.safetensors"
         try:
-            save_prompt_cache(str(path), entry.prompt_cache)
-            checksum = hashlib.sha256(path.read_bytes()).hexdigest()
+            to_save = self._maybe_quantize(entry.prompt_cache)
+            save_prompt_cache(str(tmp_path), to_save)
+            # entry.nbytes is the caller's own accounting of the cache it
+            # handed in (tests deliberately pass synthetic values here);
+            # only recompute it when quantization actually changed what
+            # got written, since entry.nbytes would otherwise be stale.
+            n_bytes = (
+                entry.nbytes
+                if to_save is entry.prompt_cache
+                else sum(c.nbytes for c in to_save)
+            )
+            # Atomic rename: the final path only ever exists fully written,
+            # so a reader never observes a partial file. This is what lets
+            # load() skip a separate full-file read-and-checksum pass on
+            # every load -- previously the dominant cost for a large entry
+            # (measured on M4: ~1s of a ~1.09s total load() for a ~2GB
+            # entry was read_bytes()+sha256, done purely to catch a
+            # corruption class this rename already rules out).
+            tmp_path.replace(path)
         except Exception:
             logging.exception(
                 "DiskPromptStore.put: failed to write %s, dropping this entry",
                 path,
             )
-            path.unlink(missing_ok=True)
+            tmp_path.unlink(missing_ok=True)
             return
         row = {
             "id": entry_id,
             "model_key": list(model_key),
             "tokens": list(tokens),
             "cache_type": entry.cache_type,
-            "n_bytes": entry.nbytes,
+            "n_bytes": n_bytes,
             "mlx_version": self.mlx_version,
             "mlx_lm_version": self.mlx_lm_version,
             "system_fingerprint": self.system_fingerprint,
-            "checksum": checksum,
             "last_used": time.time(),
         }
         with self._lock:
@@ -295,10 +353,13 @@ class DiskPromptStore:
             return None
         t0 = time.monotonic()
         try:
-            raw = path.read_bytes()
-            if hashlib.sha256(raw).hexdigest() != row["checksum"]:
-                logging.warning("DiskPromptStore.load: checksum mismatch for %s", path)
-                return None
+            # No separate read-and-checksum pass: put() only ever makes
+            # `path` visible via an atomic rename from a fully-written temp
+            # file (see put()'s docstring), so a reader can never observe a
+            # partial write here -- the corruption class a checksum would
+            # catch cannot occur. A row from an older index (written before
+            # this change) may still carry a "checksum" field; it is simply
+            # unused now, not treated as a signal either way.
             cache = load_prompt_cache(str(path))
             # mx.load()'s arrays are lazy and can still read from `path` on
             # first use. Force materialization now so the returned cache no
