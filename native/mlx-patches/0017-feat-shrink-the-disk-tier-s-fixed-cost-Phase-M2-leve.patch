@@ -5,7 +5,7 @@ import unittest
 
 import mlx.core as mx
 
-from mlx_lm.models.cache import KVCache, LRUPromptCache
+from mlx_lm.models.cache import KVCache, LRUPromptCache, can_trim_prompt_cache
 from mlx_lm.prompt_cache_disk import DiskPromptStore
 
 
@@ -339,6 +339,63 @@ class TestDiskPromptStore(unittest.TestCase):
         cache, rest = lru.fetch_nearest_cache(model_key, [1, 2, 3])
         self.assertEqual(rest, [])
 
+    def test_put_leaves_no_temp_file_behind_on_success(self):
+        store = self.make_store()
+        model_key = ("model-a", None, None)
+        store.put(
+            model_key, [1, 2, 3], LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant")
+        )
+        names = [p.name for p in store.dir.iterdir()]
+        self.assertTrue(any(n.endswith(".safetensors") for n in names))
+        self.assertFalse(any(".tmp" in n for n in names))
+
+    def test_quantized_entry_round_trips_and_is_smaller(self):
+        # mx.quantize only accepts group sizes 32/64/128, so this test
+        # needs a realistic head_dim (real models: 64-128), unlike the
+        # tiny synthetic shape make_cache() uses elsewhere in this file.
+        def make_realistic_cache(n_tokens):
+            c = KVCache()
+            c.update_and_fetch(mx.zeros((1, 2, n_tokens, 64)), mx.zeros((1, 2, n_tokens, 64)))
+            mx.eval(c.state)
+            return [c]
+
+        store_plain = self.make_store()
+        store_quant = self.make_store(quantize_bits=4)
+        # Different model_key so the two entries (both stores share
+        # setUp's tmp directory) don't collide on the same entry_id.
+        model_key_plain = ("model-a", None, None)
+        model_key = ("model-b", None, None)
+        tokens = list(range(300))
+
+        store_plain.put(
+            model_key_plain, tokens, LRUPromptCache.CacheEntry(make_realistic_cache(300), 0, "assistant")
+        )
+        store_quant.put(
+            model_key, tokens, LRUPromptCache.CacheEntry(make_realistic_cache(300), 0, "assistant")
+        )
+
+        plain_row = store_plain.search(model_key_plain, tokens)[0]
+        quant_row = store_quant.search(model_key, tokens)[0]
+        plain_path = store_plain.dir / f"{plain_row['id']}.safetensors"
+        quant_path = store_quant.dir / f"{quant_row['id']}.safetensors"
+        self.assertLess(quant_path.stat().st_size, plain_path.stat().st_size)
+
+        row = store_quant.search(model_key, tokens)[0]
+        self.assertIsNotNone(row)
+        loaded = store_quant.load(row)
+        self.assertIsNotNone(loaded)
+        self.assertEqual(loaded[0].offset, 300)
+        self.assertTrue(can_trim_prompt_cache(loaded))
+
+    def test_quantize_does_not_mutate_the_callers_entry(self):
+        store = self.make_store(quantize_bits=4)
+        model_key = ("model-a", None, None)
+        cache = make_cache(10)
+        store.put(model_key, [1] * 10, LRUPromptCache.CacheEntry(cache, 0, "assistant"))
+        # The original, in-RAM object must remain a plain KVCache -- only
+        # the on-disk copy is quantized.
+        self.assertIsInstance(cache[0], KVCache)
+
 
 if __name__ == "__main__":
     unittest.main()
