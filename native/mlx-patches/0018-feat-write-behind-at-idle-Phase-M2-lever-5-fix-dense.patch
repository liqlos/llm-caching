From 723af2beb4bf483756d60889d4b7a00fbfd27f53 Mon Sep 17 00:00:00 2001
From: Aleksei Bukhalov <buhaloff.aleks@gmail.com>
Date: Wed, 2 Sep 2026 16:05:01 +0200
Subject: [PATCH 18/18] feat: write-behind at idle (Phase M2 lever 5) -- fix
 denser-restart elsewhere-turn regression

A restart-density sensitivity receipt (~1 restart per 8 turns) found
ram_disk running ~12% slower than ram on non-cold turns, uniformly
across every distance from the last restart (not concentrated near
restart, which would point to one-time Metal kernel warmup instead) --
consistent with the background writer thread's own disk I/O and
mx.eval/quantize work contending with the generation thread's Metal/GPU
work throughout a process's lifetime, worse at denser restart cadence
because proportionally more eviction/write activity happens per unit of
useful generation work.

DiskPromptStore gets an idle_event (set by default); the writer thread
waits on it before actually writing a dequeued item, and
ResponseGenerator._serve_single clears it for the duration of a request
and sets it in a finally block. A write already queued during a request
simply waits a little longer -- eviction/promotion into RAM already
happened synchronously before it was enqueued, so a delayed disk write
never delays serving anything. close() explicitly sets idle_event first
as defense-in-depth against a queued item leaving the writer blocked
when shutdown wants to join() it.

2 new tests (writer waits for idle before writing; close() never
deadlocks with idle_event cleared); all 18 pass.
---
 mlx_lm/prompt_cache_disk.py     | 30 ++++++++++++++++++++++++++++++
 mlx_lm/server.py                | 11 +++++++++++
 tests/test_prompt_cache_disk.py | 27 +++++++++++++++++++++++++++
 3 files changed, 68 insertions(+)

diff --git a/mlx_lm/prompt_cache_disk.py b/mlx_lm/prompt_cache_disk.py
index 4896e21..e2102d1 100644
--- a/mlx_lm/prompt_cache_disk.py
+++ b/mlx_lm/prompt_cache_disk.py
@@ -90,6 +90,21 @@ class DiskPromptStore:
         self._lock = threading.Lock()
         self._index: List[Dict[str, Any]] = self._read_index()
         self._write_queue: "queue.Queue" = queue.Queue()
+        # Phase M2 ladder item 5 (write-behind at idle): a denser-restart
+        # receipt (~1 restart per 8 turns) measured the background writer
+        # thread's own disk I/O / mx.eval work contending with the
+        # generation thread's Metal/GPU work throughout a process's
+        # lifetime -- elsewhere-turn wall-clock ran ~12% slower on
+        # average than `ram`, uniformly across every distance from the
+        # last restart (not concentrated near restart, which would point
+        # to one-time Metal kernel warmup instead). The server clears this
+        # while a request is in flight and sets it between requests (see
+        # ResponseGenerator._generate/_serve_single); the writer thread
+        # only does its actual write once idle, so it never competes with
+        # a request actively generating. Starts set: a store used outside
+        # the server (tests, offline scripts) never blocks on it.
+        self.idle_event = threading.Event()
+        self.idle_event.set()
         self._writer_thread = threading.Thread(
             target=self._writer_loop, daemon=True
         )
@@ -132,6 +147,15 @@ class DiskPromptStore:
             item = self._write_queue.get()
             if item is None:
                 return
+            # Write-behind at idle: wait for the server to signal no
+            # request is in flight before doing the actual write, so this
+            # thread's disk I/O and mx.eval/quantize work never contends
+            # with the generation thread's own Metal/GPU work. A queued
+            # item just waits a little longer if the server is mid-request
+            # when it arrives -- eviction/promotion into RAM already
+            # happened synchronously before this was even enqueued, so a
+            # delayed disk write does not delay serving anything.
+            self.idle_event.wait()
             model_key, tokens, entry = item
             self.put(model_key, tokens, entry)
 
@@ -141,6 +165,12 @@ class DiskPromptStore:
         self._write_queue.put((model_key, tokens, entry))
 
     def close(self):
+        # Defense-in-depth: closing must never deadlock on idle_event. In
+        # normal operation this is already set by the time close() runs
+        # (flush-on-shutdown happens after the request-serving loop has
+        # exited), but a writer thread blocked mid-wait on a queued item
+        # from before that point must not be able to wedge join() below.
+        self.idle_event.set()
         self._write_queue.put(None)
         self._writer_thread.join()
 
diff --git a/mlx_lm/server.py b/mlx_lm/server.py
index 91085ec..bcba327 100644
--- a/mlx_lm/server.py
+++ b/mlx_lm/server.py
@@ -957,6 +957,14 @@ class ResponseGenerator:
     def _serve_single(self, request):
         rqueue, request, args = request
 
+        # Write-behind at idle (see DiskPromptStore.idle_event): the
+        # background writer thread only does its actual disk write while
+        # this is set, so it never contends with this request's own
+        # Metal/GPU work. Cleared for the whole request, not just prefill,
+        # since decode also uses the GPU throughout.
+        if self.disk_store is not None:
+            self.disk_store.idle_event.clear()
+
         # Define the progress callback. Also times prefill (progress()
         # only fires during the prefill phase, never during decode) to
         # feed the disk tier's cost-model admission check its own observed
@@ -1076,6 +1084,9 @@ class ResponseGenerator:
 
         except Exception as e:
             rqueue.put(e)
+        finally:
+            if self.disk_store is not None:
+                self.disk_store.idle_event.set()
 
     def generate(
         self,
diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
index 378839f..90eba0b 100644
--- a/tests/test_prompt_cache_disk.py
+++ b/tests/test_prompt_cache_disk.py
@@ -396,6 +396,33 @@ class TestDiskPromptStore(unittest.TestCase):
         # the on-disk copy is quantized.
         self.assertIsInstance(cache[0], KVCache)
 
+    def test_writer_thread_waits_for_idle_before_writing(self):
+        """Phase M2 ladder item 5 (write-behind at idle): a denser-restart
+        receipt found the background writer thread's own disk I/O
+        contending with the generation thread's Metal/GPU work. put_async
+        must not actually write while idle_event is clear, even though
+        the item is already queued."""
+        store = self.make_store()
+        store.idle_event.clear()
+        model_key = ("model-a", None, None)
+        store.put_async(model_key, [1, 2, 3], LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant"))
+
+        import time
+        time.sleep(0.2)
+        self.assertEqual(store.all_compatible(model_key), [])
+
+        store.idle_event.set()
+        store.close()
+        self.assertEqual(len(store.all_compatible(model_key)), 1)
+
+    def test_close_never_deadlocks_with_idle_event_cleared(self):
+        store = self.make_store()
+        store.idle_event.clear()
+        model_key = ("model-a", None, None)
+        store.put_async(model_key, [1, 2, 3], LRUPromptCache.CacheEntry(make_cache(3), 100, "assistant"))
+        store.close()  # must return promptly, not hang on idle_event
+        self.assertEqual(len(store.all_compatible(model_key)), 1)
+
 
 if __name__ == "__main__":
     unittest.main()
