diff --git a/tests/test_prompt_cache_disk.py b/tests/test_prompt_cache_disk.py
index 90eba0b..59ec9ce 100644
--- a/tests/test_prompt_cache_disk.py
+++ b/tests/test_prompt_cache_disk.py
@@ -5,7 +5,12 @@ import unittest
 
 import mlx.core as mx
 
-from mlx_lm.models.cache import KVCache, LRUPromptCache, can_trim_prompt_cache
+from mlx_lm.models.cache import (
+    KVCache,
+    LRUPromptCache,
+    QuantizedKVCache,
+    can_trim_prompt_cache,
+)
 from mlx_lm.prompt_cache_disk import DiskPromptStore
 
 
@@ -387,6 +392,37 @@ class TestDiskPromptStore(unittest.TestCase):
         self.assertEqual(loaded[0].offset, 300)
         self.assertTrue(can_trim_prompt_cache(loaded))
 
+    def test_dequantize_on_promote_recovers_plain_kvcache_and_values(self):
+        def make_realistic_cache(n_tokens):
+            c = KVCache()
+            keys = mx.random.normal((1, 2, n_tokens, 64))
+            values = mx.random.normal((1, 2, n_tokens, 64))
+            c.update_and_fetch(keys, values)
+            mx.eval(c.state)
+            return [c], keys, values
+
+        store = self.make_store(quantize_bits=4, dequantize_on_promote=True)
+        model_key = ("model-a", None, None)
+        tokens = list(range(50))
+        cache, keys, values = make_realistic_cache(50)
+        store.put(model_key, tokens, LRUPromptCache.CacheEntry(cache, 0, "assistant"))
+
+        row = store.search(model_key, tokens)[0]
+        loaded = store.load(row)
+        self.assertIsInstance(loaded[0], QuantizedKVCache)
+
+        dequantized = store._maybe_dequantize(loaded)
+        self.assertIsInstance(dequantized[0], KVCache)
+        self.assertEqual(dequantized[0].offset, 50)
+        self.assertTrue(mx.allclose(dequantized[0].keys, keys, atol=0.5).item())
+        self.assertTrue(mx.allclose(dequantized[0].values, values, atol=0.5).item())
+
+    def test_dequantize_on_promote_passes_through_plain_entries_unchanged(self):
+        store = self.make_store(dequantize_on_promote=True)
+        cache = make_cache(5)
+        result = store._maybe_dequantize(cache)
+        self.assertIs(result[0], cache[0])
+
     def test_quantize_does_not_mutate_the_callers_entry(self):
         store = self.make_store(quantize_bits=4)
         model_key = ("model-a", None, None)
