@@ -227,6 +237,28 @@ class DiskPromptStore:
                 converted.append(c.to_quantized(self.quantize_group_size, self.quantize_bits))
         return converted
 
+    @staticmethod
+    def _maybe_dequantize(prompt_cache: List[Any]) -> List[Any]:
+        """The inverse of _maybe_quantize, applied at promotion time when
+        dequantize_on_promote is set: reconstructs full-precision keys and
+        values from a QuantizedKVCache's packed state via mx.dequantize,
+        and loads them into a fresh plain KVCache. Non-quantized entries
+        pass through unchanged. Always returns a new list."""
+        converted = []
+        for c in prompt_cache:
+            if not isinstance(c, QuantizedKVCache):
+                converted.append(c)
+                continue
+            plain = KVCache()
+            if c.keys is not None:
+                keys = mx.dequantize(*c.keys, group_size=c.group_size, bits=c.bits)
+                values = mx.dequantize(*c.values, group_size=c.group_size, bits=c.bits)
+                plain.keys = keys
+                plain.values = values
+            plain.offset = c.offset
+            converted.append(plain)
+        return converted
+
     def put(self, model_key, tokens: List[int], entry: "LRUPromptCache.CacheEntry"):
         """Write one cache entry to disk. Safe to call from a background
         thread; the caller owns offloading it off the request path."""
