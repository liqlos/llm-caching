+            // to reserve target logits. Never return a longer draft than that
+            // reservation, even when a slot has more remaining context.
+            const size_t max_tokens = std::min<size_t>(max_draft_tokens, dp.n_max > 0 ? (size_t) dp.n_max : max_draft_tokens);
