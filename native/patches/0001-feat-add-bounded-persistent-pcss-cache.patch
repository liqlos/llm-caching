+    void observe(llama_seq_id seq_id, llama_token token) override {
+        if (disabled || !sinfos[seq_id].active) return;
+        sinfos[seq_id].visible.push_back(token);
+    }
+
+    void end(llama_seq_id seq_id, bool successful) override {
+        auto & info = sinfos[seq_id];
+        if (!info.active) {
+            clear_current_source(info);
+            refresh_current_source_index_bytes();
+            return;
+        }
+        info.active = false;
+
+        if (!successful && info.visible.size() > info.prompt_size) {
+            ++metrics.abort_suppressions;
+        }
+        if (successful) {
+            ++metrics.successful_ends;
+        }
+        if (successful && info.visible.size() > info.prompt_size && !learning_enabled) {
+            ++metrics.learning_suppressions;
+        }
+
+        if (successful && !disabled && learning_enabled && store && info.visible.size() > info.prompt_size) {
+            constexpr size_t max_prefix_tokens = 64;
+            constexpr size_t max_continuation_tokens = 8;
+            constexpr size_t max_records_per_request = 32;
+            std::vector<pcss::match> batch;
+            batch.reserve(max_records_per_request);
+            const size_t first_pos = info.prompt_size + 1;
+            const size_t candidate_count = info.visible.size() > first_pos ? info.visible.size() - first_pos : 0;
+            constexpr size_t anchor_count = max_records_per_request / 2;
+            const size_t record_count = std::min(anchor_count, candidate_count);
+            // Sample the entire committed continuation deterministically.  A
+            // first-32-only policy never records prompt-independent tail
+            // windows for long requests, preventing exact reuse after a
+            // small edit to the instruction prefix.
+            for (size_t record = 0; record < record_count; ++record) {
+                const size_t pos = first_pos + (record_count == 1 ? 0 : record * (candidate_count - 1) / (record_count - 1));
+                const size_t continuation_end = std::min(info.visible.size(), pos + max_continuation_tokens);
+                const llama_tokens continuation(info.visible.begin() + pos, info.visible.begin() + continuation_end);
+                for (const size_t prefix_tokens : { max_prefix_tokens, size_t(32) }) {
+                    const size_t prefix_begin = pos > prefix_tokens ? pos - prefix_tokens : 0;
+                    if (prefix_begin == pos) continue;
+                    if (!batch.empty() && prefix_tokens == 32 && batch.back().prefix.size() == pos - prefix_begin) continue;
+                    batch.push_back(pcss::match{
+                        llama_tokens(info.visible.begin() + prefix_begin, info.visible.begin() + pos),
+                        continuation,
+                    });
+                }
+            }
+            if (!batch.empty()) {
+                std::string error;
+                const int64_t update_start = ggml_time_us();
+                const bool stored = store->put_batch(batch, &error);
+                metrics.update_us += ggml_time_us() - update_start;
+                if (!stored) {
+                    disabled = true;
+                    ++metrics.fallback_disable_events;
+                    SPC_ERR("pcss-cache disabled after write failure: %s\n", error.c_str());
+                } else {
+                    metrics.records_learned += batch.size();
+                }
+            }
+        }
+
+        info.visible.clear();
+        info.proposed_prefix.clear();
+        info.proposed.clear();
+        info.ngram_cache_size = 0;
+        info.ngram_cache_context.clear();
+        info.prompt_size = 0;
+        info.source = seq_info::SOURCE_NONE;
+        clear_current_source(info);
+        refresh_current_source_index_bytes();
+    }
+
+    bool get_pcss_stats(common_speculative_pcss_stats * out) const override {
+        if (!out) return false;
+        *out = metrics;
+        if (store) {
+            const auto storage = store->get_stats();
+            out->store_entries = storage.entries;
+            out->store_bytes = storage.bytes;
+            out->store_physical_bytes = storage.physical_bytes;
+            out->store_evictions = storage.evictions;
+            out->corruption_rejections = storage.corrupt_records;
+            out->incompatibility_rejections = storage.incompatibility_rejections;
+            out->store_bytes_read = storage.bytes_read;
+            out->store_bytes_written = storage.bytes_written;
+            out->lookup_probes = storage.lookup_probes;
+            out->compactions = storage.compactions;
+            out->index_ram_bytes = storage.ram_bytes;
+            out->peak_index_ram_bytes = storage.peak_ram_bytes;
+        }
+        return true;
+    }
