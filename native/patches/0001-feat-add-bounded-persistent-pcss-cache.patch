+static std::string redact_server_request_body_for_log(const std::string & body) {
+    try {
+        auto data = json::parse(body);
+        if (redact_pcss_current_source(data)) {
+            return safe_json_to_str(data);
+        }
+    } catch (const std::exception &) {
+        // A malformed source-bearing request must not fall back to raw logging.
+    }
+
+    if (body.find("pcss_current_source") != std::string::npos) {
+        return "<redacted request body containing pcss_current_source>";
+    }
+
+    return body;
+}
