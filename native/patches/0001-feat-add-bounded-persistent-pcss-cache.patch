+// Persistent PCSS provider. It is intentionally a normal speculative
+// implementation: drafts are verified by the server's target context and only
+// accepted target-visible tokens are appended after accept().
+struct common_speculative_impl_pcss_cache : public common_speculative_impl {
+    static constexpr size_t current_source_anchor_tokens = 32;
+    static constexpr size_t current_source_continuation_tokens = 2;
+    static constexpr size_t current_source_max_tokens = 16384;
+    static constexpr size_t current_source_max_collisions = 64;
+    // Source buffers are opt-in and request-scoped, but must not grow without
+    // regard to concurrent server slots. Reserve one eighth of the configured
+    // PCSS RAM budget for all current-source attachments together; the live
+    // store RAM plus those reservations must still fit the whole PCSS limit.
+    static constexpr uint64_t current_source_ram_share_divisor = 8;
+
+    struct current_source_anchor {
+        std::array<llama_token, current_source_anchor_tokens> tokens;
+
+        bool operator==(const current_source_anchor & other) const {
+            return tokens == other.tokens;
+        }
+    };
+
+    struct current_source_anchor_hash {
+        size_t operator()(const current_source_anchor & anchor) const {
+            // A fixed-size exact key avoids a string/text normalization layer:
+            // only target-vocabulary token IDs can match this tier.
+            uint64_t hash = 1469598103934665603ull;
+            for (const llama_token token : anchor.tokens) {
+                hash ^= static_cast<uint32_t>(token);
+                hash *= 1099511628211ull;
+            }
+            return static_cast<size_t>(hash);
+        }
+    };
+
+    struct current_source_continuation {
+        llama_token first;
+        llama_token second;
+
+        bool operator==(const current_source_continuation & other) const {
+            return first == other.first && second == other.second;
+        }
+    };
+
+    struct current_source_bucket {
+        std::vector<current_source_continuation> continuations;
+        // We retain this state instead of silently dropping evidence: a
+        // capped bucket can never establish that *all* occurrences agree.
+        bool capped = false;
+        // An occurrence at a source tail without two following tokens also
+        // prevents a two-token exact draft from being proven.
+        bool incomplete = false;
+    };
+
+    using current_source_index = std::unordered_map<
+        current_source_anchor,
+        current_source_bucket,
+        current_source_anchor_hash>;
+
+    struct seq_info {
+        enum source_tier {
+            SOURCE_NONE,
+            SOURCE_CURRENT_SOURCE,
+            SOURCE_CURRENT_CONTEXT,
+            SOURCE_PERSISTENT,
+            SOURCE_PERSISTENT_SHORT,
+        };
+
+        llama_tokens visible;
+        llama_tokens proposed_prefix;
+        llama_tokens proposed;
+        size_t prompt_size = 0;
+        size_t ngram_cache_size = 0;
+        common_ngram_cache ngram_cache_context;
+        bool active = false;
+        source_tier source = SOURCE_NONE;
+        uint32_t current_context_rejections = 0;
+        bool current_context_suppressed = false;
+        uint32_t short_persistent_rejections = 0;
+        bool short_persistent_suppressed = false;
+        // Kept solely in memory for the active request. It contains compact
+        // 32-token anchors and continuations, never raw source text or a
+        // pointer to caller-owned data.
+        current_source_index source_index;
+        uint64_t source_index_bytes = 0;
+        // The input is caller-owned, but reserve its bytes alongside a
+        // deterministic upper bound for its index for aggregate admission.
+        uint64_t source_input_bytes = 0;
+        uint64_t source_admission_bytes = 0;
+        bool source_attached = false;
+        // The server can report a validated incompatible source extension
+        // before there is anything to attach. Count that abstention once per
+        // active request, independently of the source-index lifecycle.
+        bool current_source_mismatch_noted = false;
+    };
+
+    std::unique_ptr<pcss::store> store;
+    std::vector<seq_info> sinfos;
+    bool disabled = false;
+    bool learning_enabled = true;
+    bool current_context_enabled = true;
+    bool current_source_enabled = false;
+    uint16_t max_draft_tokens = 2;
+    uint64_t pcss_ram_bytes = 0;
+    uint64_t current_source_admission_budget_bytes = 0;
+    common_speculative_pcss_stats metrics;
+
+    static current_source_anchor make_current_source_anchor(
+            const llama_tokens & tokens,
+            size_t begin) {
+        GGML_ASSERT(begin + current_source_anchor_tokens <= tokens.size());
+        current_source_anchor result{};
+        std::copy_n(
+            tokens.begin() + begin,
+            current_source_anchor_tokens,
+            result.tokens.begin());
+        return result;
+    }
+
+    static uint64_t current_source_index_bytes(const current_source_index & index) {
+        // The metric is a bounded in-memory accounting estimate. Account for
+        // hash buckets, map values and allocated collision-list capacity; it
+        // intentionally excludes caller-owned source input (which we never
+        // retain).
+        uint64_t result = static_cast<uint64_t>(index.bucket_count()) * sizeof(void *);
+        for (const auto & item : index) {
+            result += sizeof(item) + 2 * sizeof(void *);
+            result += static_cast<uint64_t>(item.second.continuations.capacity()) *
+                      sizeof(current_source_continuation);
+        }
+        return result;
+    }
+
+    static uint64_t current_source_input_bytes(size_t token_count) {
+        // token_count is checked against current_source_max_tokens before this
+        // helper is used, so this multiplication is bounded independently of
+        // caller-controlled request size.
+        return static_cast<uint64_t>(token_count) * sizeof(llama_token);
+    }
+
+    static uint64_t current_source_index_reservation_bytes(size_t anchor_count) {
+        // Admission reserves a deterministic upper envelope rather than
+        // trusting the current allocator capacity of unordered_map/vector.
+        // It covers an exact anchor/bucket node, its hash/list bookkeeping,
+        // a two-times bucket-pointer allowance, and the bounded collision
+        // continuation capacity. The post-build accounting check below still
+        // rejects if an implementation allocates more than this envelope.
+        const uint64_t per_anchor =
+            sizeof(std::pair<const current_source_anchor, current_source_bucket>) +
+            2 * sizeof(void *) +
+            2 * current_source_max_collisions * sizeof(current_source_continuation);
+        return static_cast<uint64_t>(anchor_count) *
+                   (per_anchor + 2 * sizeof(void *));
+    }
+
+    static bool can_add_within(uint64_t * total, uint64_t value, uint64_t limit) {
+        if (*total > limit || value > limit - *total) {
+            return false;
+        }
+        *total += value;
+        return true;
+    }
+
+    bool current_source_admission_fits(uint64_t candidate_admission_bytes) const {
+        uint64_t source_total = 0;
+        for (const auto & info : sinfos) {
+            if (!can_add_within(
+                    &source_total,
+                    info.source_admission_bytes,
+                    current_source_admission_budget_bytes)) {
+                return false;
+            }
+        }
+        if (!can_add_within(
+                &source_total,
+                candidate_admission_bytes,
+                current_source_admission_budget_bytes)) {
+            return false;
+        }
+
+        const uint64_t store_ram_bytes = store ? store->get_stats().ram_bytes : 0;
+        return can_add_within(&source_total, store_ram_bytes, pcss_ram_bytes);
+    }
+
+    static void clear_current_source(seq_info & info) {
+        current_source_index().swap(info.source_index);
+        info.source_index_bytes = 0;
+        info.source_input_bytes = 0;
+        info.source_admission_bytes = 0;
+        info.source_attached = false;
+    }
+
+    void refresh_current_source_index_bytes() {
+        uint64_t total = 0;
+        for (const auto & info : sinfos) {
+            total += info.source_index_bytes;
+        }
+        metrics.current_source_index_bytes = total;
+        metrics.current_source_peak_index_bytes = std::max(
+            metrics.current_source_peak_index_bytes,
+            total);
+    }
+
+    bool draft_current_source(
+            seq_info & info,
+            const llama_tokens & proposed_prefix,
+            pcss::match * match) {
+        if (!current_source_enabled || !info.source_attached) {
+            return false;
+        }
+
+        ++metrics.current_source_lookups;
+        if (proposed_prefix.size() < current_source_anchor_tokens) {
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+
+        const auto anchor = make_current_source_anchor(
+            proposed_prefix,
+            proposed_prefix.size() - current_source_anchor_tokens);
+        const auto found = info.source_index.find(anchor);
+        if (found == info.source_index.end()) {
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+
+        const auto & bucket = found->second;
+        // Do not use a partially indexed bucket to speculate. A source with
+        // more than the bounded collision list cannot prove all occurrences
+        // agree, even if the retained prefix happens to agree.
+        if (bucket.capped) {
+            ++metrics.current_source_ambiguities;
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+        if (bucket.incomplete || bucket.continuations.empty()) {
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+
+        const auto continuation = bucket.continuations.front();
+        for (size_t i = 1; i < bucket.continuations.size(); ++i) {
+            if (!(bucket.continuations[i] == continuation)) {
+                ++metrics.current_source_ambiguities;
+                ++metrics.current_source_abstentions;
+                return false;
+            }
+        }
+
+        match->continuation = { continuation.first, continuation.second };
+        ++metrics.current_source_hits;
+        return true;
+    }
+
+    common_speculative_impl_pcss_cache(const common_params_speculative & params, uint32_t n_seq)
+        : common_speculative_impl(COMMON_SPECULATIVE_TYPE_PCSS_CACHE, n_seq, params.pcss_cache.max_draft_tokens) {
+        metrics.policy_id = params.pcss_cache.policy_id;
+        metrics.policy_spec_sha256 = params.pcss_cache.policy_spec_sha256;
+        sinfos.resize(n_seq);
+        if (params.pcss_cache.store.empty() || params.pcss_cache.fingerprint.empty() || params.pcss_cache.name_space.empty()) {
+            disabled = true;
+            ++metrics.fallback_disable_events;
+            SPC_ERR("%s", "pcss-cache requires --pcss-store, --pcss-fingerprint, and --pcss-namespace; falling back to target decoding\n");
+            return;
+        }
+        pcss::limits limits;
+        limits.max_bytes = params.pcss_cache.max_disk_gib * 1024ull * 1024ull * 1024ull;
+        limits.max_entries = std::max<uint64_t>(1, params.pcss_cache.ram_mib * 1024ull);
+        pcss_ram_bytes = params.pcss_cache.ram_mib * 1024ull * 1024ull;
+        current_source_enabled = params.pcss_cache.enable_current_source;
+        current_source_admission_budget_bytes = current_source_enabled
+            ? pcss_ram_bytes / current_source_ram_share_divisor
+            : 0;
+        // Reserve the source share before the store opens. This prevents a
+        // later learning update in another active slot from consuming memory
+        // already admitted to current-source buffers.
+        limits.max_ram_bytes = pcss_ram_bytes - current_source_admission_budget_bytes;
+        limits.max_lookup_probes = 256;
+        limits.max_lookup_bytes = 256u * 1024u;
+        limits.read_only = params.pcss_cache.read_only;
+        learning_enabled = !params.pcss_cache.read_only && !params.pcss_cache.disable_learning;
+        current_context_enabled = !params.pcss_cache.disable_current_context;
+        max_draft_tokens = params.pcss_cache.max_draft_tokens;
+        store = std::make_unique<pcss::store>(params.pcss_cache.store,
+            pcss::identity{params.pcss_cache.name_space, params.pcss_cache.fingerprint}, limits);
+        std::string error;
+        if (!store->open(&error)) {
+            disabled = true;
+            ++metrics.fallback_disable_events;
+            SPC_ERR("pcss-cache disabled: %s\n", error.c_str());
+        }
+    }
+
+    void begin(llama_seq_id seq_id, const llama_tokens & prompt) override {
+        auto & info = sinfos[seq_id];
+        // A server slot can be reused without an explicit end after a client
+        // disconnect. Never let a source index survive that lifecycle edge.
+        clear_current_source(info);
+        refresh_current_source_index_bytes();
+        if (disabled) return;
+        info.visible = prompt;
+        info.prompt_size = prompt.size();
+        info.active = true;
+        info.proposed_prefix.clear();
+        info.proposed.clear();
+        info.ngram_cache_size = 0;
+        info.ngram_cache_context.clear();
+        info.source = seq_info::SOURCE_NONE;
+        info.current_context_rejections = 0;
+        info.current_context_suppressed = false;
+        info.short_persistent_rejections = 0;
+        info.short_persistent_suppressed = false;
+        info.current_source_mismatch_noted = false;
+    }
+
+    bool set_pcss_current_source(
+            llama_seq_id seq_id,
+            const llama_tokens & visible_source_tokens) override {
+        if (seq_id < 0 || static_cast<size_t>(seq_id) >= sinfos.size()) {
+            return false;
+        }
+
+        auto & info = sinfos[seq_id];
+        // Replacing a source is a replacement, never an accumulation. This
+        // also clears an earlier source when a caller sends an invalid update.
+        clear_current_source(info);
+        refresh_current_source_index_bytes();
+        if (disabled || !current_source_enabled || !info.active ||
+            visible_source_tokens.size() > current_source_max_tokens) {
+            return false;
+        }
+
+        // Build once at attachment time so draft() performs a single exact
+        // hash lookup rather than scanning source material. Every exact
+        // 32-token occurrence contributes its next two tokens (or marks the
+        // bucket incomplete); the collision cap fails closed.
+        const size_t anchor_count = visible_source_tokens.size() >= current_source_anchor_tokens
+            ? visible_source_tokens.size() - current_source_anchor_tokens + 1
+            : 0;
+        const uint64_t input_bytes = current_source_input_bytes(visible_source_tokens.size());
+        const uint64_t admission_bytes = input_bytes +
+            current_source_index_reservation_bytes(anchor_count);
+        if (!current_source_admission_fits(admission_bytes)) {
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+
+        current_source_index candidate;
+        try {
+            candidate.reserve(anchor_count);
+            for (size_t pos = 0; pos < anchor_count; ++pos) {
+                const auto anchor = make_current_source_anchor(visible_source_tokens, pos);
+                auto & bucket = candidate[anchor];
+                if (bucket.capped) {
+                    continue;
+                }
+                if (bucket.continuations.size() >= current_source_max_collisions) {
+                    bucket.capped = true;
+                    continue;
+                }
+                if (pos + current_source_anchor_tokens + current_source_continuation_tokens > visible_source_tokens.size()) {
+                    bucket.incomplete = true;
+                    continue;
+                }
+                bucket.continuations.push_back({
+                    visible_source_tokens[pos + current_source_anchor_tokens],
+                    visible_source_tokens[pos + current_source_anchor_tokens + 1],
+                });
+            }
+        } catch (const std::bad_alloc &) {
+            // An allocator failure is indistinguishable from a source-tier
+            // admission miss: discard partial state and continue target-only.
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+
+        const uint64_t index_bytes = current_source_index_bytes(candidate);
+        const uint64_t actual_admission_bytes = input_bytes + index_bytes;
+        if (actual_admission_bytes > admission_bytes ||
+            !current_source_admission_fits(actual_admission_bytes)) {
+            ++metrics.current_source_abstentions;
+            return false;
+        }
+        info.source_index = std::move(candidate);
+        info.source_attached = true;
+        info.source_index_bytes = index_bytes;
+        info.source_input_bytes = input_bytes;
+        info.source_admission_bytes = admission_bytes;
+        refresh_current_source_index_bytes();
+        return true;
+    }
+
+    void note_pcss_current_source_mismatch_abstention(llama_seq_id seq_id) override {
+        if (disabled || !current_source_enabled || seq_id < 0 ||
+            static_cast<size_t>(seq_id) >= sinfos.size()) {
+            return;
+        }
+        auto & info = sinfos[seq_id];
+        if (info.active && !info.current_source_mismatch_noted) {
+            ++metrics.current_source_mismatch_abstentions;
+            info.current_source_mismatch_noted = true;
+        }
+    }
