+    bool process(const llama_batch &) override { return true; }
+
+    void draft(common_speculative_draft_params_vec & dparams) override {
+        if (disabled) return;
+        for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+            auto & dp = dparams[seq_id];
+            if (!dp.drafting) continue;
+            auto & info = sinfos[seq_id];
+            info.proposed.clear();
+            info.source = seq_info::SOURCE_NONE;
+            info.proposed_prefix = *dp.prompt;
+            info.proposed_prefix.push_back(dp.id_last);
+            pcss::match match;
+            const int64_t lookup_start = ggml_time_us();
+            // Request-scoped source is an explicit, opt-in tier. It is
+            // checked before durable PCSS and in-request ngrams; a miss or
+            // ambiguity only abstains this tier and lets the existing exact
+            // fallbacks decide independently.
+            if (draft_current_source(info, info.proposed_prefix, &match)) {
+                info.source = seq_info::SOURCE_CURRENT_SOURCE;
+            } else {
+                std::string error;
+                ++metrics.lookups;
+                const bool persistent_hit = store->lookup(
+                    info.proposed_prefix,
+                    &match,
+                    &error,
+                    info.short_persistent_suppressed ? 64 : 0);
+                if (persistent_hit) {
+                    ++metrics.persistent_hits;
+                    if (match.prefix.size() <= 32) {
+                        ++metrics.persistent_32_hits;
+                        info.source = seq_info::SOURCE_PERSISTENT_SHORT;
+                    } else {
+                        ++metrics.persistent_64_hits;
+                        info.source = seq_info::SOURCE_PERSISTENT;
+                    }
+                } else {
+                    ++metrics.persistent_misses;
+                    if (!error.empty()) {
+                        disabled = true;
+                        ++metrics.fallback_disable_events;
+                        SPC_ERR("pcss-cache disabled after lookup failure: %s\n", error.c_str());
+                        metrics.lookup_us += ggml_time_us() - lookup_start;
+                        return;
+                    }
+                    if (!current_context_enabled || info.current_context_suppressed) {
+                        ++metrics.abstentions;
+                        if (info.current_context_suppressed) ++metrics.negative_evidence_suppressions;
+                        metrics.lookup_us += ggml_time_us() - lookup_start;
+                        continue;
+                    }
+                    // Use the upstream bounded ngram context tier for a miss. It
+                    // has the same target verification boundary as PCSS, avoids
+                    // the former quadratic exact-suffix scan, and never crosses a
+                    // request boundary because begin() clears this cache.
+                    const int64_t current_context_start = ggml_time_us();
+                    if (info.ngram_cache_size < info.proposed_prefix.size()) {
+                        llama_tokens new_tokens(
+                            info.proposed_prefix.begin() + info.ngram_cache_size,
+                            info.proposed_prefix.end());
+                        common_ngram_cache_update(
+                            info.ngram_cache_context,
+                            LLAMA_NGRAM_MIN,
+                            LLAMA_NGRAM_MAX,
+                            new_tokens,
+                            new_tokens.size(),
+                            false);
+                        info.ngram_cache_size = info.proposed_prefix.size();
+                    }
+                    llama_tokens ngram_draft = { dp.id_last };
+                    common_ngram_cache empty_dynamic;
+                    common_ngram_cache empty_static;
+                    common_ngram_cache_draft(
+                        info.proposed_prefix,
+                        ngram_draft,
+                        max_draft_tokens,
+                        LLAMA_NGRAM_MIN,
+                        LLAMA_NGRAM_MAX,
+                        info.ngram_cache_context,
+                        empty_dynamic,
+                        empty_static);
+                    if (!ngram_draft.empty()) ngram_draft.erase(ngram_draft.begin());
+                    metrics.current_context_lookup_us += ggml_time_us() - current_context_start;
+                    if (ngram_draft.empty()) {
+                        ++metrics.abstentions;
+                        metrics.lookup_us += ggml_time_us() - lookup_start;
+                        continue;
+                    }
+                    ++metrics.current_context_hits;
+                    info.source = seq_info::SOURCE_CURRENT_CONTEXT;
+                    match.continuation = std::move(ngram_draft);
