diff --git a/tools/pcss-store-tool.cpp b/tools/pcss-store-tool.cpp
new file mode 100644
index 000000000..1af25e1fb
--- /dev/null
+++ b/tools/pcss-store-tool.cpp
@@ -0,0 +1,99 @@
+#include "pcss-store.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdlib>
+#include <iostream>
+#include <limits>
+#include <string>
+#include <utility>
+
+namespace {
+
+bool parse_size(const char * text, size_t * value) {
+    if (!text || !*text || !value) return false;
+    errno = 0;
+    char * end = nullptr;
+    const unsigned long long parsed = std::strtoull(text, &end, 10);
+    if (errno != 0 || !end || *end != '\0' || parsed > std::numeric_limits<size_t>::max()) return false;
+    *value = static_cast<size_t>(parsed);
+    return true;
+}
+
+void usage(const char * program) {
+    std::cerr << "usage: " << program
+              << " inspect|compact --store PATH --namespace NAME --fingerprint VALUE"
+                 " [--max-disk-gib N] [--ram-mib N]\n";
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        usage(argv[0]);
+        return 2;
+    }
+
+    const std::string operation = argv[1];
+    std::string directory;
+    pcss::identity identity;
+    size_t max_disk_gib = 200;
+    size_t ram_mib = 256;
+    for (int i = 2; i < argc; ++i) {
+        const std::string arg = argv[i];
+        if (i + 1 >= argc) {
+            usage(argv[0]);
+            return 2;
+        }
+        const char * value = argv[++i];
+        if (arg == "--store") directory = value;
+        else if (arg == "--namespace") identity.name_space = value;
+        else if (arg == "--fingerprint") identity.fingerprint = value;
+        else if (arg == "--max-disk-gib") {
+            if (!parse_size(value, &max_disk_gib) || max_disk_gib == 0) return 2;
+        } else if (arg == "--ram-mib") {
+            if (!parse_size(value, &ram_mib) || ram_mib == 0) return 2;
+        } else {
+            usage(argv[0]);
+            return 2;
+        }
+    }
+    if ((operation != "inspect" && operation != "compact") || directory.empty() ||
+            identity.name_space.empty() || identity.fingerprint.empty()) {
+        usage(argv[0]);
+        return 2;
+    }
+
+    pcss::limits limits;
+    limits.max_bytes = max_disk_gib * 1024ull * 1024ull * 1024ull;
+    limits.max_entries = std::max<size_t>(1, ram_mib * 1024ull);
+    limits.max_ram_bytes = ram_mib * 1024ull * 1024ull;
+    limits.max_lookup_probes = 256;
+    limits.max_lookup_bytes = 256u * 1024u;
+    limits.read_only = operation == "inspect";
+
+    pcss::store store(directory, std::move(identity), limits);
+    std::string error;
+    if (!store.open(&error)) {
+        std::cerr << error << "\n";
+        return 3;
+    }
+    if (operation == "compact" && !store.compact(&error)) {
+        std::cerr << error << "\n";
+        return 4;
+    }
+
+    const auto stats = store.get_stats();
+    std::cout << "{\"entries\":" << stats.entries
+              << ",\"store_bytes\":" << stats.bytes
+              << ",\"physical_bytes\":" << stats.physical_bytes
+              << ",\"index_ram_bytes\":" << stats.ram_bytes
+              << ",\"bytes_read\":" << stats.bytes_read
+              << ",\"bytes_written\":" << stats.bytes_written
+              << ",\"evictions\":" << stats.evictions
+              << ",\"compactions\":" << stats.compactions
+              << ",\"corrupt_records\":" << stats.corrupt_records
+              << ",\"incompatibility_rejections\":" << stats.incompatibility_rejections
+              << "}\n";
+    return 0;
+}
