+            const std::list<common_prompt_checkpoint> & checkpoints,
+            const std::vector<uint8_t> & main,
+            const std::vector<uint8_t> & drft,
+            std::string * error = nullptr);
+    bool load_best(
+            const llama_tokens & tokens,
+            int lcp_base,
+            float keep_base,
+            float similarity_base,
+            server_prompt_cache_disk_value * value,
+            std::string * error = nullptr);
+    bool can_append_without_compaction(size_t record_bytes, size_t token_count, size_t entry_count) const;
+    server_prompt_cache_disk_stats stats() const;
+
+private:
+    struct entry {
+        uint64_t offset = 0;
+        uint64_t bytes = 0;
+        uint64_t ordinal = 0;
+        uint64_t main_bytes = 0;
+        uint64_t drft_bytes = 0;
+        llama_tokens tokens;
+        bool live = true;
+    };
+
+    std::string directory_;
+    std::string records_path_;
+    std::string manifest_path_;
+    size_t limit_bytes_;
+    size_t metadata_limit_bytes_;
+    uint64_t committed_bytes_ = 0;
+    uint64_t committed_records_ = 0;
+    uint64_t clock_ = 0;
+    std::vector<entry> entries_;
+    server_prompt_cache_disk_stats stats_;
+    bool open_ = false;
+
+    bool scan(std::string * error);
+    bool load_entry(const entry & item, server_prompt_cache_disk_value * value, std::string * error);
+    bool compact(std::string * error);
+    bool enforce_limits(uint64_t incoming_bytes, size_t incoming_metadata, std::string * error);
+    void update_stats();
+};
