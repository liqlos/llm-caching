+void test_current_source_rejections_and_mismatch_notifier_are_scoped() {
+    temporary_directory directory("current-source-rejection-notifier");
+    auto params = current_source_params(directory);
+    common_speculative_ptr spec(common_speculative_init(params, 1));
+    assert(spec);
+
+    const auto anchor = current_source_anchor();
+    const tokens before_last(anchor.begin(), anchor.end() - 1);
+    tokens source = anchor;
+    source.insert(source.end(), { 27000, 27001 });
+    tokens draft;
+    common_speculative_pcss_stats stats;
+
+    // No lifecycle has begun, so the slot cannot contribute telemetry.
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_mismatch_abstentions == 0);
+
+    // A fingerprint mismatch deliberately never attaches incompatible source
+    // tokens, but it is still one observable abstention for the active PCSS
+    // request. Duplicate notifications within that request are idempotent.
+    common_speculative_begin(spec.get(), 0, before_last);
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_mismatch_abstentions == 1);
+
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, source));
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    configure_current_source_draft(spec.get(), before_last, anchor.back(), &draft);
+    common_speculative_draft(spec.get());
+    assert(draft == tokens({ 27000, 27001 }));
+    common_speculative_accept(spec.get(), 0, 0);
+
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_rejections == 1);
+    assert(stats.current_source_accepted_tokens == 0);
+    assert(stats.current_source_mismatch_abstentions == 1);
+
+    common_speculative_end(spec.get(), 0, false);
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_mismatch_abstentions == 1);
+
+    // Reusing a slot begins a distinct request. It may report one new
+    // mismatch, while a second call after that request ends remains ignored.
+    common_speculative_begin(spec.get(), 0, before_last);
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_mismatch_abstentions == 2);
+    common_speculative_end(spec.get(), 0, false);
+    common_speculative_note_pcss_current_source_mismatch_abstention(spec.get(), 0);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_mismatch_abstentions == 2);
+}
