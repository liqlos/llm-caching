+    struct entry;
+    struct index_item;
+    std::string directory_;
+    std::string active_records_path_;
+    std::string active_index_path_;
+    identity id_;
+    limits limits_;
+    std::vector<entry> entries_;
+    std::vector<index_item> index_;
+    std::vector<uint32_t> prefix_lengths_;
+    stats stats_;
+    uint64_t clock_ = 0;
+    uint64_t committed_bytes_ = 0;
+    uint64_t manifest_bytes_ = 0;
+    uint64_t physical_bytes_ = 0;
+    uint64_t index_bytes_ = 0;
+    uint64_t index_committed_bytes_ = 0;
+    uint64_t index_manifest_bytes_ = 0;
+    size_t index_entry_count_ = 0;
+    int lock_fd_ = -1;
+    bool open_ = false;
+    bool dirty_compaction_ = false;
+
+    bool load(std::string * error);
+    bool load_index(uint64_t committed, uint64_t manifest_bytes, bool * loaded, std::string * error);
+    std::vector<uint8_t> serialize_index(uint64_t committed, uint64_t manifest_bytes) const;
+    bool publish_index(std::string * error);
+    bool append_batch(const std::vector<match> & values,
