diff --git a/tools/server/server-prompt-cache-store.cpp b/tools/server/server-prompt-cache-store.cpp
new file mode 100644
index 000000000..389d1cc1a
--- /dev/null
+++ b/tools/server/server-prompt-cache-store.cpp
@@ -0,0 +1,643 @@
+#include "server-prompt-cache-store.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <type_traits>
+
+#if !defined(_WIN32)
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+constexpr uint32_t record_magic = 0x3150434cu;
+constexpr uint32_t manifest_magic = 0x314d434cu;
+constexpr uint32_t format_version = 1;
+constexpr size_t record_header_bytes = 48;
+constexpr size_t manifest_row_bytes = 32;
+constexpr uint64_t hash_offset = 1469598103934665603ull;
+constexpr uint64_t hash_prime = 1099511628211ull;
+
+uint64_t hash_bytes(const uint8_t * data, size_t size) {
+    uint64_t result = hash_offset;
+    for (size_t i = 0; i < size; ++i) {
+        result ^= data[i];
+        result *= hash_prime;
+    }
+    return result;
+}
+
+template<typename T>
+void append_scalar(std::vector<uint8_t> & out, T value) {
+    using U = typename std::make_unsigned<T>::type;
+    U current = static_cast<U>(value);
+    for (size_t i = 0; i < sizeof(T); ++i) {
+        out.push_back(static_cast<uint8_t>(current & 0xffu));
+        current >>= 8;
+    }
+}
+
+template<typename T>
+bool read_scalar(const uint8_t * data, size_t size, size_t * position, T * value) {
+    using U = typename std::make_unsigned<T>::type;
+    if (*position > size || size - *position < sizeof(T)) {
+        return false;
+    }
+    U result = 0;
+    for (size_t i = 0; i < sizeof(T); ++i) {
+        result |= static_cast<U>(data[*position + i]) << (8 * i);
+    }
+    *position += sizeof(T);
+    *value = static_cast<T>(result);
+    return true;
+}
+
+bool durable_append(const std::string & path, const std::vector<uint8_t> & bytes, std::string * error) {
+#if defined(_WIN32)
+    std::ofstream file(path, std::ios::binary | std::ios::app);
+    file.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    file.flush();
+    if (!file) {
+        if (error) *error = "cannot append prompt cache file";
+        return false;
+    }
+    return true;
+#else
+    const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0600);
+    if (fd < 0) {
+        if (error) *error = "cannot open prompt cache file: " + std::string(std::strerror(errno));
+        return false;
+    }
+    size_t position = 0;
+    while (position < bytes.size()) {
+        const ssize_t count = ::write(fd, bytes.data() + position, bytes.size() - position);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) {
+            if (error) *error = "cannot append prompt cache file: " + std::string(std::strerror(errno));
+            ::close(fd);
+            return false;
+        }
+        position += static_cast<size_t>(count);
+    }
+    const bool synced = ::fsync(fd) == 0;
+    const bool closed = ::close(fd) == 0;
+    const bool ok = synced && closed;
+    if (!ok && error) *error = "cannot sync prompt cache file";
+    return ok;
+#endif
+}
+
+bool durable_replace(const std::string & path, const std::vector<uint8_t> & bytes, std::string * error) {
+    const std::string temporary = path + ".tmp";
+#if defined(_WIN32)
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    file.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    file.flush();
+    file.close();
+#else
+    const int fd = ::open(temporary.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) {
+        if (error) *error = "cannot create prompt cache temporary file";
+        return false;
+    }
+    size_t position = 0;
+    while (position < bytes.size()) {
+        const ssize_t count = ::write(fd, bytes.data() + position, bytes.size() - position);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) {
+            ::close(fd);
+            return false;
+        }
+        position += static_cast<size_t>(count);
+    }
+    if (::fsync(fd) != 0 || ::close(fd) != 0) {
+        if (error) *error = "cannot sync prompt cache temporary file";
+        return false;
+    }
+#endif
+    std::error_code ec;
+    std::filesystem::rename(temporary, path, ec);
+    if (ec) {
+        std::filesystem::remove(path, ec);
+        ec.clear();
+        std::filesystem::rename(temporary, path, ec);
+    }
+    if (ec) {
+        if (error) *error = "cannot publish prompt cache file";
+        return false;
+    }
+    return true;
+}
+
+bool rename_replace(const std::string & source, const std::string & target) {
+    std::error_code ec;
+    std::filesystem::remove(target, ec);
+    ec.clear();
+    std::filesystem::rename(source, target, ec);
+    return !ec;
+}
+
+bool sync_directory(const std::string & path) {
+#if defined(_WIN32)
+    (void) path;
+    return true;
+#else
+    const int fd = ::open(path.c_str(), O_RDONLY);
+    if (fd < 0) return false;
+    const bool result = (::fsync(fd) == 0 || errno == EINVAL || errno == ENOTSUP) && ::close(fd) == 0;
+    return result;
+#endif
+}
+
+std::vector<uint8_t> manifest_row(uint64_t committed_bytes, uint64_t committed_records) {
+    std::vector<uint8_t> row;
+    append_scalar<uint32_t>(row, manifest_magic);
+    append_scalar<uint32_t>(row, format_version);
+    append_scalar<uint64_t>(row, committed_bytes);
+    append_scalar<uint64_t>(row, committed_records);
+    append_scalar<uint64_t>(row, hash_bytes(row.data(), row.size()));
+    return row;
+}
+
+size_t common_prefix(const llama_tokens & left, const llama_tokens & right) {
+    const size_t limit = std::min(left.size(), right.size());
+    size_t result = 0;
+    while (result < limit && left[result] == right[result]) ++result;
+    return result;
+}
+
+}
+
+server_prompt_cache_store::server_prompt_cache_store(std::string directory, size_t limit_bytes, size_t metadata_limit_bytes)
+    : directory_(std::move(directory)),
+      records_path_((std::filesystem::path(directory_) / "prompt-records.bin").string()),
+      manifest_path_((std::filesystem::path(directory_) / "prompt-manifest.bin").string()),
+      limit_bytes_(limit_bytes),
+      metadata_limit_bytes_(metadata_limit_bytes) {
+}
+
+bool server_prompt_cache_store::open(std::string * error) {
+    std::error_code ec;
+    std::filesystem::create_directories(directory_, ec);
+    if (ec) {
+        if (error) *error = "cannot create prompt cache directory";
+        return false;
+    }
+#if !defined(_WIN32)
+    if (::chmod(directory_.c_str(), 0700) != 0) {
+        if (error) *error = "cannot secure prompt cache directory";
+        return false;
+    }
+#endif
+    const std::string previous_records = records_path_ + ".prev";
+    const std::string previous_manifest = manifest_path_ + ".prev";
+    const bool previous_complete = std::filesystem::exists(previous_records, ec) && std::filesystem::exists(previous_manifest, ec);
+    const bool active_incomplete = !std::filesystem::exists(records_path_, ec) || !std::filesystem::exists(manifest_path_, ec);
+    if (active_incomplete && previous_complete) {
+        if (!rename_replace(previous_records, records_path_) || !rename_replace(previous_manifest, manifest_path_)) {
+            if (error) *error = "cannot recover previous prompt cache generation";
+            return false;
+        }
+    }
+    std::ifstream manifest(manifest_path_, std::ios::binary);
+    std::array<uint8_t, manifest_row_bytes> row{};
+    uint64_t valid_manifest_bytes = 0;
+    while (manifest.read(reinterpret_cast<char *>(row.data()), row.size())) {
+        size_t position = 0;
+        uint32_t magic = 0;
+        uint32_t version = 0;
+        uint64_t bytes = 0;
+        uint64_t records = 0;
+        uint64_t checksum = 0;
+        if (!read_scalar(row.data(), row.size(), &position, &magic) ||
+                !read_scalar(row.data(), row.size(), &position, &version) ||
+                !read_scalar(row.data(), row.size(), &position, &bytes) ||
+                !read_scalar(row.data(), row.size(), &position, &records) ||
+                !read_scalar(row.data(), row.size(), &position, &checksum) ||
+                magic != manifest_magic || version != format_version || checksum != hash_bytes(row.data(), 24)) {
+            break;
+        }
+        committed_bytes_ = bytes;
+        committed_records_ = records;
+        valid_manifest_bytes += manifest_row_bytes;
+    }
+    manifest.close();
+    if (std::filesystem::exists(manifest_path_, ec) && std::filesystem::file_size(manifest_path_, ec) > valid_manifest_bytes) {
+        std::filesystem::resize_file(manifest_path_, valid_manifest_bytes, ec);
+        if (ec) {
+            if (error) *error = "cannot truncate uncommitted prompt cache manifest tail";
+            return false;
+        }
+    }
+    if (std::filesystem::exists(records_path_, ec)) {
+        const uint64_t physical_records = std::filesystem::file_size(records_path_, ec);
+        if (ec || physical_records < committed_bytes_) {
+            if (error) *error = "prompt cache records are shorter than the committed manifest";
+            return false;
+        }
+        if (physical_records > committed_bytes_) {
+            std::filesystem::resize_file(records_path_, committed_bytes_, ec);
+            if (ec) {
+                if (error) *error = "cannot truncate uncommitted prompt cache record tail";
+                return false;
+            }
+        }
+    }
+    open_ = scan(error);
+    if (!open_ && std::filesystem::exists(previous_records, ec) && std::filesystem::exists(previous_manifest, ec)) {
+        if (!rename_replace(previous_records, records_path_) || !rename_replace(previous_manifest, manifest_path_)) {
+            return false;
+        }
+        committed_bytes_ = 0;
+        committed_records_ = 0;
+        entries_.clear();
+        return open(error);
+    }
+    if (open_) {
+        std::filesystem::remove(previous_records, ec);
+        std::filesystem::remove(previous_manifest, ec);
+        std::filesystem::remove(records_path_ + ".compact", ec);
+        std::filesystem::remove(manifest_path_ + ".compact", ec);
+    }
+    return open_;
+}
+
+bool server_prompt_cache_store::scan(std::string * error) {
+    entries_.clear();
+    stats_.metadata_bytes = 0;
+    if (committed_bytes_ == 0) {
+        update_stats();
+        return true;
+    }
+    std::ifstream file(records_path_, std::ios::binary);
+    if (!file) {
+        if (error) *error = "committed prompt cache records are missing";
+        return false;
+    }
+    uint64_t offset = 0;
+    uint64_t ordinal = 0;
+    while (offset < committed_bytes_) {
+        std::array<uint8_t, record_header_bytes> header{};
+        file.seekg(static_cast<std::streamoff>(offset));
+        file.read(reinterpret_cast<char *>(header.data()), header.size());
+        size_t position = 0;
+        uint32_t magic = 0;
+        uint32_t version = 0;
+        uint64_t payload_bytes = 0;
+        uint64_t checksum = 0;
+        uint32_t token_count = 0;
+        uint32_t checkpoint_count = 0;
+        uint64_t main_bytes = 0;
+        uint64_t drft_bytes = 0;
+        if (!file ||
+                !read_scalar(header.data(), header.size(), &position, &magic) ||
+                !read_scalar(header.data(), header.size(), &position, &version) ||
+                !read_scalar(header.data(), header.size(), &position, &payload_bytes) ||
+                !read_scalar(header.data(), header.size(), &position, &checksum) ||
+                !read_scalar(header.data(), header.size(), &position, &token_count) ||
+                !read_scalar(header.data(), header.size(), &position, &checkpoint_count) ||
+                !read_scalar(header.data(), header.size(), &position, &main_bytes) ||
+                !read_scalar(header.data(), header.size(), &position, &drft_bytes) ||
+                magic != record_magic || version != format_version ||
+                payload_bytes > committed_bytes_ - offset - record_header_bytes ||
+                token_count > payload_bytes / sizeof(llama_token)) {
+            if (error) *error = "committed prompt cache record header is corrupt";
+            return false;
+        }
+        if (token_count > (metadata_limit_bytes_ - std::min(metadata_limit_bytes_, stats_.metadata_bytes + sizeof(entry))) / sizeof(llama_token)) {
+            if (error) *error = "prompt cache token metadata exceeds the startup RAM limit";
+            return false;
+        }
+        llama_tokens tokens(token_count);
+        file.read(reinterpret_cast<char *>(tokens.data()), static_cast<std::streamsize>(tokens.size() * sizeof(llama_token)));
+        if (!file) {
+            if (error) *error = "committed prompt cache token metadata is corrupt";
+            return false;
+        }
+        const size_t metadata = sizeof(entry) + tokens.size() * sizeof(llama_token);
+        if (stats_.metadata_bytes + metadata > metadata_limit_bytes_) {
+            if (error) *error = "prompt cache metadata limit exceeded at startup";
+            return false;
+        }
+        entry item;
+        item.offset = offset;
+        item.bytes = record_header_bytes + payload_bytes;
+        item.ordinal = ++ordinal;
+        item.main_bytes = main_bytes;
+        item.drft_bytes = drft_bytes;
+        item.tokens = std::move(tokens);
+        entries_.push_back(std::move(item));
+        stats_.metadata_bytes += metadata;
+        offset += record_header_bytes + payload_bytes;
+    }
+    if (offset != committed_bytes_ || entries_.size() != committed_records_) {
+        if (error) *error = "prompt cache manifest does not match records";
+        return false;
+    }
+    clock_ = ordinal;
+    update_stats();
+    return true;
+}
+
+bool server_prompt_cache_store::put(
+        const llama_tokens & tokens,
+        const std::list<common_prompt_checkpoint> & checkpoints,
+        const std::vector<uint8_t> & main,
+        const std::vector<uint8_t> & drft,
+        std::string * error) {
+    if (!open_ || tokens.empty() || main.empty()) return false;
+    for (auto & item : entries_) {
+        if (item.live && item.tokens == tokens) {
+            item.ordinal = ++clock_;
+            return true;
+        }
+    }
+    std::vector<uint8_t> payload;
+    payload.reserve(tokens.size() * sizeof(llama_token) + main.size() + drft.size());
+    payload.insert(payload.end(), reinterpret_cast<const uint8_t *>(tokens.data()), reinterpret_cast<const uint8_t *>(tokens.data()) + tokens.size() * sizeof(llama_token));
+    for (const auto & checkpoint : checkpoints) {
+        append_scalar<int64_t>(payload, checkpoint.n_tokens);
+        append_scalar<int32_t>(payload, checkpoint.id_task);
+        append_scalar<int32_t>(payload, checkpoint.pos_min);
+        append_scalar<int32_t>(payload, checkpoint.pos_max);
+        append_scalar<uint32_t>(payload, 0);
+        append_scalar<uint64_t>(payload, checkpoint.data_tgt.size());
+        append_scalar<uint64_t>(payload, checkpoint.data_dft.size());
+        append_scalar<uint64_t>(payload, checkpoint.data_spec.size());
+        payload.insert(payload.end(), checkpoint.data_tgt.begin(), checkpoint.data_tgt.end());
+        payload.insert(payload.end(), checkpoint.data_dft.begin(), checkpoint.data_dft.end());
+        payload.insert(payload.end(), checkpoint.data_spec.begin(), checkpoint.data_spec.end());
+    }
+    payload.insert(payload.end(), main.begin(), main.end());
+    payload.insert(payload.end(), drft.begin(), drft.end());
+    std::vector<uint8_t> record;
+    append_scalar<uint32_t>(record, record_magic);
+    append_scalar<uint32_t>(record, format_version);
+    append_scalar<uint64_t>(record, payload.size());
+    append_scalar<uint64_t>(record, hash_bytes(payload.data(), payload.size()));
+    append_scalar<uint32_t>(record, tokens.size());
+    append_scalar<uint32_t>(record, checkpoints.size());
+    append_scalar<uint64_t>(record, main.size());
+    append_scalar<uint64_t>(record, drft.size());
+    record.insert(record.end(), payload.begin(), payload.end());
+    const size_t metadata = sizeof(entry) + tokens.size() * sizeof(llama_token);
+    if (!enforce_limits(record.size(), metadata, error)) return false;
+    if (!durable_append(records_path_, record, error)) return false;
+    const uint64_t next_bytes = committed_bytes_ + record.size();
+    const uint64_t next_records = committed_records_ + 1;
+    const auto commit = manifest_row(next_bytes, next_records);
+    if (!durable_append(manifest_path_, commit, error)) {
+        open_ = false;
+        return false;
+    }
+    entry item;
+    item.offset = committed_bytes_;
+    item.bytes = record.size();
+    item.ordinal = ++clock_;
+    item.main_bytes = main.size();
+    item.drft_bytes = drft.size();
+    item.tokens = tokens;
+    entries_.push_back(std::move(item));
+    committed_bytes_ = next_bytes;
+    committed_records_ = next_records;
+    stats_.puts++;
+    stats_.bytes_written += record.size() + commit.size();
+    update_stats();
+    return true;
+}
+
+bool server_prompt_cache_store::load_entry(const entry & item, server_prompt_cache_disk_value * value, std::string * error) {
+    std::ifstream file(records_path_, std::ios::binary);
+    file.seekg(static_cast<std::streamoff>(item.offset));
+    std::vector<uint8_t> bytes(item.bytes);
+    file.read(reinterpret_cast<char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    if (!file) return false;
+    size_t position = 0;
+    uint32_t magic = 0;
+    uint32_t version = 0;
+    uint64_t payload_bytes = 0;
+    uint64_t checksum = 0;
+    uint32_t token_count = 0;
+    uint32_t checkpoint_count = 0;
+    uint64_t main_bytes = 0;
+    uint64_t drft_bytes = 0;
+    if (!read_scalar(bytes.data(), bytes.size(), &position, &magic) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &version) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &payload_bytes) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &checksum) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &token_count) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &checkpoint_count) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &main_bytes) ||
+            !read_scalar(bytes.data(), bytes.size(), &position, &drft_bytes) ||
+            magic != record_magic || version != format_version || position + payload_bytes != bytes.size() ||
+            checksum != hash_bytes(bytes.data() + position, payload_bytes) || token_count != item.tokens.size()) {
+        stats_.corrupt_records++;
+        if (error) *error = "prompt cache record checksum failed";
+        return false;
+    }
+    value->tokens.resize(token_count);
+    std::memcpy(value->tokens.data(), bytes.data() + position, token_count * sizeof(llama_token));
+    position += token_count * sizeof(llama_token);
+    value->checkpoints.clear();
+    for (uint32_t index = 0; index < checkpoint_count; ++index) {
+        common_prompt_checkpoint checkpoint;
+        uint32_t reserved = 0;
+        uint64_t target_bytes = 0;
+        uint64_t draft_bytes = 0;
+        uint64_t spec_bytes = 0;
+        if (!read_scalar(bytes.data(), bytes.size(), &position, &checkpoint.n_tokens) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &checkpoint.id_task) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &checkpoint.pos_min) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &checkpoint.pos_max) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &reserved) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &target_bytes) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &draft_bytes) ||
+                !read_scalar(bytes.data(), bytes.size(), &position, &spec_bytes) ||
+                target_bytes > bytes.size() - position) return false;
+        checkpoint.data_tgt.assign(bytes.begin() + position, bytes.begin() + position + target_bytes);
+        position += target_bytes;
+        if (draft_bytes > bytes.size() - position) return false;
+        checkpoint.data_dft.assign(bytes.begin() + position, bytes.begin() + position + draft_bytes);
+        position += draft_bytes;
+        if (spec_bytes > bytes.size() - position) return false;
+        checkpoint.data_spec.assign(bytes.begin() + position, bytes.begin() + position + spec_bytes);
+        position += spec_bytes;
+        value->checkpoints.push_back(std::move(checkpoint));
+    }
+    if (main_bytes > bytes.size() - position) return false;
+    value->main.assign(bytes.begin() + position, bytes.begin() + position + main_bytes);
+    position += main_bytes;
+    if (drft_bytes > bytes.size() - position) return false;
+    value->drft.assign(bytes.begin() + position, bytes.begin() + position + drft_bytes);
+    position += drft_bytes;
+    if (position != bytes.size()) return false;
+    stats_.bytes_read += bytes.size();
+    return true;
+}
+
+bool server_prompt_cache_store::load_best(
+        const llama_tokens & tokens,
+        int lcp_base,
+        float keep_base,
+        float similarity_base,
+        server_prompt_cache_disk_value * value,
+        std::string * error) {
+    if (!open_) return false;
+    const entry * best = nullptr;
+    int best_lcp = lcp_base;
+    for (auto & item : entries_) {
+        if (!item.live) continue;
+        const int lcp = static_cast<int>(common_prefix(item.tokens, tokens));
+        const float keep = item.tokens.empty() ? 0.0f : float(lcp) / item.tokens.size();
+        const float similarity = tokens.empty() ? 0.0f : float(lcp) / tokens.size();
+        if (keep < 0.25f) continue;
+        if (keep_base < keep && similarity_base < similarity) {
+            keep_base = keep;
+            similarity_base = similarity;
+            lcp_base = lcp;
+            best_lcp = lcp;
+            best = &item;
+        }
+    }
+    if (!best || lcp_base <= 0) {
+        stats_.misses++;
+        return false;
+    }
+    if (!load_entry(*best, value, error) || value->tokens != best->tokens) {
+        stats_.misses++;
+        return false;
+    }
+    const common_prompt_checkpoint * checkpoint_best = nullptr;
+    for (const auto & checkpoint : value->checkpoints) {
+        if (checkpoint.n_tokens > 0 && checkpoint.n_tokens <= best_lcp && !checkpoint.data_tgt.empty() &&
+                (!checkpoint_best || checkpoint_best->n_tokens < checkpoint.n_tokens)) {
+            checkpoint_best = &checkpoint;
+        }
+    }
+    if (checkpoint_best && static_cast<size_t>(best_lcp) < value->tokens.size()) {
+        value->main = checkpoint_best->data_tgt;
+        value->drft = checkpoint_best->data_dft;
+        value->tokens.resize(static_cast<size_t>(checkpoint_best->n_tokens));
+        value->checkpoints.remove_if([&](const common_prompt_checkpoint & checkpoint) {
+            return checkpoint.n_tokens > checkpoint_best->n_tokens;
+        });
+    }
+    const_cast<entry *>(best)->ordinal = ++clock_;
+    stats_.hits++;
+    return true;
+}
+
+bool server_prompt_cache_store::enforce_limits(uint64_t incoming_bytes, size_t incoming_metadata, std::string * error) {
+    if (incoming_bytes > limit_bytes_ || incoming_metadata > metadata_limit_bytes_) return false;
+    std::vector<bool> live_before;
+    live_before.reserve(entries_.size());
+    for (const auto & item : entries_) live_before.push_back(item.live);
+    const uint64_t evictions_before = stats_.evictions;
+    bool changed = false;
+    while (stats_.logical_bytes + incoming_bytes > limit_bytes_ || stats_.metadata_bytes + incoming_metadata > metadata_limit_bytes_) {
+        auto oldest = std::min_element(entries_.begin(), entries_.end(), [](const entry & left, const entry & right) {
+            if (left.live != right.live) return left.live > right.live;
+            return left.ordinal < right.ordinal;
+        });
+        if (oldest == entries_.end() || !oldest->live) return false;
+        oldest->live = false;
+        stats_.evictions++;
+        changed = true;
+        update_stats();
+    }
+    if (changed && !compact(error)) {
+        for (size_t index = 0; index < entries_.size(); ++index) entries_[index].live = live_before[index];
+        stats_.evictions = evictions_before;
+        update_stats();
+        return false;
+    }
+    return stats_.logical_bytes + incoming_bytes <= limit_bytes_ && stats_.metadata_bytes + incoming_metadata <= metadata_limit_bytes_;
+}
+
+bool server_prompt_cache_store::compact(std::string * error) {
+    std::ifstream source(records_path_, std::ios::binary);
+    const std::string temporary = records_path_ + ".compact";
+    std::ofstream target(temporary, std::ios::binary | std::ios::trunc);
+    if (!source || !target) return false;
+    std::vector<entry> live;
+    uint64_t offset = 0;
+    std::array<char, 1024 * 1024> buffer{};
+    for (const auto & item : entries_) {
+        if (!item.live) continue;
+        source.seekg(static_cast<std::streamoff>(item.offset));
+        uint64_t remaining = item.bytes;
+        while (remaining > 0) {
+            const size_t count = static_cast<size_t>(std::min<uint64_t>(remaining, buffer.size()));
+            source.read(buffer.data(), static_cast<std::streamsize>(count));
+            target.write(buffer.data(), static_cast<std::streamsize>(count));
+            if (!source || !target) return false;
+            remaining -= count;
+        }
+        entry copy = item;
+        copy.offset = offset;
+        offset += copy.bytes;
+        live.push_back(std::move(copy));
+    }
+    target.flush();
+    target.close();
+#if !defined(_WIN32)
+    const int fd = ::open(temporary.c_str(), O_RDONLY);
+    if (fd < 0 || ::fsync(fd) != 0 || ::close(fd) != 0) return false;
+#endif
+    const auto manifest = manifest_row(offset, live.size());
+    const std::string compact_manifest = manifest_path_ + ".compact";
+    if (!durable_replace(compact_manifest, manifest, error)) return false;
+    const std::string previous_records = records_path_ + ".prev";
+    const std::string previous_manifest = manifest_path_ + ".prev";
+    std::error_code ec;
+    std::filesystem::remove(previous_records, ec);
+    std::filesystem::remove(previous_manifest, ec);
+    if (std::filesystem::exists(records_path_, ec) && !rename_replace(records_path_, previous_records)) return false;
+    if (std::filesystem::exists(manifest_path_, ec) && !rename_replace(manifest_path_, previous_manifest)) return false;
+    if (!rename_replace(temporary, records_path_) || !rename_replace(compact_manifest, manifest_path_) || !sync_directory(directory_)) {
+        rename_replace(previous_records, records_path_);
+        rename_replace(previous_manifest, manifest_path_);
+        return false;
+    }
+    entries_ = std::move(live);
+    committed_bytes_ = offset;
+    committed_records_ = entries_.size();
+    stats_.compactions++;
+    stats_.bytes_written += offset + manifest.size();
+    update_stats();
+    std::filesystem::remove(previous_records, ec);
+    std::filesystem::remove(previous_manifest, ec);
+    return true;
+}
+
+void server_prompt_cache_store::update_stats() {
+    size_t metadata = 0;
+    size_t logical = 0;
+    size_t count = 0;
+    for (const auto & item : entries_) {
+        if (!item.live) continue;
+        metadata += sizeof(entry) + item.tokens.size() * sizeof(llama_token);
+        logical += item.bytes;
+        count++;
+    }
+    stats_.entries = count;
+    stats_.logical_bytes = logical;
+    stats_.physical_bytes = committed_bytes_ + committed_records_ * manifest_row_bytes;
+    stats_.metadata_bytes = metadata;
+}
+
+server_prompt_cache_disk_stats server_prompt_cache_store::stats() const {
+    return stats_;
+}
+
+bool server_prompt_cache_store::can_append_without_compaction(size_t record_bytes, size_t token_count, size_t entry_count) const {
+    const size_t metadata = entry_count * sizeof(entry) + token_count * sizeof(llama_token);
+    return stats_.logical_bytes + record_bytes <= limit_bytes_ && stats_.metadata_bytes + metadata <= metadata_limit_bytes_;
+}
