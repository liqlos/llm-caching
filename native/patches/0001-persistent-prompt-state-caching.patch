+// Persistent speculative-cache storage.  This is intentionally independent of
+// the server: callers decide when a verified target sequence is eligible to be
+// recorded.
+#pragma once
+
+#include "llama.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace pcss {
+
+struct identity {
+    std::string name_space;
+    std::string fingerprint;
+};
+
+struct limits {
+    size_t max_entries = 4096;
+    size_t max_bytes   = 64u * 1024u * 1024u;
+    size_t max_ram_bytes = 4u * 1024u * 1024u;
+    size_t max_lookup_probes = 8192;
+    size_t max_lookup_bytes = 16u * 1024u * 1024u;
+    size_t max_startup_bytes = 128u * 1024u * 1024u;
+    size_t max_startup_records = 1000000;
+    bool read_only     = false;
+};
+
+struct stats {
+    uint64_t puts = 0;
+    uint64_t hits = 0;
+    uint64_t misses = 0;
+    uint64_t evictions = 0;
+    uint64_t recovered_partial_writes = 0;
+    uint64_t corrupt_records = 0;
+    uint64_t bytes_read = 0;
+    uint64_t bytes_written = 0;
+    uint64_t lookup_probes = 0;
+    uint64_t compactions = 0;
+    uint64_t incompatibility_rejections = 0;
