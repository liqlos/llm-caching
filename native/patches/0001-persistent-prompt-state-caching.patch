+    common_speculative_pcss_stats stats;
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.records_learned == 32);
+
+    pcss::limits reader_limits;
+    reader_limits.read_only = true;
+    pcss::store reader(directory.path.string(), test_identity(), reader_limits);
+    std::string error;
+    assert(reader.open(&error));
+    assert(reader.get_stats().entries == 32);
