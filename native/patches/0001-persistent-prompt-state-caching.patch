+std::vector<uint8_t> read_bytes(const std::filesystem::path & path) {
+    std::ifstream input(path, std::ios::binary);
+    assert(input);
+    input.seekg(0, std::ios::end);
+    const auto size = input.tellg();
+    assert(size >= 0);
+    input.seekg(0, std::ios::beg);
+    std::vector<uint8_t> result(static_cast<size_t>(size));
+    if (!result.empty()) {
+        input.read(reinterpret_cast<char *>(result.data()), static_cast<std::streamsize>(result.size()));
+        assert(input);
+    }
+    return result;
+}
+
+void write_bytes(const std::filesystem::path & path, const std::vector<uint8_t> & bytes) {
+    std::ofstream output(path, std::ios::binary | std::ios::trunc);
+    assert(output);
+    if (!bytes.empty()) output.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    output.flush();
+    assert(output);
+#if !defined(_WIN32)
+    assert(chmod(path.c_str(), 0600) == 0);
+#endif
+}
+
+std::map<std::string, std::vector<uint8_t>> snapshot_files(const std::filesystem::path & root) {
+    std::map<std::string, std::vector<uint8_t>> result;
+    for (const auto & item : std::filesystem::directory_iterator(root)) {
+        if (item.is_regular_file()) result[item.path().filename().string()] = read_bytes(item.path());
+    }
+    return result;
+}
+
+uint64_t directory_bytes(const std::filesystem::path & root) {
+    uint64_t total = 0;
+    for (const auto & item : std::filesystem::directory_iterator(root)) {
+        if (item.is_regular_file()) total += item.file_size();
+    }
+    return total;
+}
+
+void corrupt_byte(const std::filesystem::path & path, std::streamoff offset) {
+    std::fstream file(path, std::ios::binary | std::ios::in | std::ios::out);
+    assert(file);
+    file.seekg(offset);
+    char byte = 0;
+    file.read(&byte, 1);
+    assert(file);
+    byte ^= static_cast<char>(0x5a);
+    file.seekp(offset);
+    file.write(&byte, 1);
+    file.flush();
+    assert(file);
+}
