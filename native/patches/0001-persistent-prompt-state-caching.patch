+void configure_current_source_draft(
+        common_speculative * spec,
+        llama_seq_id seq_id,
+        const tokens & prefix_before_last,
+        llama_token id_last,
+        tokens * result) {
+    auto & dp = common_speculative_get_draft_params(spec, seq_id);
+    dp.drafting = true;
+    dp.n_max = 8;
+    dp.n_past = prefix_before_last.size();
+    dp.id_last = id_last;
+    dp.prompt = &prefix_before_last;
+    dp.result = result;
