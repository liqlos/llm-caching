+    pcss::store second_restart(root, test_identity(), tiny);
+    assert(second_restart.open(&error));
+    assert(second_restart.get_stats().entries == loaded_entries);
+    assert(second_restart.get_stats().peak_ram_bytes <= tiny.max_ram_bytes);
