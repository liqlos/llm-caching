+// One immutable, verified continuation.  `prefix` is the exact visible-token
+// suffix that must be present before `continuation` may be proposed.
+struct match {
+    std::vector<llama_token> prefix;
+    std::vector<llama_token> continuation;
+};
+
+// An append-only, checksummed cache rooted at a caller-owned directory.
