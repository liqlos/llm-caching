+static bool server_redact_pcss_current_source(json & data) {
+    bool redacted = false;
+
+    if (data.is_object()) {
+        for (auto item : data.items()) {
+            if (item.key() == "pcss_current_source") {
+                item.value() = "<redacted>";
+                redacted = true;
+            } else {
+                redacted = server_redact_pcss_current_source(item.value()) || redacted;
+            }
+        }
+    } else if (data.is_array()) {
+        for (auto & item : data) {
+            redacted = server_redact_pcss_current_source(item) || redacted;
+        }
+    }
+
+    return redacted;
+}
+
+static std::string server_json_for_log_without_pcss_current_source(const json & data) {
+    json redacted = data;
+    server_redact_pcss_current_source(redacted);
+    return safe_json_to_str(redacted);
+}
+
+struct server_pcss_current_source {
+    bool supplied = false;
+    bool fingerprint_mismatch = false;
+    llama_tokens visible_tokens;
+};
+
+constexpr size_t server_pcss_current_source_max_tokens = 16384;
+
+// This proprietary extension intentionally accepts only an opaque source ID
+// plus raw token IDs. The source ID is validated but never stored or logged.
+static server_pcss_current_source server_parse_pcss_current_source(
+        const json & data,
+        const common_params & params,
+        const llama_vocab * vocab) {
+    if (!data.contains("pcss_current_source")) {
+        return {};
+    }
+
+    const auto & source = data.at("pcss_current_source");
+    if (!source.is_object()) {
+        throw std::invalid_argument("pcss_current_source must be an object");
+    }
+
+    constexpr const char * schema_version = "pcss.current-source/v1";
+    if (source.size() != 4 ||
+            !source.contains("schema_version") ||
+            !source.contains("compatibility_fingerprint") ||
+            !source.contains("source_id") ||
+            !source.contains("visible_token_ids")) {
+        throw std::invalid_argument(
+                "pcss_current_source must contain exactly schema_version, compatibility_fingerprint, source_id, and visible_token_ids");
+    }
+
+    if (!source.at("schema_version").is_string() ||
+            source.at("schema_version").get<std::string>() != schema_version) {
+        throw std::invalid_argument("pcss_current_source.schema_version must equal pcss.current-source/v1");
+    }
+    if (!source.at("compatibility_fingerprint").is_string()) {
+        throw std::invalid_argument("pcss_current_source.compatibility_fingerprint must be a string");
+    }
+
+    if (!source.at("source_id").is_string()) {
+        throw std::invalid_argument("pcss_current_source.source_id must be a sha256 value");
+    }
+    const std::string source_id = source.at("source_id").get<std::string>();
+    const bool valid_source_id = source_id.size() == 71 &&
+            source_id.compare(0, 7, "sha256:") == 0 &&
+            std::all_of(source_id.begin() + 7, source_id.end(), [](unsigned char c) {
+                return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+            });
+    if (!valid_source_id) {
+        throw std::invalid_argument("pcss_current_source.source_id must be sha256 followed by 64 lowercase hexadecimal characters");
+    }
+
+    const auto & visible_token_ids = source.at("visible_token_ids");
+    if (!visible_token_ids.is_array()) {
+        throw std::invalid_argument("pcss_current_source.visible_token_ids must be an array of token IDs");
+    }
+    if (visible_token_ids.size() > server_pcss_current_source_max_tokens) {
+        throw std::invalid_argument("pcss_current_source.visible_token_ids must contain at most 16384 token IDs");
+    }
+
+    const std::string compatibility_fingerprint = source.at("compatibility_fingerprint").get<std::string>();
+    const bool source_enabled = params.speculative.pcss_cache.enable_current_source &&
+            !params.speculative.pcss_cache.fingerprint.empty();
+    const bool attach = source_enabled &&
+            compatibility_fingerprint == params.speculative.pcss_cache.fingerprint;
+
+    server_pcss_current_source result;
+    result.supplied = true;
+    result.fingerprint_mismatch = source_enabled && !attach;
+    if (attach) {
+        result.visible_tokens.reserve(visible_token_ids.size());
+    }
+    const int n_vocab = attach ? llama_vocab_n_tokens(vocab) : 0;
+
+    for (const auto & raw_token : visible_token_ids) {
+        if (!raw_token.is_number_integer()) {
+            throw std::invalid_argument("pcss_current_source.visible_token_ids must contain valid target-vocabulary int32 token IDs");
+        }
+
+        // A disabled source tier or fingerprint mismatch must remain a normal
+        // generation request.  Keep validating the payload shape, but do not
+        // materialize or target-vocabulary-validate opaque, incompatible IDs.
+        if (!attach) {
+            continue;
+        }
+
+        bool valid = false;
+        llama_token token = LLAMA_TOKEN_NULL;
+        const std::string token_text = raw_token.dump();
+        try {
+            if (!token_text.empty() && token_text.front() == '-') {
+                const long long value = std::stoll(token_text);
+                valid = value >= 0 && value < n_vocab;
+                if (valid) {
+                    token = static_cast<llama_token>(value);
+                }
+            } else {
+                const unsigned long long value = std::stoull(token_text);
+                valid = value <= static_cast<unsigned long long>(std::numeric_limits<llama_token>::max()) &&
+                        value < static_cast<unsigned long long>(n_vocab);
+                if (valid) {
+                    token = static_cast<llama_token>(value);
+                }
+            }
+        } catch (const std::exception &) {
+            valid = false;
+        }
+        if (!valid) {
+            throw std::invalid_argument("pcss_current_source.visible_token_ids must contain valid target-vocabulary int32 token IDs");
+        }
+        if (attach) {
+            result.visible_tokens.push_back(token);
+        }
+    }
+
+    return result;
+}
