+// Persistent PCSS configuration. These values are intentionally part of the
+// common speculative parameters so server, CLI and future embedding callers
+// use the same native provider rather than a sidecar protocol.
+struct common_params_speculative_pcss_cache {
+    std::string store;
+    std::string fingerprint;
+    uint64_t max_disk_gib = 200;
+    uint64_t ram_mib = 256;
+    std::string name_space;
+    // Optional immutable benchmark-policy binding. Keeping it separate from
+    // the store identity lets normal product launches omit it while a
+    // qualification run can prove the native server received its frozen spec.
+    std::string policy_id;
+    std::string policy_spec_sha256;
+    bool read_only = false;
+    bool disable_learning = false;
+    bool disable_current_context = false;
+    // Disabled by default. When explicitly enabled, callers may attach a
+    // request-scoped, tokenized source buffer to the native PCSS provider.
+    // It is never part of the persistent store identity or learned records.
+    bool enable_current_source = false;
+    uint16_t max_draft_tokens = 2;
+};
