+void test_current_source_exact_hit_has_priority_and_is_accounted() {
+    temporary_directory directory("current-source-hit");
+    const auto anchor = current_source_anchor();
+    {
+        pcss::store writer(directory.path.string(), test_identity());
+        std::string error;
+        assert(writer.open(&error));
+        // A durable hit deliberately disagrees with request source. Source
+        // has documented priority, but only after its all-occurrence check.
+        assert(writer.put(anchor, { 21000, 21001 }, &error));
+    }
+
+    auto params = current_source_params(directory);
+    common_speculative_ptr spec(common_speculative_init(params, 1));
+    assert(spec);
+    const tokens before_last(anchor.begin(), anchor.end() - 1);
+    tokens source = anchor;
+    source.insert(source.end(), { 22000, 22001 });
+    tokens draft;
+    common_speculative_begin(spec.get(), 0, before_last);
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, source));
+    configure_current_source_draft(spec.get(), before_last, anchor.back(), &draft);
+    common_speculative_draft(spec.get());
+    assert(draft == tokens({ 22000, 22001 }));
+    common_speculative_accept(spec.get(), 0, 2);
+
+    common_speculative_pcss_stats stats;
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_lookups == 1);
+    assert(stats.current_source_hits == 1);
+    assert(stats.current_source_ambiguities == 0);
+    assert(stats.current_source_abstentions == 0);
+    assert(stats.current_source_draft_tokens == 2);
+    assert(stats.current_source_accepted_tokens == 2);
+    assert(stats.current_source_index_bytes > 0);
+    assert(stats.persistent_hits == 0);
