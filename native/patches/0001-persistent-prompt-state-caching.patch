+static void test_roundtrip_restart_and_partial_prefix() {
+    const auto path = temporary_directory("llama-prompt-cache-roundtrip");
+    const llama_tokens tokens = {1, 2, 3, 4, 5};
+    const std::vector<uint8_t> main = {10, 20, 30, 40};
+    const std::vector<uint8_t> draft = {50, 60};
+    common_prompt_checkpoint checkpoint;
+    checkpoint.n_tokens = 3;
+    checkpoint.id_task = 7;
+    checkpoint.pos_min = 1;
+    checkpoint.pos_max = 3;
+    checkpoint.data_tgt = {70, 80};
+    checkpoint.data_dft = {90};
+    checkpoint.data_spec = {100, 110};
+    std::list<common_prompt_checkpoint> checkpoints = {checkpoint};
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        std::string error;
+        require(store.open(&error));
+        require(store.put(tokens, checkpoints, main, draft, &error));
+        const auto bytes_before_duplicate = store.stats().physical_bytes;
+        require(store.put(tokens, checkpoints, main, draft, &error));
+        require(store.stats().entries == 1);
+        require(store.stats().physical_bytes == bytes_before_duplicate);
+        server_prompt_cache_disk_value value;
+        require(store.load_best({1, 2, 3, 9}, 0, -1.0f, 0.0f, &value, &error));
+        require(value.tokens == llama_tokens({1, 2, 3}));
+        require(value.main == checkpoint.data_tgt);
+        require(value.drft == checkpoint.data_dft);
+        require(value.checkpoints.size() == 1);
+        require(value.checkpoints.front().data_spec == checkpoint.data_spec);
+    }
+    {
+        std::ofstream tail(path / "prompt-records.bin", std::ios::binary | std::ios::app);
+        tail << "uncommitted";
+    }
+    {
+        std::ofstream tail(path / "prompt-manifest.bin", std::ios::binary | std::ios::app);
+        tail << "partial";
+    }
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        std::string error;
+        require(store.open(&error));
+        server_prompt_cache_disk_value value;
+        require(store.load_best(tokens, 0, -1.0f, 0.0f, &value, &error));
+        require(value.tokens == tokens);
+        require(value.main == main);
+        require(std::filesystem::file_size(path / "prompt-manifest.bin") == 32);
+    }
+    std::filesystem::copy_file(path / "prompt-records.bin", path / "prompt-records.bin.prev");
+    std::filesystem::copy_file(path / "prompt-manifest.bin", path / "prompt-manifest.bin.prev");
+    std::filesystem::remove(path / "prompt-manifest.bin");
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        std::string error;
+        require(store.open(&error));
+        server_prompt_cache_disk_value value;
+        require(store.load_best(tokens, 0, -1.0f, 0.0f, &value, &error));
+        require(value.tokens == tokens);
+    }
+    std::filesystem::copy_file(path / "prompt-records.bin", path / "prompt-records.bin.prev");
+    std::filesystem::copy_file(path / "prompt-manifest.bin", path / "prompt-manifest.bin.prev");
+    std::filesystem::remove(path / "prompt-records.bin");
+    std::filesystem::remove(path / "prompt-manifest.bin");
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        std::string error;
+        require(store.open(&error));
+        server_prompt_cache_disk_value value;
+        require(store.load_best(tokens, 0, -1.0f, 0.0f, &value, &error));
+    }
+    std::filesystem::remove_all(path);
+}
+
+static void test_quota_eviction_and_compaction() {
+    const auto path = temporary_directory("llama-prompt-cache-quota");
+    const std::vector<uint8_t> state(700 * 1024, 42);
+    std::string error;
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        require(store.open(&error));
+        require(store.put({1, 2, 3, 4}, {}, state, {}, &error));
+        require(store.put({5, 6, 7, 8}, {}, state, {}, &error));
+        const auto stats = store.stats();
+        require(stats.entries == 1);
+        require(stats.evictions == 1);
+        require(stats.compactions == 1);
+        require(stats.physical_bytes <= 1024 * 1024);
+    }
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        require(store.open(&error));
+        server_prompt_cache_disk_value value;
+        require(!store.load_best({1, 2, 3, 4}, 0, -1.0f, 0.0f, &value, &error));
+        require(store.load_best({5, 6, 7, 8}, 0, -1.0f, 0.0f, &value, &error));
+    }
+    std::filesystem::remove_all(path);
+}
+
+static void test_manifest_failure_disables_store_until_restart() {
+#if !defined(_WIN32)
+    const auto path = temporary_directory("llama-prompt-cache-manifest-failure");
+    const std::vector<uint8_t> state(4096, 42);
+    std::string error;
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        require(store.open(&error));
+        require(store.put({1, 2, 3, 4}, {}, state, {}, &error));
+        std::filesystem::permissions(
+            path / "prompt-manifest.bin",
+            std::filesystem::perms::owner_read,
+            std::filesystem::perm_options::replace);
+        require(!store.put({5, 6, 7, 8}, {}, state, {}, &error));
+        server_prompt_cache_disk_value value;
+        require(!store.load_best({1, 2, 3, 4}, 0, -1.0f, 0.0f, &value, &error));
+    }
+    std::filesystem::permissions(
+        path / "prompt-manifest.bin",
+        std::filesystem::perms::owner_read | std::filesystem::perms::owner_write,
+        std::filesystem::perm_options::replace);
+    {
+        server_prompt_cache_store store(path.string(), 1024 * 1024);
+        require(store.open(&error));
+        server_prompt_cache_disk_value value;
+        require(store.load_best({1, 2, 3, 4}, 0, -1.0f, 0.0f, &value, &error));
+        require(!store.load_best({5, 6, 7, 8}, 0, -1.0f, 0.0f, &value, &error));
+    }
+    std::filesystem::remove_all(path);
+#endif
+}
+
+int main() {
+    test_roundtrip_restart_and_partial_prefix();
+    test_quota_eviction_and_compaction();
+    test_manifest_failure_disables_store_until_restart();
+    return 0;
+}
