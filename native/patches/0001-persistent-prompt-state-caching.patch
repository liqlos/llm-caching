+struct store::entry {
+    uint64_t record_offset = 0;
+    uint64_t prefix_offset = 0;
+    uint64_t serialized_bytes = 0;
+    uint64_t prefix_hash = 0;
+    uint64_t last_used = 0;
+    uint32_t prefix_count = 0;
+    uint32_t continuation_count = 0;
+};
+struct store::index_item { uint64_t prefix_hash = 0; uint32_t prefix_count = 0; uint32_t entry_index = 0; };
+
+store::store(std::string directory, identity id, limits cap)
+    : directory_(std::move(directory)), id_(std::move(id)), limits_(cap) { stats_.read_only = limits_.read_only; }
+store::~store() {
+#if !defined(_WIN32)
+    if (lock_fd_ >= 0) { ::flock(lock_fd_, LOCK_UN); ::close(lock_fd_); }
+#endif
+}
+bool store::is_open() const { return open_; }
+stats store::get_stats() const { return stats_; }
+void store::update_ram_bytes() {
+    stats_.ram_bytes = entries_.capacity() * sizeof(entry) + index_.capacity() * sizeof(index_item) +
+                       prefix_lengths_.capacity() * sizeof(uint32_t);
+    stats_.peak_ram_bytes = std::max(stats_.peak_ram_bytes, stats_.ram_bytes);
+}
+void store::rebuild_index() {
+    std::vector<index_item> rebuilt;
+    rebuilt.reserve(entries_.size());
+    for (size_t i = 0; i < entries_.size(); ++i) rebuilt.push_back({ entries_[i].prefix_hash, entries_[i].prefix_count, static_cast<uint32_t>(i) });
+    std::sort(rebuilt.begin(), rebuilt.end(), [](const index_item & a, const index_item & b) {
+        if (a.prefix_count != b.prefix_count) return a.prefix_count < b.prefix_count;
+        if (a.prefix_hash != b.prefix_hash) return a.prefix_hash < b.prefix_hash;
+        return a.entry_index < b.entry_index;
+    });
+    std::vector<uint32_t> lengths;
+    lengths.reserve(rebuilt.size());
+    for (const index_item & item : rebuilt) {
+        if (lengths.empty() || lengths.back() != item.prefix_count) lengths.push_back(item.prefix_count);
+    }
+    index_.swap(rebuilt);
+    prefix_lengths_.swap(lengths);
+    update_ram_bytes();
+}
+
+bool store::open(std::string * error) {
+    if (open_) return true;
+    if (id_.name_space.empty() || id_.fingerprint.empty()) { if (error) *error = "PCSS identity requires non-empty namespace and fingerprint"; return false; }
+    if (limits_.max_entries > std::numeric_limits<uint32_t>::max() || limits_.max_lookup_probes == 0 ||
+        limits_.max_lookup_bytes < sizeof(int32_t) || limits_.max_ram_bytes < sizeof(entry) + sizeof(index_item) + sizeof(uint32_t)) {
+        if (error) *error = "PCSS limits do not permit a bounded metadata index and lookup"; return false;
+    }
+    std::error_code ec;
+    if (!limits_.read_only) std::filesystem::create_directories(directory_, ec);
+    if (ec || (!std::filesystem::exists(directory_, ec) && !limits_.read_only)) { if (error) *error = "cannot create PCSS store directory"; return false; }
+    if (!limits_.read_only) {
+#if defined(_WIN32)
+        if (error) *error = "writable PCSS process locking is unavailable on this platform";
+        return false;
+#else
+        if (!secure_path(directory_, true, true, error)) return false;
+        const std::string lock_path = path_join(directory_, "writer.lock");
+        if (!secure_path(lock_path, false, true, error)) return false;
+        int lock_flags = O_RDWR | O_CREAT;
+#if defined(O_NOFOLLOW)
+        lock_flags |= O_NOFOLLOW;
+#endif
+        lock_fd_ = ::open(lock_path.c_str(), lock_flags, 0600);
+        if (lock_fd_ < 0) {
+            if (error) *error = "cannot open PCSS writer lock: " + std::string(std::strerror(errno));
+            return false;
+        }
+        if (::flock(lock_fd_, LOCK_EX | LOCK_NB) != 0) {
+            ::close(lock_fd_); lock_fd_ = -1;
+            if (error) *error = "another writable PCSS store owner holds the process lock";
+            return false;
+        }
+        struct stat lock_info{};
+        if (::fstat(lock_fd_, &lock_info) != 0 || !S_ISREG(lock_info.st_mode) || lock_info.st_uid != ::geteuid()) {
+            if (error) *error = "unsafe ownership or file type for PCSS writer lock";
+            ::flock(lock_fd_, LOCK_UN); ::close(lock_fd_); lock_fd_ = -1; return false;
+        }
+        if (::fchmod(lock_fd_, 0600) != 0) {
+            if (error) *error = "cannot secure PCSS writer lock permissions";
+            ::flock(lock_fd_, LOCK_UN); ::close(lock_fd_); lock_fd_ = -1; return false;
+        }
+        const std::array<const char *, 10> private_files = {
+            "records.pcss", "manifest.pcss", "records.pcss.prev", "manifest.pcss.prev",
+            "records.pcss.compact", "manifest.pcss.compact", "index.pcss", "index.pcss.prev", "index.pcss.tmp", "index.pcss.compact",
+        };
+        for (const char * name : private_files) {
+            if (!secure_path(path_join(directory_, name), false, true, error)) {
+                ::flock(lock_fd_, LOCK_UN); ::close(lock_fd_); lock_fd_ = -1; return false;
+            }
+        }
+        if (!sync_directory(directory_, error)) { ::flock(lock_fd_, LOCK_UN); ::close(lock_fd_); lock_fd_ = -1; return false; }
+#endif
+    }
+    if (limits_.read_only) {
+        if (!secure_path(directory_, true, false, error)) return false;
+        const std::array<const char *, 10> private_files = {
+            "records.pcss", "manifest.pcss", "records.pcss.prev", "manifest.pcss.prev",
+            "records.pcss.compact", "manifest.pcss.compact", "index.pcss", "index.pcss.prev", "index.pcss.tmp", "index.pcss.compact",
+        };
+        for (const char * name : private_files) if (!secure_path(path_join(directory_, name), false, false, error)) return false;
+    }
+    if (!load(error)) {
+#if !defined(_WIN32)
+        if (lock_fd_ >= 0) { ::flock(lock_fd_, LOCK_UN); ::close(lock_fd_); lock_fd_ = -1; }
+#endif
+        return false;
+    }
+    open_ = true; return true;
+}
+
+bool store::load_index(uint64_t committed, uint64_t manifest_bytes, bool * loaded, std::string * error) {
+    *loaded = false;
+    const std::array<std::string, 1> candidates = { active_index_path_ };
+    bool found = false;
+    for (const std::string & path : candidates) {
+        uint64_t size64 = 0;
+        if (!file_size(path, &size64, error)) return false;
+        if (size64 == 0) continue;
+        found = true;
+        if (size64 > limits_.max_ram_bytes + id_.name_space.size() + id_.fingerprint.size() + 256) continue;
+        std::vector<uint8_t> data(static_cast<size_t>(size64));
+        std::ifstream input(path, std::ios::binary);
+        if (!input || !input.read(reinterpret_cast<char *>(data.data()), static_cast<std::streamsize>(data.size()))) continue;
+        stats_.bytes_read += data.size();
+        if (data.size() < sizeof(uint64_t)) continue;
+        size_t pos = 0;
+        uint32_t magic = 0, version = 0, count = 0;
+        uint64_t bound_records = 0, bound_manifest = 0;
+        std::string name_space, fingerprint;
+        if (!read_scalar(data.data(), data.size(), &pos, &magic) || !read_scalar(data.data(), data.size(), &pos, &version) ||
+            !read_scalar(data.data(), data.size(), &pos, &bound_records) || !read_scalar(data.data(), data.size(), &pos, &bound_manifest) ||
+            !read_string(data.data(), data.size(), &pos, &name_space) || !read_string(data.data(), data.size(), &pos, &fingerprint) ||
+            !read_scalar(data.data(), data.size(), &pos, &count) || magic != index_magic || version != format_version ||
+            bound_records > committed || bound_manifest > manifest_bytes || bound_manifest % manifest_row_bytes != 0 ||
+            name_space != id_.name_space || fingerprint != id_.fingerprint ||
+            count > limits_.max_entries || count > limits_.max_ram_bytes / (sizeof(entry) + sizeof(index_item) + sizeof(uint32_t)) ||
+            data.size() - pos != static_cast<size_t>(count) * 48 + sizeof(uint64_t)) continue;
+        uint64_t checksum = 0;
+        size_t checksum_pos = data.size() - sizeof(uint64_t);
+        size_t checksum_read = checksum_pos;
+        if (!read_scalar(data.data(), data.size(), &checksum_read, &checksum) || fnv1a(data.data(), checksum_pos) != checksum) continue;
+        std::vector<entry> indexed;
+        indexed.reserve(count);
+        size_t active_bytes = 0;
+        bool valid = true;
+        for (uint32_t i = 0; i < count; ++i) {
+            entry value;
+            if (!read_scalar(data.data(), checksum_pos, &pos, &value.record_offset) ||
+                !read_scalar(data.data(), checksum_pos, &pos, &value.prefix_offset) ||
+                !read_scalar(data.data(), checksum_pos, &pos, &value.serialized_bytes) ||
+                !read_scalar(data.data(), checksum_pos, &pos, &value.prefix_hash) ||
+                !read_scalar(data.data(), checksum_pos, &pos, &value.last_used) ||
+                !read_scalar(data.data(), checksum_pos, &pos, &value.prefix_count) ||
+                !read_scalar(data.data(), checksum_pos, &pos, &value.continuation_count) ||
+                value.record_offset > bound_records || value.serialized_bytes > bound_records - value.record_offset ||
+                value.prefix_offset < value.record_offset + record_header_bytes || value.prefix_offset > bound_records) { valid = false; break; }
+            active_bytes += value.serialized_bytes;
+            clock_ = std::max(clock_, value.last_used);
+            indexed.push_back(value);
+        }
+        if (!valid || pos != checksum_pos) continue;
+        entries_.swap(indexed);
+        stats_.bytes = active_bytes;
+        stats_.entries = entries_.size();
+        index_bytes_ = size64;
+        index_committed_bytes_ = bound_records;
+        index_manifest_bytes_ = bound_manifest;
+        index_entry_count_ = entries_.size();
+        rebuild_index();
+        *loaded = true;
+        return true;
+    }
+    if (found && error) *error = "PCSS hot index is corrupt, stale, or identity-incompatible";
+    return true;
+}
+
+std::vector<uint8_t> store::serialize_index(uint64_t committed, uint64_t manifest_bytes) const {
+    std::vector<uint8_t> data;
+    append_scalar<uint32_t>(data, index_magic); append_scalar<uint32_t>(data, format_version);
+    append_scalar<uint64_t>(data, committed); append_scalar<uint64_t>(data, manifest_bytes);
+    append_string(data, id_.name_space); append_string(data, id_.fingerprint);
+    append_scalar<uint32_t>(data, static_cast<uint32_t>(entries_.size()));
+    for (const entry & value : entries_) {
+        append_scalar<uint64_t>(data, value.record_offset); append_scalar<uint64_t>(data, value.prefix_offset);
+        append_scalar<uint64_t>(data, value.serialized_bytes); append_scalar<uint64_t>(data, value.prefix_hash);
+        append_scalar<uint64_t>(data, value.last_used); append_scalar<uint32_t>(data, value.prefix_count);
+        append_scalar<uint32_t>(data, value.continuation_count);
+    }
+    append_scalar<uint64_t>(data, fnv1a(data.data(), data.size()));
+    return data;
+}
+
+bool store::publish_index(std::string * error) {
+    if (limits_.read_only) return true;
+    std::vector<uint8_t> data = serialize_index(committed_bytes_, manifest_bytes_);
+    const uint64_t next_physical = committed_bytes_ + manifest_bytes_ + data.size();
+    if (next_physical > limits_.max_bytes) { if (error) *error = "PCSS hot index exceeds physical store byte capacity"; return false; }
+    const std::string tmp = path_join(directory_, "index.pcss.tmp");
+    const std::string current = path_join(directory_, "index.pcss");
+    if (!durable_write_file(tmp, data, error) || !sync_directory(directory_, error)) return false;
+    std::error_code ec;
+    std::filesystem::rename(tmp, current, ec);
+    if (ec) { if (error) *error = "cannot publish durable PCSS hot index"; return false; }
+    if (!sync_directory(directory_, error)) return false;
+    stats_.bytes_written += data.size();
+    index_bytes_ = data.size();
+    index_committed_bytes_ = committed_bytes_;
+    index_manifest_bytes_ = manifest_bytes_;
+    index_entry_count_ = entries_.size();
+    active_index_path_ = current;
+    physical_bytes_ = next_physical; stats_.physical_bytes = physical_bytes_;
+    return true;
+}
+
+bool store::load(std::string * error) {
+    std::string records_path = path_join(directory_, "records.pcss");
+    std::string manifest_path = path_join(directory_, "manifest.pcss");
+    std::string index_path = path_join(directory_, "index.pcss");
+    const std::string records_prev = records_path + ".prev", manifest_prev = manifest_path + ".prev", index_prev = index_path + ".prev";
+    std::error_code ec;
+    const bool current_pair = std::filesystem::exists(records_path, ec) && std::filesystem::exists(manifest_path, ec);
+    const bool previous_pair = std::filesystem::exists(records_prev, ec) && std::filesystem::exists(manifest_prev, ec);
+    const bool mixed_old_pair = !std::filesystem::exists(records_path, ec) && std::filesystem::exists(records_prev, ec) &&
+                                std::filesystem::exists(manifest_path, ec) && !std::filesystem::exists(manifest_prev, ec);
+    if (!current_pair && previous_pair) {
+        ++stats_.recovered_partial_writes;
+        if (!limits_.read_only) {
+            std::filesystem::remove(records_path, ec);
+            std::filesystem::remove(manifest_path, ec);
+            if (!sync_directory(directory_, error)) return false;
+            std::filesystem::rename(records_prev, records_path, ec);
+            if (ec) { if (error) *error = "cannot restore previous PCSS records generation"; return false; }
+            if (!sync_directory(directory_, error)) return false;
+            std::filesystem::rename(manifest_prev, manifest_path, ec);
+            if (ec) { if (error) *error = "cannot restore previous PCSS manifest generation"; return false; }
+            if (!sync_directory(directory_, error)) return false;
+            if (std::filesystem::exists(index_prev, ec)) {
+                std::filesystem::remove(index_path, ec);
+                std::filesystem::rename(index_prev, index_path, ec);
+                if (ec) { if (error) *error = "cannot restore previous PCSS index generation"; return false; }
+                if (!sync_directory(directory_, error)) return false;
+            }
+        } else {
+            records_path = records_prev;
+            manifest_path = manifest_prev;
+            index_path = std::filesystem::exists(index_prev, ec) ? index_prev : index_path;
+        }
+    } else if (!current_pair && mixed_old_pair) {
+        ++stats_.recovered_partial_writes;
+        if (!limits_.read_only) {
+            std::filesystem::rename(records_prev, records_path, ec);
+            if (ec) { if (error) *error = "cannot restore mixed PCSS records generation"; return false; }
+            if (!sync_directory(directory_, error)) return false;
+        } else {
+            records_path = records_prev;
+        }
+    }
+    active_records_path_ = records_path;
+    active_index_path_ = index_path;
+
+    uint64_t raw_manifest_size = 0, records_size = 0;
+    if (!file_size(manifest_path, &raw_manifest_size, error) || !file_size(records_path, &records_size, error)) return false;
+    uint64_t committed = 0, committed_count = 0, valid_manifest_bytes = 0;
+    valid_manifest_bytes = (raw_manifest_size / manifest_row_bytes) * manifest_row_bytes;
+    if (raw_manifest_size != valid_manifest_bytes) ++stats_.recovered_partial_writes;
+    if (valid_manifest_bytes != 0) {
+        std::ifstream manifests(manifest_path, std::ios::binary);
+        std::array<uint8_t, manifest_row_bytes> row{};
+        manifests.seekg(static_cast<std::streamoff>(valid_manifest_bytes - manifest_row_bytes));
+        manifests.read(reinterpret_cast<char *>(row.data()), row.size());
+        const size_t got = static_cast<size_t>(manifests.gcount()); stats_.bytes_read += got;
+        size_t pos = 0; uint32_t magic = 0, version = 0; uint64_t checksum = 0;
+        if (got != row.size() || !read_scalar(row.data(), row.size(), &pos, &magic) ||
+            !read_scalar(row.data(), row.size(), &pos, &version) || !read_scalar(row.data(), row.size(), &pos, &committed) ||
+            !read_scalar(row.data(), row.size(), &pos, &committed_count) || !read_scalar(row.data(), row.size(), &pos, &checksum) ||
+            magic != manifest_magic || version != format_version || fnv1a(row.data(), row.size() - sizeof(checksum)) != checksum) {
+            ++stats_.corrupt_records;
+            if (error) *error = "latest committed PCSS manifest row is corrupt";
+            return false;
+        }
+    }
+    if (!limits_.read_only && raw_manifest_size > valid_manifest_bytes) {
+        std::filesystem::resize_file(manifest_path, valid_manifest_bytes, ec);
+        if (ec) { if (error) *error = "cannot truncate uncommitted PCSS manifest tail"; return false; }
+        if (!sync_file(manifest_path, error) || !sync_directory(directory_, error)) return false;
+    }
+
+    if (committed > records_size) { if (error) *error = "manifest commits beyond records file"; return false; }
+    uint64_t raw_index_size = 0;
+    if (!file_size(active_index_path_, &raw_index_size, error)) return false;
+    if (records_size > limits_.max_bytes || raw_manifest_size > limits_.max_bytes - records_size ||
+        raw_index_size > limits_.max_bytes - records_size - raw_manifest_size) {
+        if (error) *error = "physical PCSS generation exceeds configured byte capacity";
+        return false;
+    }
+    if (committed < records_size) ++stats_.recovered_partial_writes;
+    if (!limits_.read_only && records_size > committed) {
+        std::filesystem::resize_file(records_path, committed, ec);
+        if (ec) { if (error) *error = "cannot truncate uncommitted PCSS record tail"; return false; }
+        if (!sync_file(records_path, error) || !sync_directory(directory_, error)) return false;
+        records_size = committed;
+    }
+    bool indexed = false;
+    std::string index_error;
+    if (!load_index(committed, valid_manifest_bytes, &indexed, &index_error)) return false;
+    if (indexed && index_committed_bytes_ == committed && index_manifest_bytes_ == valid_manifest_bytes) {
+        committed_bytes_ = committed;
+        manifest_bytes_ = valid_manifest_bytes;
+        physical_bytes_ = (limits_.read_only ? records_size : committed) + valid_manifest_bytes + index_bytes_;
+        stats_.physical_bytes = physical_bytes_;
+        return enforce_limits(error);
+    }
+    const uint64_t scan_record_begin = indexed ? index_committed_bytes_ : 0;
+    const uint64_t scan_manifest_begin = indexed ? index_manifest_bytes_ : 0;
+    const uint64_t scan_record_bytes = committed - scan_record_begin;
+    const uint64_t scan_manifest_bytes = valid_manifest_bytes - scan_manifest_begin;
+    if (scan_record_bytes > limits_.max_startup_bytes || scan_manifest_bytes > limits_.max_startup_bytes - scan_record_bytes ||
+        (!indexed && committed_count > limits_.max_startup_records)) {
+        if (error) *error = index_error.empty() ? "PCSS hot index missing and startup scan budget is insufficient" : index_error;
+        return false;
+    }
+    if (error) error->clear();
+    std::ifstream records(records_path, std::ios::binary);
+    if (committed != 0 && !records) { if (error) *error = "cannot open committed PCSS records"; return false; }
+    records.seekg(static_cast<std::streamoff>(scan_record_begin));
+    if (!records && scan_record_begin != 0) { if (error) *error = "cannot seek PCSS checkpoint tail"; return false; }
+    const size_t metadata_bytes_per_entry = sizeof(entry) + sizeof(index_item) + sizeof(uint32_t);
+    const size_t ram_entry_limit = limits_.max_ram_bytes / metadata_bytes_per_entry;
+    const size_t load_entry_limit = std::min(limits_.max_entries, ram_entry_limit);
+    std::deque<entry> hot_entries(entries_.begin(), entries_.end());
+    bool saw_incompatible = false;
+    size_t scanned_records = 0;
+    uint64_t offset = scan_record_begin;
+    while (offset < committed) {
+        if (++scanned_records > limits_.max_startup_records) {
+            if (error) *error = "PCSS startup scan record limit exceeded";
+            return false;
+        }
+        const uint64_t start = offset;
+        std::array<uint8_t, record_header_bytes> header{};
+        records.read(reinterpret_cast<char *>(header.data()), header.size());
+        const size_t got = static_cast<size_t>(records.gcount()); stats_.bytes_read += got;
+        if (got != header.size()) { if (error) *error = "corrupt committed PCSS record"; return false; }
+        offset += header.size();
+        size_t hp = 0; uint32_t magic = 0, version = 0, payload_size = 0; uint64_t checksum = 0;
+        if (!read_scalar(header.data(), header.size(), &hp, &magic) || !read_scalar(header.data(), header.size(), &hp, &version) ||
+            !read_scalar(header.data(), header.size(), &hp, &payload_size) || !read_scalar(header.data(), header.size(), &hp, &checksum) ||
+            magic != record_magic || version != format_version || payload_size > max_field_bytes || committed - offset < payload_size) {
+            if (error) *error = "corrupt committed PCSS record"; return false;
+        }
+        payload_reader payload(records, payload_size, &stats_.bytes_read);
+        uint32_t namespace_size = 0, fingerprint_size = 0, prefix_count = 0, continuation_count = 0;
+        if (!payload.string_equals(id_.name_space, &namespace_size) || !payload.string_equals(id_.fingerprint, &fingerprint_size) ||
+            !payload.scalar(&prefix_count) || !payload.scalar(&continuation_count) || prefix_count > max_token_count ||
+            continuation_count > max_token_count || payload.remaining() != static_cast<uint64_t>(prefix_count + continuation_count) * sizeof(int32_t)) {
+            if (error) *error = "invalid PCSS record payload"; return false;
+        }
+        const uint64_t token_offset = start + record_header_bytes + 4 + namespace_size + 4 + fingerprint_size + 8;
+        uint64_t hash = hash_offset;
+        for (uint32_t i = 0; i < prefix_count; ++i) {
+            int32_t token = 0;
+            if (!payload.scalar(&token)) { if (error) *error = "invalid PCSS prefix"; return false; }
+            hash = hash * hash_prime + mix_token(static_cast<llama_token>(token));
+        }
+        if (!payload.skip(static_cast<size_t>(continuation_count) * sizeof(int32_t)) || payload.remaining() != 0 || payload.checksum() != checksum) {
+            if (error) *error = "checksummed PCSS record is corrupt"; return false;
+        }
+        offset += payload_size;
+        if (payload.equal()) {
+            const size_t lookup_bytes = static_cast<size_t>(prefix_count + continuation_count) * sizeof(int32_t);
+            if (lookup_bytes > limits_.max_lookup_bytes) {
+                ++stats_.incompatibility_rejections; saw_incompatible = true; continue;
+            }
+            entry value;
+            value.record_offset = start; value.prefix_offset = token_offset; value.serialized_bytes = record_header_bytes + payload_size;
+            value.prefix_hash = hash; value.last_used = ++clock_; value.prefix_count = prefix_count; value.continuation_count = continuation_count;
+            while (!hot_entries.empty() &&
+                   (hot_entries.size() >= load_entry_limit || stats_.bytes + value.serialized_bytes > limits_.max_bytes)) {
+                stats_.bytes -= hot_entries.front().serialized_bytes;
+                hot_entries.pop_front();
+                ++stats_.evictions;
+                dirty_compaction_ = true;
+            }
+            if (load_entry_limit == 0 || value.serialized_bytes > limits_.max_bytes) {
+                ++stats_.evictions;
+                dirty_compaction_ = true;
+            } else {
+                stats_.bytes += value.serialized_bytes;
+                hot_entries.push_back(value);
+            }
+            stats_.ram_bytes = hot_entries.size() * metadata_bytes_per_entry;
+            stats_.peak_ram_bytes = std::max(stats_.peak_ram_bytes, stats_.ram_bytes);
+        } else {
+            saw_incompatible = true;
+        }
+    }
+    entries_.assign(hot_entries.begin(), hot_entries.end());
+    hot_entries.clear();
+    if (committed_count != 0 && committed_count < entries_.size()) { if (error) *error = "manifest record count is inconsistent"; return false; }
+    committed_bytes_ = committed;
+    manifest_bytes_ = valid_manifest_bytes;
+    index_bytes_ = raw_index_size;
+    physical_bytes_ = (limits_.read_only ? records_size : committed_bytes_) + manifest_bytes_ + index_bytes_;
+    stats_.physical_bytes = physical_bytes_;
+    if (saw_incompatible && !limits_.read_only) dirty_compaction_ = true;
+    stats_.entries = entries_.size(); rebuild_index();
+    if (!enforce_limits(error)) return false;
+    return limits_.read_only || publish_index(error);
+}
+
+bool store::append_manifest(uint64_t record_bytes, uint64_t count, std::string * error) {
+    std::vector<uint8_t> data;
+    append_scalar<uint32_t>(data, manifest_magic); append_scalar<uint32_t>(data, format_version);
+    append_scalar<uint64_t>(data, record_bytes); append_scalar<uint64_t>(data, count);
+    append_scalar<uint64_t>(data, fnv1a(data.data(), data.size()));
+    if (!durable_append_file(path_join(directory_, "manifest.pcss"), data, error)) return false;
+    if (!sync_directory(directory_, error)) return false;
+    stats_.bytes_written += data.size(); return true;
+}
+bool store::append_batch(const std::vector<match> & values, std::vector<entry> * appended, std::string * error) {
+    std::vector<uint8_t> data;
+    appended->clear(); appended->reserve(values.size());
+    uint64_t next_offset = committed_bytes_;
+    for (const match & item : values) {
+        std::vector<uint8_t> payload;
+        append_string(payload, id_.name_space); append_string(payload, id_.fingerprint);
+        append_scalar<uint32_t>(payload, static_cast<uint32_t>(item.prefix.size()));
+        append_scalar<uint32_t>(payload, static_cast<uint32_t>(item.continuation.size()));
+        for (llama_token token : item.prefix) append_scalar<int32_t>(payload, static_cast<int32_t>(token));
+        for (llama_token token : item.continuation) append_scalar<int32_t>(payload, static_cast<int32_t>(token));
+        entry value;
+        value.record_offset = next_offset;
+        value.prefix_offset = next_offset + record_header_bytes + 4 + id_.name_space.size() + 4 + id_.fingerprint.size() + 8;
+        value.serialized_bytes = record_header_bytes + payload.size();
+        value.prefix_hash = token_sequence_hash(item.prefix);
+        value.prefix_count = static_cast<uint32_t>(item.prefix.size());
+        value.continuation_count = static_cast<uint32_t>(item.continuation.size());
+        value.last_used = ++clock_;
+        append_scalar<uint32_t>(data, record_magic); append_scalar<uint32_t>(data, format_version);
+        append_scalar<uint32_t>(data, static_cast<uint32_t>(payload.size()));
+        append_scalar<uint64_t>(data, fnv1a(payload.data(), payload.size()));
+        data.insert(data.end(), payload.begin(), payload.end());
+        appended->push_back(value);
+        next_offset += value.serialized_bytes;
+    }
+    const uint64_t future_index_bytes = 44u + id_.name_space.size() + id_.fingerprint.size() +
+                                        (entries_.size() + values.size()) * 48u;
+    const uint64_t future_physical = committed_bytes_ + data.size() + manifest_bytes_ + manifest_row_bytes + future_index_bytes;
+    if (data.size() + manifest_row_bytes + future_index_bytes > limits_.max_bytes) {
+        if (error) *error = "PCSS batch exceeds physical store byte capacity";
+        return false;
+    }
+    if (future_physical > limits_.max_bytes) {
+        dirty_compaction_ = true;
+        if (!compact(error)) return false;
+        const uint64_t compacted_future = committed_bytes_ + data.size() + manifest_bytes_ + manifest_row_bytes + future_index_bytes;
+        if (compacted_future > limits_.max_bytes) {
+            if (error) *error = "PCSS batch exceeds physical store byte capacity";
+            return false;
+        }
+        // Compaction changes the base offsets; rebuild the pending metadata.
+        return append_batch(values, appended, error);
+    }
+    // The record bytes become durable before the manifest publishes them.
+    if (!durable_append_file(path_join(directory_, "records.pcss"), data, error)) return false;
+    if (!sync_directory(directory_, error)) return false;
+    stats_.bytes_written += data.size();
+    const uint64_t next = committed_bytes_ + data.size();
+    if (!append_manifest(next, entries_.size() + values.size(), error)) return false;
+    committed_bytes_ = next;
+    manifest_bytes_ += manifest_row_bytes;
+    physical_bytes_ = committed_bytes_ + manifest_bytes_ + index_bytes_;
+    stats_.physical_bytes = physical_bytes_;
+    return true;
+}
+
+bool store::put(const std::vector<llama_token> & prefix, const std::vector<llama_token> & continuation, std::string * error) {
+    return put_batch({ match{ prefix, continuation } }, error);
+}
+
+bool store::put_batch(const std::vector<match> & values, std::string * error) {
+    if (!open_ && !open(error)) return false;
+    if (limits_.read_only) { if (error) *error = "PCSS store is read-only"; return false; }
+    if (values.empty() || values.size() > 32) { if (error) *error = "PCSS batch requires between 1 and 32 records"; return false; }
+    size_t aggregate_token_bytes = 0;
+    for (const match & value : values) {
+        const size_t token_bytes = (value.prefix.size() + value.continuation.size()) * sizeof(int32_t);
+        if (value.prefix.empty() || value.continuation.empty() || value.prefix.size() > max_token_count ||
+            value.continuation.size() > max_token_count || token_bytes > limits_.max_lookup_bytes ||
+            aggregate_token_bytes > limits_.max_lookup_bytes - token_bytes) {
+            ++stats_.incompatibility_rejections;
+            if (error) *error = "PCSS batch exceeds configured lookup byte bound";
+            return false;
+        }
+        aggregate_token_bytes += token_bytes;
+    }
+    std::vector<entry> appended;
+    if (!append_batch(values, &appended, error)) return false;
+    for (const entry & value : appended) { stats_.bytes += value.serialized_bytes; entries_.push_back(value); }
+    stats_.puts += values.size(); stats_.entries = entries_.size();
+    rebuild_index();
+    if (!enforce_limits(error)) return false;
+    if (index_committed_bytes_ == committed_bytes_ && index_manifest_bytes_ == manifest_bytes_) return true;
+    const uint64_t checkpoint_bytes = std::max<uint64_t>(1, std::min<uint64_t>(limits_.max_startup_bytes / 2, 4u * 1024u * 1024u));
+    const size_t checkpoint_records = std::max<size_t>(1, limits_.max_startup_records / 2);
+    const size_t tail_records = entries_.size() > index_entry_count_ ? entries_.size() - index_entry_count_ : 0;
+    if (index_bytes_ == 0 || committed_bytes_ - index_committed_bytes_ >= checkpoint_bytes || tail_records >= checkpoint_records) {
+        return publish_index(error);
+    }
+    return true;
+}
+
+bool store::load_match(const entry & value, const std::vector<llama_token> & visible, size_t visible_offset,
+                       size_t * bytes_budget, match * out, std::string * error) {
+    const size_t bytes_needed = static_cast<size_t>(value.prefix_count + value.continuation_count) * sizeof(int32_t);
+    if (bytes_needed > *bytes_budget) { if (error) *error = "PCSS lookup byte limit exceeded"; return false; }
+    std::ifstream file(active_records_path_, std::ios::binary);
+    if (!file) { if (error) *error = "cannot open PCSS records for lookup"; return false; }
+    file.seekg(static_cast<std::streamoff>(value.record_offset));
+    if (!file) { if (error) *error = "cannot seek PCSS record for lookup"; return false; }
+    if (value.serialized_bytes > max_field_bytes + record_header_bytes) { if (error) *error = "indexed PCSS record is oversized"; return false; }
+    std::vector<uint8_t> row(static_cast<size_t>(value.serialized_bytes));
+    file.read(reinterpret_cast<char *>(row.data()), static_cast<std::streamsize>(row.size()));
+    const size_t got = static_cast<size_t>(file.gcount()); stats_.bytes_read += got;
+    if (got != row.size()) { if (error) *error = "cannot read indexed PCSS record"; return false; }
+    size_t pos = 0; uint32_t magic = 0, version = 0, payload_size = 0; uint64_t checksum = 0;
+    if (!read_scalar(row.data(), row.size(), &pos, &magic) || !read_scalar(row.data(), row.size(), &pos, &version) ||
+        !read_scalar(row.data(), row.size(), &pos, &payload_size) || !read_scalar(row.data(), row.size(), &pos, &checksum) ||
+        magic != record_magic || version != format_version || payload_size != row.size() - record_header_bytes ||
+        fnv1a(row.data() + record_header_bytes, payload_size) != checksum) {
+        if (error) *error = "indexed PCSS record checksum verification failed"; return false;
+    }
+    std::string name_space, fingerprint; uint32_t prefix_count = 0, continuation_count = 0;
+    if (!read_string(row.data(), row.size(), &pos, &name_space) || !read_string(row.data(), row.size(), &pos, &fingerprint) ||
+        !read_scalar(row.data(), row.size(), &pos, &prefix_count) || !read_scalar(row.data(), row.size(), &pos, &continuation_count) ||
+        name_space != id_.name_space || fingerprint != id_.fingerprint || prefix_count != value.prefix_count ||
+        continuation_count != value.continuation_count) { if (error) *error = "indexed PCSS record identity mismatch"; return false; }
+    match loaded; loaded.prefix.assign(visible.begin() + visible_offset, visible.end()); loaded.continuation.resize(value.continuation_count);
+    for (uint32_t i = 0; i < value.prefix_count; ++i) {
+        int32_t disk = 0;
+        if (!read_scalar(row.data(), row.size(), &pos, &disk)) { if (error) *error = "cannot decode indexed PCSS prefix"; return false; }
+        if (static_cast<llama_token>(disk) != visible[visible_offset + i]) return false;
+    }
+    for (llama_token & token : loaded.continuation) {
+        int32_t disk = 0;
+        if (!read_scalar(row.data(), row.size(), &pos, &disk)) { if (error) *error = "cannot decode indexed PCSS continuation"; return false; }
+        token = static_cast<llama_token>(disk);
+    }
+    if (pos != row.size()) { if (error) *error = "indexed PCSS record has trailing payload"; return false; }
+    *bytes_budget -= bytes_needed;
+    *out = std::move(loaded); return true;
+}
+
+bool store::lookup(const std::vector<llama_token> & visible, match * out, std::string * error, size_t min_prefix_tokens) {
+    if (!out) { if (error) *error = "PCSS lookup requires an output match"; return false; }
+    if (!open_ && !open(error)) return false;
+    size_t probes = 0, bytes_budget = limits_.max_lookup_bytes;
+    for (auto length_it = prefix_lengths_.rbegin(); length_it != prefix_lengths_.rend(); ++length_it) {
+        const size_t length = *length_it;
+        if (length < min_prefix_tokens) continue;
+        if (length > visible.size()) continue;
+        if (++probes > limits_.max_lookup_probes) { if (error) *error = "PCSS lookup probe limit exceeded"; return false; }
+        ++stats_.lookup_probes;
+        uint64_t hash = hash_offset;
+        for (size_t i = visible.size() - length; i < visible.size(); ++i) hash = hash * hash_prime + mix_token(visible[i]);
+        index_item key{ hash, static_cast<uint32_t>(length), 0 };
+        auto first = std::lower_bound(index_.begin(), index_.end(), key, [](const index_item & a, const index_item & b) {
+            if (a.prefix_count != b.prefix_count) return a.prefix_count < b.prefix_count;
+            if (a.prefix_hash != b.prefix_hash) return a.prefix_hash < b.prefix_hash;
+            return a.entry_index < b.entry_index;
+        });
+        for (auto it = first; it != index_.end() && it->prefix_count == length && it->prefix_hash == hash; ++it) {
+            if (++probes > limits_.max_lookup_probes) { if (error) *error = "PCSS lookup probe limit exceeded"; return false; }
+            ++stats_.lookup_probes;
+            entry & candidate = entries_[it->entry_index]; match loaded; std::string local_error;
+            if (load_match(candidate, visible, visible.size() - length, &bytes_budget, &loaded, &local_error)) {
+                candidate.last_used = ++clock_; *out = std::move(loaded); ++stats_.hits; return true;
+            }
+            if (!local_error.empty()) { if (error) *error = local_error; return false; }
+        }
+    }
+    ++stats_.misses; return false;
+}
+
+bool store::enforce_limits(std::string * error) {
+    bool evicted = false; update_ram_bytes();
+    while (!entries_.empty() && (entries_.size() > limits_.max_entries || stats_.bytes > limits_.max_bytes || stats_.ram_bytes > limits_.max_ram_bytes)) {
+        const auto victim = std::min_element(entries_.begin(), entries_.end(), [](const entry & a, const entry & b) { return a.last_used < b.last_used; });
+        stats_.bytes -= victim->serialized_bytes; entries_.erase(victim);
+        std::vector<entry>(entries_).swap(entries_);
+        ++stats_.evictions; evicted = true; rebuild_index();
+    }
+    stats_.entries = entries_.size(); dirty_compaction_ = dirty_compaction_ || evicted;
+    if (limits_.read_only) return true;
+    return !dirty_compaction_ || compact(error);
+}
+
+bool store::compact(std::string * error) {
+    if (!dirty_compaction_) return true;
+    if (limits_.read_only) { if (error) *error = "PCSS store needs compaction but is read-only"; return false; }
+    const std::string records = path_join(directory_, "records.pcss"), manifest = path_join(directory_, "manifest.pcss");
+    const std::string index = path_join(directory_, "index.pcss");
+    const std::string records_tmp = records + ".compact", manifest_tmp = manifest + ".compact", index_tmp = index + ".compact";
+    const std::string records_prev = records + ".prev", manifest_prev = manifest + ".prev", index_prev = index + ".prev";
+    std::error_code ec;
+    std::filesystem::remove(records_tmp, ec); std::filesystem::remove(manifest_tmp, ec); std::filesystem::remove(index_tmp, ec);
+    uint64_t current_directory_bytes = 0;
+    if (!directory_regular_bytes(directory_, &current_directory_bytes, error)) return false;
+    auto projected_index_bytes = [&]() -> uint64_t {
+        return 44u + id_.name_space.size() + id_.fingerprint.size() + entries_.size() * 48u;
+    };
+    auto projected_peak = [&]() -> uint64_t {
+        return current_directory_bytes + stats_.bytes + manifest_row_bytes + projected_index_bytes();
+    };
+    while (!entries_.empty() && projected_peak() > limits_.max_bytes) {
+        const auto victim = std::min_element(entries_.begin(), entries_.end(), [](const entry & a, const entry & b) {
+            return a.last_used < b.last_used;
+        });
+        stats_.bytes -= victim->serialized_bytes;
+        entries_.erase(victim);
+        ++stats_.evictions;
+    }
+    stats_.entries = entries_.size();
+    rebuild_index();
+    if (projected_peak() > limits_.max_bytes) {
+        if (error) *error = "PCSS compaction peak would exceed physical store byte capacity";
+        return false;
+    }
+    std::ifstream input(active_records_path_, std::ios::binary); std::ofstream output(records_tmp, std::ios::binary | std::ios::trunc);
+    if (!input || !output) { if (error) *error = "cannot create compacted PCSS records"; return false; }
+    std::array<uint8_t, 64 * 1024> buffer{}; uint64_t bytes = 0;
+    for (entry & item : entries_) {
+        input.clear(); input.seekg(static_cast<std::streamoff>(item.record_offset));
+        if (!input) { if (error) *error = "cannot seek PCSS record during compaction"; return false; }
+        uint64_t remaining = item.serialized_bytes; const uint64_t prefix_delta = item.prefix_offset - item.record_offset;
+        item.record_offset = bytes; item.prefix_offset = bytes + prefix_delta;
+        while (remaining > 0) {
+            const size_t chunk = static_cast<size_t>(std::min<uint64_t>(remaining, buffer.size()));
+            input.read(reinterpret_cast<char *>(buffer.data()), chunk); const size_t got = static_cast<size_t>(input.gcount()); stats_.bytes_read += got;
+            if (got != chunk || !write_all(output, buffer.data(), got)) { if (error) *error = "cannot copy compacted PCSS record"; return false; }
+            stats_.bytes_written += got; remaining -= got; bytes += got;
+        }
+    }
+    output.flush();
+    if (!output) { if (error) *error = "cannot flush compacted PCSS records"; return false; }
+    output.close();
+    if (!secure_path(records_tmp, false, true, error)) return false;
+    if (!sync_file(records_tmp, error)) return false;
+    std::vector<uint8_t> row;
+    append_scalar<uint32_t>(row, manifest_magic); append_scalar<uint32_t>(row, format_version);
+    append_scalar<uint64_t>(row, bytes); append_scalar<uint64_t>(row, static_cast<uint64_t>(entries_.size()));
+    append_scalar<uint64_t>(row, fnv1a(row.data(), row.size()));
+    if (!durable_write_file(manifest_tmp, row, error)) return false;
+    stats_.bytes_written += row.size();
+    std::vector<uint8_t> compact_index = serialize_index(bytes, row.size());
+    if (!durable_write_file(index_tmp, compact_index, error)) return false;
+    stats_.bytes_written += compact_index.size();
+    // Make the complete new triple durable before publication.
+    if (!sync_directory(directory_, error)) return false;
+    std::filesystem::remove(records_prev, ec); std::filesystem::remove(manifest_prev, ec); std::filesystem::remove(index_prev, ec);
+    if (!sync_directory(directory_, error)) return false;
+    if (std::filesystem::exists(records, ec)) {
+        std::filesystem::rename(records, records_prev, ec);
+        if (ec) { if (error) *error = "cannot preserve PCSS records before compaction"; return false; }
+        if (!sync_directory(directory_, error)) return false;
+    }
+    if (std::filesystem::exists(manifest, ec)) {
+        std::filesystem::rename(manifest, manifest_prev, ec);
+        if (ec) { if (error) *error = "cannot preserve PCSS manifest before compaction"; return false; }
+        if (!sync_directory(directory_, error)) return false;
+    }
+    if (std::filesystem::exists(index, ec)) {
+        std::filesystem::rename(index, index_prev, ec);
+        if (ec) { if (error) *error = "cannot preserve PCSS index before compaction"; return false; }
+        if (!sync_directory(directory_, error)) return false;
+    }
+    std::filesystem::rename(records_tmp, records, ec);
+    if (ec) { if (error) *error = "cannot install compacted PCSS records"; return false; }
+    if (!sync_directory(directory_, error)) return false;
+    std::filesystem::rename(index_tmp, index, ec);
+    if (ec) { if (error) *error = "cannot install compacted PCSS index"; return false; }
+    if (!sync_directory(directory_, error)) return false;
+    // Manifest is the publication point for the complete new triple.
+    std::filesystem::rename(manifest_tmp, manifest, ec);
+    if (ec) { if (error) *error = "cannot install compacted PCSS manifest"; return false; }
+    if (!sync_directory(directory_, error)) return false;
+    std::filesystem::remove(records_prev, ec); std::filesystem::remove(manifest_prev, ec); std::filesystem::remove(index_prev, ec);
+    if (!sync_directory(directory_, error)) return false;
+    committed_bytes_ = bytes;
+    manifest_bytes_ = manifest_row_bytes;
+    index_bytes_ = compact_index.size();
+    index_committed_bytes_ = committed_bytes_;
+    index_manifest_bytes_ = manifest_bytes_;
+    index_entry_count_ = entries_.size();
+    physical_bytes_ = committed_bytes_ + manifest_bytes_ + index_bytes_;
+    stats_.physical_bytes = physical_bytes_;
+    active_records_path_ = records; active_index_path_ = index; dirty_compaction_ = false; ++stats_.compactions;
+    return true;
+}
+
