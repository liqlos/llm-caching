+void test_streaming_restart_keeps_bounded_newest_index() {
+    temporary_directory directory("streaming-bounded-restart");
+    const auto root = directory.path.string();
+    constexpr int record_count = 512;
+    {
+        pcss::limits roomy;
+        roomy.max_entries = record_count;
+        pcss::store writer(root, test_identity(), roomy);
+        std::string error;
+        for (int i = 0; i < record_count; ++i) {
+            assert(writer.put({ 10000 + i }, { 20000 + i }, &error));
+        }
+        assert(writer.get_stats().entries == record_count);
+    }
+
+    pcss::limits tiny;
+    tiny.max_entries = record_count;
+    tiny.max_ram_bytes = 512;
+    std::string error;
+    size_t loaded_entries = 0;
+    {
+        pcss::store restarted(root, test_identity(), tiny);
+        assert(restarted.open(&error));
+        const auto loaded = restarted.get_stats();
+        loaded_entries = loaded.entries;
