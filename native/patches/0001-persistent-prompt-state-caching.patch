+static std::filesystem::path temporary_directory(const char * name) {
+    const auto value = std::chrono::steady_clock::now().time_since_epoch().count();
+    const auto path = std::filesystem::temp_directory_path() / (std::string(name) + "-" + std::to_string(value));
+    std::filesystem::create_directories(path);
+    return path;
+}
