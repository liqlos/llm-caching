+void test_current_source_bounds_and_collision_cap_fail_closed() {
+    temporary_directory directory("current-source-bounds");
+    auto params = current_source_params(directory);
+    common_speculative_ptr spec(common_speculative_init(params, 1));
+    assert(spec);
+    const auto anchor = current_source_anchor();
+    const tokens before_last(anchor.begin(), anchor.end() - 1);
+
+    // The configured maximum is accepted, while one token more is rejected
+    // before it can allocate an index.
+    tokens maximum_source;
+    maximum_source.reserve(16384);
+    for (llama_token token = 30000; token < 30000 + 16384; ++token) maximum_source.push_back(token);
+    common_speculative_begin(spec.get(), 0, before_last);
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, maximum_source));
+    common_speculative_pcss_stats stats;
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_index_bytes > 0);
+    assert(stats.current_source_index_bytes < 8ull * 1024ull * 1024ull);
+    common_speculative_end(spec.get(), 0, false);
+
+    tokens oversized_source = maximum_source;
+    oversized_source.push_back(99999);
+    common_speculative_begin(spec.get(), 0, before_last);
+    assert(!common_speculative_set_pcss_current_source(spec.get(), 0, oversized_source));
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_index_bytes == 0);
+    common_speculative_end(spec.get(), 0, false);
+
+    // More than 64 matching source anchors cannot prove agreement from a
+    // bounded collision list, even though the retained values are identical.
+    tokens collision_source(100, 42);
+    const tokens collision_before_last(31, 42);
+    tokens draft;
+    common_speculative_begin(spec.get(), 0, collision_before_last);
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, collision_source));
+    configure_current_source_draft(spec.get(), collision_before_last, 42, &draft);
+    common_speculative_draft(spec.get());
+    assert(draft.empty());
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_lookups == 1);
+    assert(stats.current_source_ambiguities == 1);
+    assert(stats.current_source_abstentions == 1);
+    assert(stats.current_source_index_bytes > 0);
+    assert(stats.current_source_index_bytes < 4096);
+}
