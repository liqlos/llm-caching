+void test_bounded_disk_index_lookup_and_restart_accounting() {
+    temporary_directory directory("bounded-index");
+    const auto root = directory.path.string();
+    constexpr int entry_count = 64;
+    tokens continuation(128, 700);
+
+    {
+        pcss::store writer(root, test_identity());
+        std::string error;
+        for (int i = 0; i < entry_count; ++i) {
+            continuation.back() = 700 + i;
+            assert(writer.put({ 1000 + i, 2000 + i, 3000 + i }, continuation, &error));
+        }
+        const auto before_miss = writer.get_stats();
+        pcss::match result;
+        assert(!writer.lookup({ 77, 88, 99 }, &result, &error));
+        const auto after_miss = writer.get_stats();
+        // One distinct indexed prefix length is probed, regardless of entry count;
+        // a hash miss performs no record I/O.
+        assert(after_miss.lookup_probes - before_miss.lookup_probes == 1);
+        assert(after_miss.bytes_read == before_miss.bytes_read);
+        assert(after_miss.ram_bytes <= 4u * 1024u * 1024u);
+        assert(after_miss.ram_bytes < after_miss.bytes);
+    }
+
+    {
+        pcss::store restarted(root, test_identity());
+        std::string error;
+        assert(restarted.open(&error));
+        const auto opened = restarted.get_stats();
+        assert(opened.entries == entry_count);
+        assert(opened.ram_bytes < opened.bytes);
+        pcss::match result;
+        const auto before_hit = restarted.get_stats();
+        assert(restarted.lookup({ 1, 2, 1063, 2063, 3063 }, &result, &error));
+        const auto after_hit = restarted.get_stats();
+        assert(result.prefix == tokens({ 1063, 2063, 3063 }));
+        assert(result.continuation.size() == continuation.size());
+        assert(result.continuation.back() == 763);
+        assert(after_hit.lookup_probes - before_hit.lookup_probes == 2);
+        assert(after_hit.bytes_read - before_hit.bytes_read == opened.bytes / opened.entries);
+    }
+}
