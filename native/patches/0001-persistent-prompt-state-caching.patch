+void test_sparse_large_corpus_uses_bound_sidecar_and_stale_index_fails_safe() {
+    temporary_directory directory("sparse-sidecar");
+    const auto root = directory.path.string();
+    {
+        pcss::store writer(root, test_identity());
+        std::string error;
+        assert(writer.put({ 41, 42 }, { 141, 142 }, &error));
+    }
+    const auto records_path = directory.path / "records.pcss";
+    const auto manifest_path = directory.path / "manifest.pcss";
+    const auto index_path = directory.path / "index.pcss";
+    const uintmax_t sparse_size = 1024ull * 1024ull * 1024ull;
+    std::filesystem::resize_file(records_path, sparse_size);
+    {
+        pcss::limits direct;
+        direct.read_only = true;
+        direct.max_bytes = 2ull * 1024ull * 1024ull * 1024ull;
+        direct.max_startup_bytes = 1024;
+        pcss::store reader(root, test_identity(), direct);
+        std::string error;
+        assert(reader.open(&error));
+        const auto opened = reader.get_stats();
+        assert(opened.bytes_read < 4096);
+        assert(opened.physical_bytes >= sparse_size);
+        pcss::match result;
+        const auto before = reader.get_stats().bytes_read;
+        assert(reader.lookup({ 1, 41, 42 }, &result, &error));
+        assert(result.continuation == tokens({ 141, 142 }));
+        assert(reader.get_stats().bytes_read > before);
+        assert(reader.get_stats().bytes_read - before < 1024);
+    }
+    {
+        pcss::limits quota;
+        quota.read_only = true;
+        quota.max_bytes = sparse_size;
+        pcss::store rejected(root, test_identity(), quota);
+        std::string error;
+        assert(!rejected.open(&error));
+        assert(error.find("physical PCSS generation") != std::string::npos);
+    }
+
+    // Use a compact, fully committed corpus for stale/corrupt rebuild checks.
+    const auto manifest = read_bytes(manifest_path);
+    assert(manifest.size() >= 24);
+    uint64_t committed = 0;
+    for (size_t i = 0; i < 8; ++i) committed |= static_cast<uint64_t>(manifest[8 + i]) << (8 * i);
+    std::filesystem::resize_file(records_path, committed);
+    const auto stale_index = read_bytes(index_path);
+    {
+        pcss::store writer(root, test_identity());
+        std::string error;
+        assert(writer.put({ 43 }, { 143 }, &error));
+    }
+    write_bytes(index_path, stale_index);
+    {
+        pcss::limits bounded;
+        bounded.read_only = true;
+        bounded.max_startup_bytes = 1;
+        pcss::store stale(root, test_identity(), bounded);
+        std::string error;
+        assert(!stale.open(&error));
+        assert(error.find("hot index") != std::string::npos);
+    }
+    {
+        pcss::store rebuilder(root, test_identity());
+        std::string error;
+        assert(rebuilder.open(&error));
+    }
+    corrupt_byte(index_path, 8);
+    {
+        pcss::limits bounded;
+        bounded.read_only = true;
+        bounded.max_startup_bytes = 1;
+        pcss::store corrupt(root, test_identity(), bounded);
+        std::string error;
+        assert(!corrupt.open(&error));
+        assert(error.find("hot index") != std::string::npos);
+    }
+}
