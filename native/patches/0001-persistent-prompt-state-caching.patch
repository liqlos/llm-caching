+void test_current_source_aggregate_admission_budget_clears_all_slots() {
+    temporary_directory directory("current-source-aggregate-budget");
+    auto params = current_source_params(directory);
+    // The aggregate source reservation is one eighth of this shared PCSS RAM
+    // limit. These small, concurrent source attachments must therefore admit
+    // some slots and then fail closed before all eight can attach.
+    params.pcss_cache.ram_mib = 1;
+    constexpr size_t slot_count = 8;
+    common_speculative_ptr spec(common_speculative_init(params, slot_count));
+    assert(spec);
+
+    tokens source;
+    for (llama_token token = 28000; token < 28048; ++token) source.push_back(token);
+    const tokens before_last(source.begin(), source.begin() + 31);
+    size_t attached_slots = 0;
+    size_t rejected_slot = slot_count;
+    for (llama_seq_id seq_id = 0; seq_id < static_cast<llama_seq_id>(slot_count); ++seq_id) {
+        common_speculative_begin(spec.get(), seq_id, before_last);
+        if (common_speculative_set_pcss_current_source(spec.get(), seq_id, source)) {
+            ++attached_slots;
+            continue;
+        }
+        rejected_slot = static_cast<size_t>(seq_id);
+        break;
+    }
+    assert(attached_slots >= 2);
+    assert(rejected_slot < slot_count);
+
+    common_speculative_pcss_stats stats;
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_abstentions == 1);
+    assert(stats.current_source_index_bytes > 0);
+    assert(stats.current_source_peak_index_bytes >= stats.current_source_index_bytes);
+    const uint64_t peak_index_bytes = stats.current_source_peak_index_bytes;
+
+    // Exhaustion clears the rejected slot rather than failing the provider;
+    // with the current-context tier disabled, it has no draft to leak.
+    tokens draft;
+    configure_current_source_draft(
+        spec.get(),
+        static_cast<llama_seq_id>(rejected_slot),
+        before_last,
+        source[31],
+        &draft);
+    common_speculative_draft(spec.get());
+    assert(draft.empty());
+
+    for (llama_seq_id seq_id = 0; seq_id <= static_cast<llama_seq_id>(rejected_slot); ++seq_id) {
+        common_speculative_end(spec.get(), seq_id, false);
+    }
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_index_bytes == 0);
+    // The live maps are gone, but the metric remains useful for a postmortem.
+    assert(stats.current_source_peak_index_bytes == peak_index_bytes);
+}
