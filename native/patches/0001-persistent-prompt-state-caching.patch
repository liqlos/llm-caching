+    void accept(llama_seq_id seq_id, uint16_t n_accepted, bool is_other) override {
+        if (!is_other && !sinfos[seq_id].proposed.empty()) {
+            auto & info = sinfos[seq_id];
+            metrics.accepted_tokens += std::min<size_t>(n_accepted, info.proposed.size());
+            if (info.source == seq_info::SOURCE_CURRENT_SOURCE) {
+                if (n_accepted == 0) {
+                    ++metrics.current_source_rejections;
+                }
+                metrics.current_source_accepted_tokens += std::min<size_t>(n_accepted, info.proposed.size());
+            } else if (info.source == seq_info::SOURCE_CURRENT_CONTEXT) {
+                if (n_accepted == 0) {
+                    ++info.current_context_rejections;
+                    if (info.current_context_rejections >= 3) {
+                        info.current_context_suppressed = true;
+                    }
+                } else {
+                    info.current_context_rejections = 0;
+                }
+            } else if (info.source == seq_info::SOURCE_PERSISTENT_SHORT) {
+                if (n_accepted == 0) {
+                    ++metrics.persistent_32_rejections;
+                    if (++info.short_persistent_rejections >= 3 && !info.short_persistent_suppressed) {
+                        info.short_persistent_suppressed = true;
+                        ++metrics.persistent_32_suppressions;
+                    }
+                } else {
