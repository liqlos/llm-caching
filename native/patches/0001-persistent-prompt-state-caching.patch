index 000000000..98e8e8a3a
--- /dev/null
+++ b/common/pcss-store.cpp
@@ -0,0 +1,962 @@
+#include "pcss-store.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <type_traits>
+#include <utility>
+
+#if !defined(_WIN32)
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace pcss {
+namespace {
+
+constexpr uint32_t record_magic = 0x31525350u;
+constexpr uint32_t manifest_magic = 0x314d5350u;
+constexpr uint32_t index_magic = 0x31495350u;
+constexpr uint32_t format_version = 1;
+constexpr uint32_t max_field_bytes = 16u * 1024u * 1024u;
+constexpr uint32_t max_token_count = 4u * 1024u * 1024u;
+constexpr size_t record_header_bytes = 20;
+constexpr size_t manifest_row_bytes = 32;
+constexpr uint64_t hash_offset = 1469598103934665603ull;
+constexpr uint64_t hash_prime = 1099511628211ull;
+
+uint64_t fnv1a_update(uint64_t hash, const uint8_t * data, size_t n) {
+    for (size_t i = 0; i < n; ++i) { hash ^= data[i]; hash *= hash_prime; }
+    return hash;
+}
+uint64_t fnv1a(const uint8_t * data, size_t n) { return fnv1a_update(hash_offset, data, n); }
+
+uint64_t mix_token(llama_token token) {
+    uint64_t value = static_cast<uint32_t>(token);
+    value ^= value >> 16; value *= 0x9e3779b185ebca87ull; value ^= value >> 29;
+    return value;
+}
+uint64_t token_sequence_hash(const std::vector<llama_token> & tokens) {
+    uint64_t hash = hash_offset;
+    for (llama_token token : tokens) hash = hash * hash_prime + mix_token(token);
+    return hash;
+}
+
+template<typename T> void append_scalar(std::vector<uint8_t> & out, T value) {
+    static_assert(std::is_integral<T>::value, "only integral fields are serialized");
+    using U = typename std::make_unsigned<T>::type;
+    U v = static_cast<U>(value);
+    for (size_t i = 0; i < sizeof(T); ++i) { out.push_back(static_cast<uint8_t>(v & 0xffu)); v >>= 8; }
+}
+template<typename T> bool read_scalar(const uint8_t * data, size_t size, size_t * pos, T * value) {
+    static_assert(std::is_integral<T>::value, "only integral fields are serialized");
+    if (*pos > size || size - *pos < sizeof(T)) return false;
+    using U = typename std::make_unsigned<T>::type;
+    U v = 0;
+    for (size_t i = 0; i < sizeof(T); ++i) v |= static_cast<U>(data[*pos + i]) << (8 * i);
+    *pos += sizeof(T); *value = static_cast<T>(v); return true;
+}
+void append_string(std::vector<uint8_t> & out, const std::string & value) {
+    append_scalar<uint32_t>(out, static_cast<uint32_t>(value.size()));
+    out.insert(out.end(), value.begin(), value.end());
+}
+bool read_string(const uint8_t * data, size_t size, size_t * pos, std::string * value) {
+    uint32_t length = 0;
+    if (!read_scalar(data, size, pos, &length) || length > max_field_bytes || *pos > size || size - *pos < length) return false;
+    value->assign(reinterpret_cast<const char *>(data + *pos), length); *pos += length; return true;
+}
+std::string path_join(const std::string & dir, const char * name) { return (std::filesystem::path(dir) / name).string(); }
+bool write_all(std::ofstream & file, const void * data, size_t n) {
+    file.write(static_cast<const char *>(data), static_cast<std::streamsize>(n)); return static_cast<bool>(file);
+}
+bool durable_append_file(const std::string & path, const std::vector<uint8_t> & bytes, std::string * error) {
+#if defined(_WIN32)
+    std::ofstream file(path, std::ios::binary | std::ios::app);
+    if (!file) { if (error) *error = "cannot open " + path + " for append"; return false; }
+    if (!write_all(file, bytes.data(), bytes.size())) { if (error) *error = "cannot append " + path; return false; }
+    file.flush();
+    if (!file) { if (error) *error = "cannot flush " + path; return false; }
+    return true;
+#else
+    const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0644);
+    if (fd < 0) { if (error) *error = "cannot open " + path + " for durable append: " + std::strerror(errno); return false; }
+    if (::fchmod(fd, 0600) != 0) { if (error) *error = "cannot secure " + path + ": " + std::strerror(errno); ::close(fd); return false; }
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+        const ssize_t written = ::write(fd, bytes.data() + offset, bytes.size() - offset);
+        if (written < 0 && errno == EINTR) continue;
+        if (written <= 0) {
+            if (error) *error = "cannot append " + path + ": " + std::strerror(errno);
+            ::close(fd); return false;
+        }
+        offset += static_cast<size_t>(written);
+    }
+    if (::fsync(fd) != 0) {
+        if (error) *error = "cannot sync " + path + ": " + std::strerror(errno);
+        ::close(fd); return false;
+    }
+    if (::close(fd) != 0) { if (error) *error = "cannot close " + path + ": " + std::strerror(errno); return false; }
+    return true;
+#endif
+}
+
+bool durable_write_file(const std::string & path, const std::vector<uint8_t> & bytes, std::string * error) {
+#if defined(_WIN32)
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    if (!file || !write_all(file, bytes.data(), bytes.size())) { if (error) *error = "cannot write " + path; return false; }
+    file.flush(); return static_cast<bool>(file);
+#else
+    const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) { if (error) *error = "cannot create " + path + ": " + std::strerror(errno); return false; }
+    if (::fchmod(fd, 0600) != 0) { if (error) *error = "cannot secure " + path + ": " + std::strerror(errno); ::close(fd); return false; }
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+        const ssize_t written = ::write(fd, bytes.data() + offset, bytes.size() - offset);
+        if (written < 0 && errno == EINTR) continue;
+        if (written <= 0) { if (error) *error = "cannot write " + path + ": " + std::strerror(errno); ::close(fd); return false; }
+        offset += static_cast<size_t>(written);
+    }
+    if (::fsync(fd) != 0) { if (error) *error = "cannot sync " + path + ": " + std::strerror(errno); ::close(fd); return false; }
+    if (::close(fd) != 0) { if (error) *error = "cannot close " + path + ": " + std::strerror(errno); return false; }
+    return true;
+#endif
+}
+
+bool sync_directory(const std::string & directory, std::string * error) {
+#if defined(_WIN32)
+    (void) directory; (void) error; return true;
+#else
+    const int fd = ::open(directory.c_str(), O_RDONLY);
+    if (fd < 0) { if (error) *error = "cannot open PCSS directory for sync: " + std::string(std::strerror(errno)); return false; }
+    if (::fsync(fd) != 0 && errno != EINVAL && errno != ENOTSUP) {
+        if (error) *error = "cannot sync PCSS directory: " + std::string(std::strerror(errno));
+        ::close(fd); return false;
+    }
+    if (::close(fd) != 0) { if (error) *error = "cannot close PCSS directory: " + std::string(std::strerror(errno)); return false; }
+    return true;
+#endif
+}
+
+bool sync_file(const std::string & path, std::string * error) {
+#if defined(_WIN32)
+    (void) path; (void) error; return true;
+#else
+    const int fd = ::open(path.c_str(), O_RDONLY);
+    if (fd < 0) { if (error) *error = "cannot open " + path + " for sync: " + std::strerror(errno); return false; }
+    if (::fsync(fd) != 0) { if (error) *error = "cannot sync " + path + ": " + std::strerror(errno); ::close(fd); return false; }
+    if (::close(fd) != 0) { if (error) *error = "cannot close " + path + ": " + std::strerror(errno); return false; }
+    return true;
+#endif
+}
+
+bool directory_regular_bytes(const std::string & directory, uint64_t * total, std::string * error) {
+    *total = 0;
+    std::error_code ec;
+    for (const auto & item : std::filesystem::directory_iterator(directory, ec)) {
+        if (ec) break;
+        if (!item.is_regular_file(ec)) continue;
+        const uint64_t bytes = item.file_size(ec);
+        if (ec || *total > std::numeric_limits<uint64_t>::max() - bytes) {
+            if (error) *error = "cannot account PCSS directory bytes";
+            return false;
+        }
+        *total += bytes;
+    }
+    if (ec) { if (error) *error = "cannot enumerate PCSS directory bytes"; return false; }
+    return true;
+}
+
+bool secure_path(const std::string & path, bool directory, bool repair, std::string * error) {
+#if defined(_WIN32)
+    (void) path; (void) directory; (void) repair; (void) error; return true;
+#else
+    struct stat before{};
+    if (::lstat(path.c_str(), &before) != 0) {
+        if (errno == ENOENT) return true;
+        if (error) *error = "cannot inspect PCSS permissions for " + path + ": " + std::strerror(errno);
+        return false;
+    }
+    if (before.st_uid != ::geteuid() || (directory ? !S_ISDIR(before.st_mode) : !S_ISREG(before.st_mode))) {
+        if (error) *error = "unsafe ownership or file type for " + path;
+        return false;
+    }
+    const mode_t mode = directory ? 0700 : 0600;
+    if ((before.st_mode & 0777) != mode && !repair) {
+        if (error) *error = "PCSS path is group/world accessible: " + path;
+        return false;
+    }
+    if (repair && ::chmod(path.c_str(), mode) != 0) {
+        if (error) *error = "cannot secure permissions for " + path + ": " + std::strerror(errno);
+        return false;
+    }
+    struct stat after{};
+    if (::lstat(path.c_str(), &after) != 0 || (after.st_mode & 0777) != mode) {
+        if (error) *error = "PCSS permissions remain group/world accessible for " + path;
+        return false;
+    }
+    return true;
+#endif
+}
+bool file_size(const std::string & path, uint64_t * size, std::string * error) {
+    std::error_code ec;
+    if (!std::filesystem::exists(path, ec)) { *size = 0; return !ec; }
+    *size = std::filesystem::file_size(path, ec);
+    if (ec) { if (error) *error = "cannot determine size of " + path; return false; }
+    return true;
+}
+
+class payload_reader {
+public:
+    payload_reader(std::ifstream & file, uint64_t remaining, uint64_t * bytes_read)
+        : file_(file), remaining_(remaining), bytes_read_(bytes_read) {}
+    bool read(void * out, size_t n) {
+        if (n > remaining_) return false;
+        file_.read(static_cast<char *>(out), static_cast<std::streamsize>(n));
+        const size_t got = static_cast<size_t>(file_.gcount()); *bytes_read_ += got;
+        if (got != n) return false;
+        hash_ = fnv1a_update(hash_, static_cast<const uint8_t *>(out), n); remaining_ -= n; return true;
+    }
+    template<typename T> bool scalar(T * value) {
+        std::array<uint8_t, sizeof(T)> bytes{}; size_t pos = 0;
+        return read(bytes.data(), bytes.size()) && read_scalar(bytes.data(), bytes.size(), &pos, value);
+    }
+    bool string_equals(const std::string & expected, uint32_t * length) {
+        if (!scalar(length) || *length > max_field_bytes) return false;
+        std::array<uint8_t, 4096> buffer{}; size_t offset = 0;
+        while (offset < *length) {
+            const size_t n = std::min(buffer.size(), static_cast<size_t>(*length) - offset);
+            if (!read(buffer.data(), n)) return false;
+            if (offset >= expected.size() || n > expected.size() - offset ||
+                !std::equal(buffer.begin(), buffer.begin() + n, expected.begin() + offset)) equal_ = false;
+            offset += n;
+        }
+        if (*length != expected.size()) equal_ = false;
+        return true;
+    }
+    bool skip(size_t n) {
+        std::array<uint8_t, 64 * 1024> buffer{};
+        while (n > 0) { const size_t chunk = std::min(n, buffer.size()); if (!read(buffer.data(), chunk)) return false; n -= chunk; }
+        return true;
+    }
+    uint64_t checksum() const { return hash_; }
+    uint64_t remaining() const { return remaining_; }
+    bool equal() const { return equal_; }
+private:
+    std::ifstream & file_; uint64_t remaining_; uint64_t * bytes_read_;
+    uint64_t hash_ = hash_offset; bool equal_ = true;
+};
+
