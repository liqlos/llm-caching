+void test_compaction_publication_boundaries_select_complete_generation() {
+    temporary_directory source("compaction-generations");
+    pcss::limits cap;
+    cap.max_entries = 2;
+    std::vector<uint8_t> old_records, old_manifest, old_index, new_records, new_manifest, new_index;
+    {
+        pcss::store writer(source.path.string(), test_identity(), cap);
+        std::string error;
+        assert(writer.put({ 1 }, { 101 }, &error));
+        assert(writer.put({ 2 }, { 102 }, &error));
+    }
+    {
+        // Writable restart checkpoints the bounded tail into an exact index.
+        pcss::store writer(source.path.string(), test_identity(), cap);
+        std::string error;
+        assert(writer.open(&error));
+        old_records = read_bytes(source.path / "records.pcss");
+        old_manifest = read_bytes(source.path / "manifest.pcss");
+        old_index = read_bytes(source.path / "index.pcss");
+        assert(writer.put({ 3 }, { 103 }, &error));
+        new_records = read_bytes(source.path / "records.pcss");
+        new_manifest = read_bytes(source.path / "manifest.pcss");
+        new_index = read_bytes(source.path / "index.pcss");
+    }
+
+    auto verify = [&](const char * label, int boundary, bool expect_new) {
+        temporary_directory state(label);
+        if (boundary == 0) {
+            write_bytes(state.path / "records.pcss", old_records);
+            write_bytes(state.path / "manifest.pcss", old_manifest);
+            write_bytes(state.path / "records.pcss.compact", new_records);
+            write_bytes(state.path / "manifest.pcss.compact", new_manifest);
+            write_bytes(state.path / "index.pcss", old_index);
+            write_bytes(state.path / "index.pcss.compact", new_index);
+        } else if (boundary == 1) {
+            write_bytes(state.path / "records.pcss.prev", old_records);
+            write_bytes(state.path / "manifest.pcss", old_manifest);
+            write_bytes(state.path / "index.pcss", old_index);
+            write_bytes(state.path / "records.pcss.compact", new_records);
+            write_bytes(state.path / "manifest.pcss.compact", new_manifest);
+            write_bytes(state.path / "index.pcss.compact", new_index);
+        } else if (boundary == 2) {
+            write_bytes(state.path / "records.pcss.prev", old_records);
+            write_bytes(state.path / "manifest.pcss.prev", old_manifest);
+            write_bytes(state.path / "index.pcss", old_index);
+            write_bytes(state.path / "records.pcss.compact", new_records);
+            write_bytes(state.path / "manifest.pcss.compact", new_manifest);
+            write_bytes(state.path / "index.pcss.compact", new_index);
+        } else if (boundary == 3) {
+            write_bytes(state.path / "records.pcss.prev", old_records);
+            write_bytes(state.path / "manifest.pcss.prev", old_manifest);
+            write_bytes(state.path / "index.pcss.prev", old_index);
+            write_bytes(state.path / "records.pcss", new_records);
+            write_bytes(state.path / "manifest.pcss.compact", new_manifest);
+            write_bytes(state.path / "index.pcss.compact", new_index);
+        } else if (boundary == 4) {
+            write_bytes(state.path / "records.pcss.prev", old_records);
+            write_bytes(state.path / "manifest.pcss.prev", old_manifest);
+            write_bytes(state.path / "index.pcss.prev", old_index);
+            write_bytes(state.path / "records.pcss", new_records);
+            write_bytes(state.path / "index.pcss", new_index);
+            write_bytes(state.path / "manifest.pcss.compact", new_manifest);
+        } else {
+            write_bytes(state.path / "records.pcss.prev", old_records);
+            write_bytes(state.path / "manifest.pcss.prev", old_manifest);
+            write_bytes(state.path / "index.pcss.prev", old_index);
+            write_bytes(state.path / "records.pcss", new_records);
+            write_bytes(state.path / "index.pcss", new_index);
+            write_bytes(state.path / "manifest.pcss", new_manifest);
+        }
+        const auto before = snapshot_files(state.path);
+        pcss::limits read_only;
+        read_only.read_only = true;
+        read_only.max_startup_bytes = 1;
+        pcss::store reader(state.path.string(), test_identity(), read_only);
+        std::string error;
+        assert(reader.open(&error));
+        pcss::match result;
+        assert(reader.lookup({ 2 }, &result, &error));
+        assert(reader.lookup({ 3 }, &result, &error) == expect_new);
+        assert(reader.lookup({ 1 }, &result, &error) == !expect_new);
+        assert(snapshot_files(state.path) == before);
+    };
+
+    verify("compact-boundary-0", 0, false);
+    verify("compact-boundary-1", 1, false);
+    verify("compact-boundary-2", 2, false);
+    verify("compact-boundary-3", 3, false);
+    verify("compact-boundary-4", 4, false);
+    verify("compact-boundary-5", 5, true);
+}
