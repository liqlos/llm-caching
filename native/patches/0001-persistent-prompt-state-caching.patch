+common_params_speculative current_source_params(const temporary_directory & directory) {
+    common_params_speculative params;
+    params.types = { COMMON_SPECULATIVE_TYPE_PCSS_CACHE };
+    params.pcss_cache.store = directory.path.string();
+    params.pcss_cache.fingerprint = test_identity().fingerprint;
+    params.pcss_cache.name_space = test_identity().name_space;
+    // Isolate the source tier in these tests: source misses must not get a
+    // draft from the existing request-context fallback.
+    params.pcss_cache.disable_current_context = true;
+    params.pcss_cache.enable_current_source = true;
+    return params;
+}
