+class server_prompt_cache_store {
+public:
+    server_prompt_cache_store(std::string directory, size_t limit_bytes, size_t metadata_limit_bytes = 64u * 1024u * 1024u);
+
+    bool open(std::string * error = nullptr);
+    bool put(
