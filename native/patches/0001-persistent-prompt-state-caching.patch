+void test_current_source_is_default_off_and_cleared_on_lifecycle() {
+    temporary_directory disabled_directory("current-source-default-off");
+    auto disabled_params = current_source_params(disabled_directory);
+    disabled_params.pcss_cache.enable_current_source = false;
+    common_speculative_ptr disabled(common_speculative_init(disabled_params, 1));
+    assert(disabled);
+    const auto anchor = current_source_anchor();
+    const tokens before_last(anchor.begin(), anchor.end() - 1);
+    tokens source = anchor;
+    source.insert(source.end(), { 26000, 26001 });
+    common_speculative_begin(disabled.get(), 0, before_last);
+    assert(!common_speculative_set_pcss_current_source(disabled.get(), 0, source));
+    common_speculative_note_pcss_current_source_mismatch_abstention(disabled.get(), 0);
+    common_speculative_pcss_stats stats;
+    assert(common_speculative_get_pcss_stats(disabled.get(), &stats));
+    assert(stats.current_source_index_bytes == 0);
+    assert(stats.current_source_mismatch_abstentions == 0);
+
+    temporary_directory directory("current-source-lifecycle");
+    auto params = current_source_params(directory);
+    common_speculative_ptr spec(common_speculative_init(params, 1));
+    assert(spec);
+    tokens draft;
+    common_speculative_begin(spec.get(), 0, before_last);
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, source));
+
+    // begin() itself is a reuse boundary, even if an upstream caller fails to
+    // deliver an end() after a disconnect.
+    common_speculative_begin(spec.get(), 0, before_last);
+    configure_current_source_draft(spec.get(), before_last, anchor.back(), &draft);
+    common_speculative_draft(spec.get());
+    assert(draft.empty());
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_index_bytes == 0);
+
+    draft.clear();
+    common_speculative_begin(spec.get(), 0, before_last);
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, source));
+    configure_current_source_draft(spec.get(), before_last, anchor.back(), &draft);
+    common_speculative_draft(spec.get());
+    assert(draft == tokens({ 26000, 26001 }));
+    common_speculative_end(spec.get(), 0, false);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_index_bytes == 0);
+
+    // A successful end has the same source-lifetime boundary. No observed
+    // target token is required to exercise this cleanup path.
+    common_speculative_begin(spec.get(), 0, before_last);
+    assert(common_speculative_set_pcss_current_source(spec.get(), 0, source));
+    common_speculative_end(spec.get(), 0, true);
+    assert(common_speculative_get_pcss_stats(spec.get(), &stats));
+    assert(stats.current_source_index_bytes == 0);
+
+    // Neither an abort nor a source attachment adds material to the durable
+    // PCSS store. A reused slot therefore has no source draft without a new
+    // explicit setter call.
+    draft.clear();
+    common_speculative_begin(spec.get(), 0, before_last);
+    configure_current_source_draft(spec.get(), before_last, anchor.back(), &draft);
+    common_speculative_draft(spec.get());
+    assert(draft.empty());
+    pcss::limits read_only;
+    read_only.read_only = true;
+    pcss::store reader(directory.path.string(), test_identity(), read_only);
+    std::string error;
+    assert(reader.open(&error));
+    assert(reader.get_stats().entries == 0);
+}
