@@ -1829,6 +1842,49 @@ private:
         return ret;
     }
 
+    // save a slot's prompt to the prompt cache right after it finishes a completion, debounced
+    // per slot by params_base.cache_save_ms. covers sequential single-slot traffic, where the
+    // idle-sibling-slot save above never fires because there is no other slot to make room for.
+    void save_slot_on_completion(server_slot & slot) {
+        if (!prompt_cache || !params_base.cache_save_on_completion) {
+            return;
+        }
+
+        const int64_t t_now = ggml_time_ms();
+
+        if (slot.t_last_prompt_cache_save != 0 &&
+                t_now - slot.t_last_prompt_cache_save < params_base.cache_save_ms) {
+            return;
+        }
+
+        if (slot.prompt_save(*prompt_cache)) {
+            SLT_DBG(slot, "%s", "__TEST_TAG_CACHE_SAVE_ON_COMPLETION__\n");
+            prompt_cache->update();
+            slot.t_last_prompt_cache_save = t_now;
+        }
+    }
+
+    // flush all slots' prompts to the prompt cache on graceful shutdown, bypassing the debounce
+    // above so the last turn of a session is never lost to an interval that has not elapsed yet
+    void save_slots_on_shutdown() {
+        if (!prompt_cache) {
+            return;
+        }
+
+        bool saved_any = false;
+
+        for (auto & slot : slots) {
+            if (slot.prompt_save(*prompt_cache)) {
+                SLT_DBG(slot, "%s", "__TEST_TAG_CACHE_SAVE_ON_SHUTDOWN__\n");
+                saved_any = true;
+            }
+        }
+
+        if (saved_any) {
+            prompt_cache->update();
+        }
+    }
+
     // return true if at least one slot has been cleared
     // TODO: improve logic
     //       - smarter decision which slot to clear (LRU or longest prompt?)
@@ -4049,6 +4105,7 @@ private:
                 slot.print_timings();
                 send_final_response(slot);
                 common_speculative_end(spec.get(), slot.id, true);
+                save_slot_on_completion(slot);
                 slot.release();
 
                 return;
@@ -4334,6 +4391,10 @@ void server_context::terminate() {
     impl->queue_tasks.terminate();
 }
 
+void server_context::save_slots_on_shutdown() {
+    impl->save_slots_on_shutdown();
+}
+
 llama_context * server_context::get_llama_context() const {
     return impl->ctx_tgt;
 }
