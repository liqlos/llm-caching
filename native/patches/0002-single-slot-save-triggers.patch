@@ -44,6 +44,10 @@ LONG_PROMPT = (
 # idle slot cleared on launch should restore from cache-ram
 def test_clear_and_restore():
     global server
+    # isolate the idle-sibling-slot trigger under test: save-on-completion would
+    # otherwise save slot 0 as soon as its own completion finishes, making the
+    # idle-slot save below a no-op (nothing left to save)
+    server.no_cache_save_on_completion = True
     server.start()
     log = LogReader(server.log_path)
 
@@ -113,3 +117,46 @@ def test_disabled_with_flag():
     })
     assert res.status_code == 200
     assert "__TEST_TAG_CACHE_IDLE_SLOT__" not in log.drain()
+
+
+# a single slot never goes idle while another slot is busy, so the idle-sibling-slot
+# trigger above structurally cannot fire for it. save-on-completion closes that gap.
+def test_single_slot_save_on_completion():
+    global server
+    server.n_slots = 1
+    server.cache_save_ms = 0
+    server.start()
+    log = LogReader(server.log_path)
+
+    res = server.make_request("POST", "/completion", data={
+        "prompt": LONG_PROMPT,
+        "cache_prompt": True,
+    })
+    assert res.status_code == 200
+
+    drained = log.drain()
+    assert "__TEST_TAG_CACHE_IDLE_SLOT__" not in drained
+    assert "__TEST_TAG_CACHE_SAVE_ON_COMPLETION__" in drained
+
+
+def test_single_slot_save_on_completion_debounced():
+    global server
+    server.n_slots = 1
+    server.cache_save_ms = 60_000
+    server.start()
+    log = LogReader(server.log_path)
+
+    res = server.make_request("POST", "/completion", data={
+        "prompt": LONG_PROMPT,
+        "cache_prompt": True,
+    })
+    assert res.status_code == 200
+    assert "__TEST_TAG_CACHE_SAVE_ON_COMPLETION__" in log.drain()
+
+    # a second completion right after should be debounced: no new save yet
+    res = server.make_request("POST", "/completion", data={
+        "prompt": LONG_PROMPT + " The knight finally reached the castle gates.",
+        "cache_prompt": True,
+    })
+    assert res.status_code == 200
+    assert "__TEST_TAG_CACHE_SAVE_ON_COMPLETION__" not in log.drain()
