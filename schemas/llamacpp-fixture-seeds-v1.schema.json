{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcss.llamacpp-fixture-seeds/v1",
  "title": "PCSS llama.cpp target verifier fixture seeds v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "k_values", "provider_floor_k", "forced_rejection_k", "long_mixed", "seeds"],
  "properties": {
    "schema_version": {"const": "pcss.llamacpp-fixture-seeds/v1"},
    "k_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "provider_floor_k": {"type": "integer", "minimum": 1},
    "forced_rejection_k": {"type": "integer", "minimum": 1},
    "long_mixed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_steps", "k", "rejection_position"],
      "properties": {
        "context_steps": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 2},
        "rejection_position": {"type": "integer", "minimum": 1}
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seed_id", "initial_context_tokens"],
        "properties": {
          "seed_id": {"type": "string", "minLength": 1},
          "initial_context_tokens": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
